# Ignore bundler config.
/.bundle

# Ignore the default SQLite database.
/db/*.sqlite3
/db/*.sqlite3-journal

# Ignore all logfiles and tempfiles.
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep

# Ignore uploaded files in development
/storage/*
!/storage/.keep

# Ignore master key for decrypting credentials and more.
/config/master.key

# Ignore application configuration
/config/application.yml
!/config/application.yml.example

# Ignore database configuration
/config/database.yml
!/config/database.yml.example

# Ignore secrets
/config/secrets.yml
!/config/secrets.yml.example

# Ignore environment variables
.env
.env.*
!.env.example
!.env.*.example

# Ignore IDE files
.idea/*
.vscode/
.ruby-lsp/
.kiro/
*.rbc
.byebug_history

# Ignore system files
*~
.DS_Store
Thumbs.db

# Ignore bundler
/vendor/bundle

# Ignore RVM/rbenv files (these should be committed for consistency)
# .ruby-version
# .ruby-gemset

# Ignore capybara screenshots
capybara-*.html

# Ignore RSpec configuration
.rspec

# Ignore public uploads
/public/system
/public/uploads

# Ignore pow environment settings
.powenv

# Ignore rbenv local vars
.rbenv-vars

# Ignore node modules if using any JS tools
/node_modules

# Ignore Python scripts
insert_records.py
seeds.rb
