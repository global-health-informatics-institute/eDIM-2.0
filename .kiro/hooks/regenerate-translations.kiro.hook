{
  "enabled": true,
  "name": "Regenerate JS Translations",
  "description": "Automatically regenerates JavaScript translation files when YAML locale files are modified",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "config/locales/*.yml"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "The locale files have been updated. Please run `bundle exec rake i18n:js:export` to regenerate the JavaScript translations and then run `bundle exec rake assets:precompile` to update the compiled assets."
  }
}