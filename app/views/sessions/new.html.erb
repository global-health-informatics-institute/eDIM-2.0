<script>
  var tt_cancel_destination = "/sessions/destroy"
  //barcodeFocusOnce = true;
  //barcodeScanAction = gotoNextPage;
</script>

<style>
  /* Lightweight login-only polish; no keyboard/footer overrides */
  #container {
    background: linear-gradient(180deg, #f7fbfd 0%, #eef4f7 100%);
  }

  #content {
    min-height: 100vh;
  }

  #flash_notice,
  #flash_error,
  #flash_alert {
    position: fixed;
    top: 18px;
    right: 20px;
    z-index: 1005;
    margin: 0;
    max-width: 72vw;
    padding: 16px 22px;
    border-radius: 10px;
    font-size: 1.8rem;
    line-height: 1.3;
    font-weight: 700;
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.2);
    background: #ffffff;
    transition: opacity 0.35s ease;
  }

  #flash_notice {
    color: #1f7a3f;
    border: 2px solid #cce8d7;
  }

  #flash_error,
  #flash_alert {
    color: #a92a2a;
    border: 2px solid #f1c4c4;
    background: #fff6f6;
  }

  .tt_controls_login,
  .tt_controls_password {
    background: #ffffff;
    border: 1px solid #d7e0e8;
    border-radius: 12px;
    box-shadow: 0 8px 24px rgba(11, 44, 68, 0.08);
  }

  .tt_controls_login #inputFrame0,
  .tt_controls_password #inputFrame1,
  .tt_controls_login .inputFrameClass,
  .tt_controls_password .inputFrameClass {
    border-radius: 10px !important;
    border-color: #b6c6d3 !important;
  }

  .tt_controls_login .helpTextClass,
  .tt_controls_password .helpTextClass,
  #tt_page_login .helpTextClass,
  #tt_page_password .helpTextClass,
  label[for="login"],
  label[for="password"] {
    color: #355264 !important;
    letter-spacing: 0.2px;
  }

  #touchscreenInput0,
  #touchscreenInput1 {
    border-radius: 8px !important;
    border: 1px solid #b6c6d3 !important;
    background: #fcfeff !important;
  }
</style>

<%= form_for :user,method: 'POST', :url => '/sessions/login'  do |f| %>

  <label for="login">Username</label>
  <%= text_field_tag(:login, nil, :helpText => t('forms.labels.enter_username'),
                     :textCase => "lower", :field_type => "password",
                     :tt_onLoad => "barcodeId = 'touchscreenInput0';") %><br>

  <label for="password">Password</label>
  <%= password_field_tag(:password, nil, :helpText => t('forms.labels.password'),
                         :textCase => "lower", :field_type => "password",
                         :tt_onLoad => "inform(); barcodeId = 'touchscreenInput1';") %><br>

  <%= submit_tag value="Submit"%>
<% end %>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    ['flash_notice', 'flash_error', 'flash_alert'].forEach(function (id) {
      var el = document.getElementById(id);
      if (!el) return;

      setTimeout(function () {
        el.style.opacity = '0';
        setTimeout(function () {
          el.style.display = 'none';
        }, 350);
      }, 3500);
    });
  });
</script>
