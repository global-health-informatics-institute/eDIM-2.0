// Process the actual damage submission after confirmation
function processDamageSubmission(prepackId, quantity, reason, damageType) {
  console.log("Processing damage submission:", prepackId, quantity, reason, damageType);
  
  // Close confirmation modal
  closeDamageConfirmationModal();
  
  // Show "processing" notification
  showProcessingNotification();

  const url = `/general_inventory/${prepackId}/damage_item`;
  
  fetch(url, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      "X-CSRF-Token": document.querySelector("meta[name='csrf-token']").content
    },
    body: JSON.stringify({
      quantity: quantity,
      reason: reason,
      damage_type: damageType,
      prepack_id: prepackId
    })
  })
  .then(res => {
    if (!res.ok) {
      throw new Error(`HTTP error! status: ${res.status}`);
    }
    return res.json();
  })
  .then(data => {
    // Remove processing notification
    removeProcessingNotification();
    
    if (data.success) {
      // Show success message
      showSuccessNotification("Damage Recorded Successfully!");
      
      // Reload after delay
      setTimeout(() => {
        location.reload();
      }, 2500);
    } else {
      alert(data.message || "An error occurred");
    }
  })
  .catch(err => {
    // Remove processing notification
    removeProcessingNotification();
    
    console.error("Error submitting damage:", err);
    alert("An error occurred while submitting the damage.");
  });
}

// Show processing notification
function showProcessingNotification() {
  const processingNotification = document.createElement('div');
  processingNotification.id = 'processing-notification';
  processingNotification.style.cssText = `
