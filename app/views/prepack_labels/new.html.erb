<div id="printerModalShadow" style="display:none !important; position:fixed !important; top:0 !important; left:0 !important; width:100% !important; height:100% !important; background:rgba(0,0,0,0.5) !important; z-index:99998 !important;" onclick="closePrinterModal()"></div>


<div id="customAlertOverlay" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.6); z-index:999999; align-items:center; justify-content:center;">
  <div style="background:white; border-radius:12px; padding:24px; max-width:400px; width:90%; box-shadow:0 10px 40px rgba(0,0,0,0.4); text-align:center;">
    <div id="customAlertIcon" style="font-size:48px; margin-bottom:16px;">⚠️</div>
    <div id="customAlertMessage" style="font-size:1.4rem; color:#495057; margin-bottom:24px; font-weight:500;"></div>
    <button type="button" onclick="closeCustomAlert()" style="padding:12px 48px; font-size:1.2rem; background:#006495; color:white; border:none; border-radius:8px; cursor:pointer; font-weight:600;">OK</button>
  </div>
</div>

<script>
// Ensure modal is closed on page load (fixes back button issue)
window.addEventListener('pageshow', function(event) {
  var modal = document.getElementById('printerModal');
  var shadow = document.getElementById('printerModalShadow');
  if (modal) modal.style.setProperty('display', 'none', 'important');
  if (shadow) shadow.style.setProperty('display', 'none', 'important');
});

// Also close on regular page load
document.addEventListener('DOMContentLoaded', function() {
  var modal = document.getElementById('printerModal');
  var shadow = document.getElementById('printerModalShadow');
  if (modal) modal.style.setProperty('display', 'none', 'important');
  if (shadow) shadow.style.setProperty('display', 'none', 'important');
});

function showCustomAlert(message, isError) {
  var overlay = document.getElementById('customAlertOverlay');
  var msgEl = document.getElementById('customAlertMessage');
  var iconEl = document.getElementById('customAlertIcon');
  
  msgEl.textContent = message;
  
  if (isError) {
    iconEl.textContent = '⚠️';
  } else {
    iconEl.textContent = '✅';
  }
  
  overlay.style.display = 'flex';
}

function closeCustomAlert() {
  document.getElementById('customAlertOverlay').style.display = 'none';
}
</script>

<%= form_for :prescription, method: 'POST', url: dispensation_index_path, html: { id: 'dispenseFormElement' } do |f| %>
  <%= hidden_field_tag :prepacking, true %>
  <div id="dispenseForm2" style="display:none; position:absolute; top:5vh; left:5vw; width:90vw; height:90vh; background-color:#eeeeff; border:3px outset black; overflow:auto; z-index:1000;">
      
      <div style="position: absolute; top: 15px; right: 70px; z-index: 1001; pointer-events: none; max-width: 400px;">
        <span id="dispensationWarning" 
        style="display:none; color:red; font-weight:bold; font-size:1.8em;">
        </span>
      </div>
      
      <table style="width: 100%; border: 2px solid black; border-width: 0px 0px 2px 0px;">
        <tr>
          <td style="font-weight:bold; font-size: 1.8rem;">Item:</td>
          <th id="item" style="text-align: left;width: 30%; font-size: 1.6rem; font-weight: normal;">&nbsp;</th>
          <td style="text-align: left; font-size: 1.8rem; font-weight: bold;">Route:</td>
          <th style="text-align: left;width: 30%; font-size: 1.6rem; font-weight: normal;" id="route_type">&nbsp;</th>
          <td style="width: 5%;" rowspan="3">
            <img style="padding-right: 2px;float: right;" src="/assets/delete.png" onmousedown="cancelDispense()">
          </td>
        </tr>
        <tr>
          <td style="font-size: 1.8rem; font-weight: bold;">Bottle ID:</td>
          <th id="bottle_id" style="text-align: left;width: 20%; font-size: 1.6rem; font-weight: normal; ">&nbsp;</th>
          <td style="text-align: left; font-size: 1.8rem; font-weight: bold;">Directions:</td>
          <th style="text-align: left; font-size: 1.6rem; font-weight: normal; word-wrap: break-word; max-width: 300px;" id="directionsDisp">&nbsp;</th>
        </tr>
        <tr>
          <td style="font-size: 1.8rem; font-weight: bold;">Current Qty:</td>
          <th style="text-align: left; font-size: 1.6rem; font-weight: normal;" id="currQty" >&nbsp;</th>
          <td style="font-size: 1.8rem; font-weight: bold;">Quantity:</td>
          <th style="text-align: left; font-size: 1.8rem; font-weight: normal;" id="qtyDisp">&nbsp;</th>
        </tr>
      </table>

      <!-- TABS -->
      <div style="display: table; width:100%;">
        <div style="display: table-row;">
          <div style="display: table-cell; width:20%; padding:5px; vertical-align:top;">
            <table style="width:100%; border-spacing:0 10px;">
              <tr><th class="tab" style="font-weight:bold; font-size: 1.4rem; padding: 24px 15px;" id="routesTab" onmousedown="showDispenseDiv('routesDiv')">Route</th></tr>
              <tr><th class="tab" style="font-weight:bold; font-size: 1.4rem; padding: 24px 15px;" id="doseTab" onmousedown="showDispenseDiv('doseDiv')">Dose</th></tr>
              <tr><th class="tab" style="font-weight:bold; font-size: 1.4rem; padding: 24px 15px;" id="directionsTab" onmousedown="showDispenseDiv('directionsDiv')">Directions</th></tr>
              <tr><th class="tab" style="font-weight:bold; font-size: 1.4rem; padding: 24px 15px;" id="qtyTab" onmousedown="showDispenseDiv('qtyDiv')">Duration</th></tr>
              <tr><th class="tab" style="font-weight:bold; font-size: 1.4rem; padding: 24px 15px;" id="labelsTab" onmousedown="showDispenseDiv('labelsDiv')">Labels</th></tr>
            </table>
          </div>

          <div style="display: table-cell; border-left:2px solid black; height:70vh; position:relative;">
            <!-- ROUTES DIV -->


            <div class="mobi-div" id="routesDiv">
             <div class="section-wrapper">
              <h3 style="font-weight:bold; font-size:1.5rem;">Select Administration Route</h3>
              <div class="routes-container">
              <div class="radioDiv">
                <input type="radio" name="administration" class="radio" id="route-oral" value="oral" required onchange="setRoute('oral');setDirections();">
                <label class="custom" style="font-size:1.3rem; padding: 10px 5px !important;" for="route-oral">Oral</label>
              </div>
              <div class="radioDiv">
                <input type="radio" name="administration" class="radio" id="route-topical" value="topical" required onchange="setRoute('topical');setDirections();">
                <label class="custom" style="font-size:1.3rem; padding: 10px 5px !important;" for="route-topical">Topical</label>
              </div>
              <div class="radioDiv">
                <input type="radio" name="administration" class="radio" id="route-respiratory" value="respiratory" required onchange="setRoute('respiratory');setDirections();">
                <label class="custom" style="font-size:1.3rem; padding: 10px 5px !important;" for="route-respiratory">Respiratory</label>
              </div>
              <div class="radioDiv">
                <input type="radio" name="administration" class="radio" id="route-injection" value="injection" required onchange="setRoute('injection');setDirections();">
                <label class="custom" style="font-size:1.3rem; padding: 10px 5px !important;" for="route-injection">Injection</label>
              </div>
              <div class="radioDiv">
                <input type="radio" name="administration" class="radio" id="route-other" value="other" required onchange="setRoute('other');setDirections();">
                <label class="custom" style="font-size:1.3rem; padding: 10px 5px !important;" for="route-other">Other</label>
              </div>
              </div>
             </div> 
            </div>

            <!-- DOSE DIV -->
            <div class="mobi-div" id="doseDiv" style="display:none;">
              <div class="section-wrapper">
                <label for="dose" id="doseLabel" style="font-weight:bold; font-size:1.6rem;">Enter Dose</label>
                <input type="text" id="dose" name="dose" required style="width:200px; max-width:50%; padding:5px 8px; font-size:1.3rem;">

                <!-- Keypad container -->
                <div class="dose-keypad">
                  <% (1..9).each do |n| %>
                  <div class="customButton" onmousedown="append(<%= n %>,'dose');setDirections(); updateQuantity();">
                    <%= n %>
                  </div>
                  <% end %>
                  <div class="customButton" onmousedown="append('0','dose');setDirections(); updateQuantity();">0</div>
                  <div class="customButton" onmousedown="append('.','dose');setDirections(); updateQuantity();">.</div>
                  <div class="customButton" onmousedown="append('del','dose');setDirections(); updateQuantity();">del</div>
                </div>
              </div>
            </div>

            <!-- DIRECTIONS DIV -->
            <div class="mobi-div" id="directionsDiv" style="display: none;">
                <h3 style="font-weight:bold; font-size:1.8rem; margin-left: 15px;"><%= t('forms.labels.select_directions')%></h3>
                <div style="height: 58vh; overflow-x: hidden; overflow-y: auto;">
                  <div class="directions-grid">
                    <!-- Row 1 -->
                    <div class="radioDiv">
                      <input type="radio" name="frequency" class="radio" id="OD" value="OD" onchange="setDirections()" required>
                      <label class="custom" for="OD" style="font-size:1.3rem; padding: 10px 5px !important;"><%= t('forms.options.once_a_day')%></label>
                    </div>
                    <div class="radioDiv">
                      <input type="radio" name="frequency" class="radio" id="BD" value="BD" onchange="setDirections()" required>
                      <label class="custom" for="BD" style="font-size:1.3rem; padding: 10px 5px !important;"><%= t('forms.options.two_times_a_day')%></label>
                    </div>
                    <div class="radioDiv">
                      <input type="radio" name="frequency" class="radio" id="TDS" value="TDS" onchange="setDirections()" required>
                      <label class="custom" for="TDS" style="font-size:1.3rem; padding: 10px 5px !important;"><%= t('forms.options.three_times_a_day')%></label>
                    </div>
                    
                    <!-- Row 2 -->
                    <div class="radioDiv">
                      <input type="radio" name="frequency" class="radio" id="QID" value="QID" onchange="setDirections()" required>
                      <label class="custom" for="QID" style="font-size:1.3rem; padding: 10px 5px !important;"><%= t('forms.options.four_times_a_day')%></label>
                    </div>
                    <div class="radioDiv">
                      <input type="radio" name="frequency" class="radio" id="QHR" value="QHR" onchange="setDirections()" required>
                      <label class="custom" for="QHR" style="font-size:1.3rem; padding: 10px 5px !important;"><%= t('forms.options.every_hour')%></label>
                    </div>
                    <div class="radioDiv">
                      <input type="radio" name="frequency" class="radio" id="Q2HRS" value="Q2HRS" onchange="setDirections()" required>
                      <label class="custom" for="Q2HRS" style="font-size:1.3rem; padding: 10px 5px !important;"><%= t('forms.options.every_two_hours')%></label>
                    </div>
                    
                    <!-- Row 3 -->
                    <div class="radioDiv">
                      <input type="radio" name="frequency" class="radio" id="Q4HRS" value="Q4HRS" onchange="setDirections()" required>
                      <label class="custom" for="Q4HRS" style="font-size:1.3rem; padding: 10px 5px !important;"><%= t('forms.options.every_four_hours')%></label>
                    </div>
                    <div class="radioDiv">
                      <input type="radio" name="frequency" class="radio" id="EOD" value="EOD" onchange="setDirections()" required>
                      <label class="custom" for="EOD" style="font-size:1.3rem; padding: 10px 5px !important;"><%= t('forms.options.every_other_day')%></label>
                    </div>
                    <div class="radioDiv">
                      <input type="radio" name="frequency" class="radio" id="QN" value="QN" onchange="setDirections()" required>
                      <label class="custom" for="QN" style="font-size:1.3rem; padding: 10px 5px !important;"><%= t('forms.options.every_night')%></label>
                    </div>
                    
                    <!-- Row 4 - Last row with only one item -->
                    <div class="radioDiv">
                      <input type="radio" name="frequency" class="radio" id="QWK" value="QWK" onchange="setDirections()" required>
                      <label class="custom" for="QWK" style="font-size:1.3rem; padding: 10px 5px !important;"><%= t('forms.options.once_a_week')%></label>
                    </div>
                  </div>

                  <!-- Time of Day section -->
                  <div style="margin-top: 25px; padding: 0 1.5em;">
                    <h4 style="margin-top:15px; font-size: 1.6rem; margin-left: 0;">Time of Day</h4>

                    <div class="timeOfDayGrid">
                      <label class="timeBox">
                        <input style="width: 24px; height: 24px;" type="checkbox" name="times[]" value="morning" onchange="setDirections()">
                        <img style="width: 40px; height: 40px;" src="/assets/sunrise.png" alt="Morning">
                        <span style="font-size: 1.3rem">Morning</span>
