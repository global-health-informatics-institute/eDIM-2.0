  function searchAndPrintLabel() {
    const searchBottleIdEl = document.getElementById('searchBottleId');
    const inputBottleId = searchBottleIdEl ? searchBottleIdEl.value.trim() : '';
    const bottleId = inputBottleId || currentBottleId;
    const packNo = document.getElementById('searchPackNo').value.trim();

    if (bottleId === '') {
      showFlashMessage('Please enter a Bottle ID', 'error', { transient: true, duration: 1000 });
      return;
    }

    if (packNo === '') {
      showFlashMessage('Please enter a Pack Number', 'error', { transient: true, duration: 1000 });
      return;
    }

    let packNum = parseInt(packNo);
    if (isNaN(packNum) || packNum < 1) {
      showFlashMessage('Pack Number must be 1 or higher', 'error', { transient: true, duration: 1000 });
      return;
    }

    // Validate bottle ID format (should be G followed by digits, or PK-G followed by digits)
    let cleanBottleId = bottleId;
    if (cleanBottleId.toUpperCase().startsWith('PK-')) {
      cleanBottleId = cleanBottleId.substring(3);
    }
    if (!/^G\d+$/i.test(cleanBottleId)) {
      showFlashMessage('Invalid Bottle ID format. Should be like G0000059 or PK-G0000059', 'error', { transient: true, duration: 1000 });
      return;
    }
    
    if (cleanBottleId.length < 7) {
      showFlashMessage('Bottle ID too short. Use full ID like G0000026', 'error', { transient: true, duration: 1000 });
      return;
    }
    
    const frame = document.getElementById('prepackPrintFrame');
    let labelIdentifier = 'PK-' + cleanBottleId;
    if (packNo !== '') {
      labelIdentifier += '-' + packNo;
    }
    
    fetch('/prepack_labels/check_label?label_identifier=' + encodeURIComponent(labelIdentifier))
      .then(response => response.json())
      .then(data => {
        console.log('Label check response:', data);
        
        if (!data.exists) {
          showCustomAlert('Label not found: ' + (data.error || 'Unknown error'), true);
          return;
        }
        
        if (!data.can_print) {
          showCustomAlert('Cannot print: ' + data.message, true);
          return;
        }
        
        let printUrl = `/print_dispensation_label/SEARCH?label_identifier=${encodeURIComponent(labelIdentifier)}&_ts=${Date.now()}`;
        console.log('Search Print URL:', printUrl);
        showFlashMessage('Printing label...', 'notice', { transient: true, duration: 500 });

        closePrinterModal();

        if (!frame) {
          window.location = printUrl;
          return;
        }

        if (prepackPrintFallbackTimer) clearTimeout(prepackPrintFallbackTimer);
        prepackPrintFallbackTimer = setTimeout(function() {
          hideFlashMessage();
        }, 2000);

        frame.onload = function() {
          if (prepackPrintFallbackTimer) clearTimeout(prepackPrintFallbackTimer);
          hideFlashMessage();
          frame.onload = null;
        };

        frame.src = printUrl;
      })
      .catch(error => {
        console.error('Error checking label:', error);
        showFlashMessage('Error checking label status. Proceeding with print...', 'notice', { transient: true, duration: 2000 });
        let printUrl = `/print_dispensation_label/SEARCH?label_identifier=${encodeURIComponent(labelIdentifier)}&_ts=${Date.now()}`;
        closePrinterModal();
        if (frame) {
          frame.src = printUrl;
        } else {
          window.location = printUrl;
        }
      });
  }

