<html xmlns="http://www.w3.org/1999/html">
<head>
<style>
/* Administration Route  */
.routes-container {
  display: grid;
  grid-template-columns: repeat(3, minmax(140px, 1fr)); 
  grid-template-rows: repeat(2, auto);                  
  gap: 0.5em 0.5em;                                         
  justify-content: start;
  padding-left: 1.2em;
  margin-top: 0.5em;
  width: 100%;
  box-sizing: border-box;
}

.routes-container .radioDiv {
  min-width: 140px;
}

div.radioDiv {
  min-width: 16vw;
}

input.radio:empty {
  margin-left: -999px;
  visibility: hidden;
}

label.custom {
  border-radius: 3px;
  border: 1px solid #D1D3D4;
  font-size: 1.4rem !important;
  display: inline-block;
  text-indent: 3.25em;
  position: relative;
  cursor: pointer;
  user-select: none;
}

input.radio:empty label:before {
  position: absolute;
  display: block;
  top: 0;
  bottom: 0;
  left: 0;
  content: '';
  width: 2.5em;
  background: #D1D3D4;
  border-radius: 3px 0 0 3px;
}

input.radio:checked ~ label:before {
  content: '\2714';
  text-indent: .9em;
  color: #000;
  background-color: #CCCCCC;
}

input.radio:checked label {
  color: #000;
  font-weight: bold;
}

/* Wrapper for Route or Dose sections */
.section-wrapper {
  display: flex;
  flex-direction: column;
  gap: 5px;         
  margin-left: 15px; 
}

/* Align the text labels slightly */
.section-wrapper h3,
.section-wrapper label {
  margin-left: 0;   
}
  /* Dose input field styling */
.section-wrapper input#dose {
  width: 200px;       
  max-width: 50%;     
  padding: 5px 8px;   
  font-size: 1.2em;   
}

/* Dose Keypad */
.dose-keypad {
  display: grid;
  grid-template-columns: repeat(3, 80px);
  grid-auto-rows: 80px;
  gap: 60px 90px;
  justify-content: start;
  margin-top: 15px;
  margin-left: 25px;         
}
.customButton {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #D1D3D4;
  border: 1px solid #999;
  border-radius: 5px;
  font-size: 2rem;
  font-weight: bold;
  cursor: pointer;
  user-select: none;
  width: 130px;
  height: 80px;     
}
.duration-keypad .customButton {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 130px;
  height: 80px;
  font-size: 2rem;
  font-weight: bold;
  background-color: #D1D3D4;
  border: 1px solid #999;
  border-radius: 5px;
  cursor: pointer;
  user-select: none;
  transition: background-color 0.2s, transform 0.1s;
}
/* Directions selection */
.directions-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(140px, 1fr));
  grid-template-rows: repeat(4, auto);
  gap: 0.5em 1em;  
  justify-content: start;
  padding-left: 1.5em;
}

.directions-grid .radioDiv {
  min-width: auto; 
  width: 100%;
}
/* Duration tab */
.duration-keypad {
  display: grid;
  grid-template-columns: repeat(3, 80px);
  grid-auto-rows: 80px;
  gap: 60px 90px;
  justify-content: start;     
  margin-top: 15px;
  margin-left: 25px; 
}

/* View options animation */
.view-options-menu.show {
  opacity: 1 !important;
  transform: translateY(-50%) translateX(0) !important;
  pointer-events: auto !important;
}

/* Show captions when tray is open */
.view-options-menu.show .option-caption {
  opacity: 1 !important;
}

/* View icon */
.view-icon.active {
  background: #f0f9ff !important;
  box-shadow: 0 4px 16px rgba(0, 100, 149, 0.25) !important;
  transform: scale(1.05) !important;
}

/* When tray is open, add connector line */
.view-options-container.active::after {
  content: '';
  position: absolute;
  top: 50%;
  right: 100%;
  width: 0;
  height: 2px;
  background: linear-gradient(90deg, rgba(0, 100, 149, 0.2), transparent);
  transform: translateY(-50%);
  z-index: 99;
  pointer-events: none;
}

@keyframes extendConnection {
  to { width: 30px; }
}

/* Animate the tray handle */
.view-options-menu.show .tray-handle {
  opacity: 1 !important;
  animation: pulseHandle 2s ease-in-out infinite;
}

@keyframes pulseHandle {
  0%, 100% { background: #e5e7eb; }
  50% { background: #006495; }
}

/* Animate option icons in with stagger */
.view-options-menu.show .option-item img {
}

/* Hover effects for option items */
.option-item:hover img {
  transform: scale(1.15) !important;
  background-color: rgba(0, 100, 149, 0.08) !important;
}

.option-item:hover .option-caption {
  color: #006495 !important;
  font-weight: 600 !important;
}

/* Subtle glow to the entire tray when open */
.view-options-menu.show {
  box-shadow: 0 10px 30px rgba(0, 100, 149, 0.15), 0 5px 15px rgba(0, 0, 0, 0.08) !important;
}

/* Smooth transitions for all icons */
img[src*="/assets/"] {
  transition: transform 0.2s ease, opacity 0.2s ease, filter 0.2s ease, background-color 0.2s ease;
}

/* Prepack styles */
/* Compact Brand Section */
.brand-section-compact {
  width: 14vw;
  background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
  border-radius: 16px; 
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2); 
  border: 1px solid #cbd5e1;
  min-width: 160px; 
  min-height: 160px;
  margin-top: 1vh;
  text-align: center;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 12px;
  flex: 0 0 auto;
  padding-top: 18px;
  margin-left: 10px; 
}

.brand-logo-image {
  flex: 1;
  width: 12vw; 
  height: 25vh; 
  object-fit: contain;
  filter: brightness(0) invert(0);
  max-width: 100%;
  max-height: 80px; 
  transition: transform 0.3s ease;
}
.current-date-compact {
  font-size: 1.6rem;
  font-weight: 600;
  color: #475569; 
  display: block;
  line-height: 1.2;
  margin-top: 5px;
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
}

/* Header Cell */
.header-cell{
  flex: 1;
  padding: 20px; /* Increased from 15px */
  background: linear-gradient(135deg, #ffffff 0%, #fafcff 100%); 
  border-radius: 16px;
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3); 
  border: 1px solid #e2e8f0; 
  min-height: 160px; /* Match the logo container height */
  max-height: 160px; /* Match the logo container height */
  display: flex;
  flex-direction: column;
  justify-content: center; /* Center content vertically */
  transition: all 0.3s ease;
  margin-right: 10px;
}

/* scanner input */
.scanner {
  flex: 1;
  max-width: 400px; /* Increased from 300px */
  min-width: 350px; /* Added minimum width */
  height: 60px; /* Increased from 40px to make it more prominent */
  border: 2px solid #d1d5db;
  border-radius: 8px;
  padding: 0 15px; /* Increased from 10px */
  font-size: 1.8rem; /* Increased from 1.6rem */
  transition: all 0.2s ease;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
  background: #ffffff; 
}

.scanner:focus {
  outline: none;
  border-color: #006495;
  box-shadow: 0 0 0 3px rgba(0, 100, 149, 0.2), 0 4px 8px rgba(0, 0, 0, 0.1);
  background: #ffffff; 
}

.main-content-cell {
  width: 100%;
  min-height: auto;
  padding: 12px;
}

.brand-logo-compact {
  margin: 0;
  font-size: 1.5rem;
}

</style>
</head>
<body style="margin:0; padding:0; display: flex; flex-direction: column; min-height: 100vh;">
  <div id="shadowLayer" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.35); z-index:10000;"></div>
  <div id="messageLayer" style="display:none; position:fixed; top:20%; left:50%; transform:translateX(-50%); z-index:10001; background:#fff; border-radius:12px; padding:24px 28px; min-width:320px; max-width:70vw; box-shadow:0 10px 30px rgba(0,0,0,0.3);">
    <div style="display: table-row">
      <div style="display: table-cell; text-align: center;">&nbsp;</div>
    </div>
    <div style="display: table-row">
      <div style="display: table-cell; text-align: center;">
        <h2 id="flashMessage" style="margin:0; font-size:2.2rem; line-height:1.3;"></h2>
      </div>
    </div>
    <div style="display: table-row">
      <div style="display: table-cell; text-align: center;">
        <button onmousedown="hideFlashMessage()" style="margin-top:16px;">
          <span><%= t('forms.buttons.ok_button') %></span>
        </button>
      </div>
    </div>
  </div>
  <div style="width: 99vw; margin: auto; flex: 0 0 auto;">
    <!-- HEADER -->
    <div style="display: table-row;">
      <div style="width: 83vw; float:left; margin-top:1vh; padding:10px; height:10vh; border: 1px solid #d1d5db; background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);" class="header-cell">
        <div style="display:flex; align-items:center; gap:15px; margin-bottom:12px;">
          <strong style="font-size:2rem; font-weight:bold;">Scan Barcode</strong>
          <img src="/assets/barcode.jpg" style="height:40px; vertical-align:middle;">
          <input type="text" id="barcode" class="scanner" style="flex:1; max-width:400px; height:60px;" autofocus>
        </div>

        <table style="width:50%; border-collapse:collapse; font-size:1.1em; margin-bottom:0;">
          <tr>
            <td style="font-weight:bold; width:120px; font-size:1.8rem; padding-bottom:4px;">Facility</td>
            <td style="padding-left:15px; font-size:1.8rem; padding-bottom:4px;"><%= facility_name rescue '—' %></td>
          </tr>
          <tr>
            <td style="font-weight:bold; font-size:1.8rem;">Location</td>
            <td style="padding-left:15px; font-size:1.8rem;"><%= current_location.name.titleize rescue '—' %></td>
          </tr>
        </table>
      </div>
      <div class="brand-section-compact">
        <img src="/assets/edim-logo.png" class="brand-logo-image" alt="eDIM Logo">
        <span class="current-date-compact"><%= l(Date.today, format: '%d %b %Y') %></span>
      </div>
    </div>
  
  <!-- MAIN CONTENT -->
  <div style="border:3px solid #06425C; border-radius: 12px 12px 12px 12px; margin-top:1vh; height:68vh; padding: 0; display: flex; flex-direction: column; overflow: hidden;">

  <!-- PREPACK LISTING SECTION -->
  <div style="width: 100%; background: linear-gradient(135deg, #006495 0%, #004d73 100%); height: 4vh; text-align: center; color: white; padding-top: 1vh; flex-shrink: 0; /* NO border-radius here */ box-shadow: 0 4px 12px rgba(0, 100, 149, 0.3);">
    <span style="font-size: 1.5rem; font-family: 'Arial Black', Gadget, sans-serif; text-shadow: 0 1px 3px rgba(0, 0, 0, 0.3);">Prepack Inventory</span>
  </div>

  <div style="flex: 1; overflow: auto; padding: 0 5px;">
    <div style="display: table; width: 100%;">  
      <% if @prepack_inventory.present? %>
      <% first_prepack = @prepack_inventory.first %>
        <% @prepack_inventory.each_with_index.each_slice(2).to_a.each do |prepack_pair| %>
          <div style="display: table-row; width: 100%;">  <!-- Full width row -->
            <% prepack_pair.each do |prepack, global_index| %>
              <% next if prepack.blank? %>
                <div id="prepack_row_<%= prepack[:id] %>" 
                  style="display: table-cell; width: 49vw; padding: 5px;" 
                  data-prepack-id="<%= prepack[:id] %>">
                  <div style="border: 1px solid <%= prepack[:packs_dispensed] == prepack[:total_packs_created] ? '#dc3545' : (prepack[:packs_dispensed] >= 0 ? '#2E8B57' : 'gray') %>; 
                      padding: 8px; margin: 3px; 
                      background-color: <%= prepack[:packs_dispensed] == prepack[:total_packs_created] ? '#FFF5F5' : (prepack[:packs_dispensed] >= 0 ? '#F0FFF0' : '#F8F9FA') %>;
                      position: relative; border-radius: 8px; min-height: 90px; cursor: pointer; transition: all 0.2s ease;"
                      onclick="showPrepackDetailModal('<%= prepack[:id] %>', '<%= j(prepack[:drug_name]) %>', '<%= prepack[:packs_dispensed] %>', '<%= prepack[:total_packs_created] %>', '<%= prepack[:quantity_per_pack] %>', '<%= prepack[:gn_identifier] %>', '<%= prepack[:status] %>', '<%= prepack[:created_at].present? ? l(prepack[:created_at].to_date, format: "%d/%m/%Y") : "N/A" %>', '<%= prepack[:packs_remaining] %>')"
                      onmouseover="this.style.boxShadow='0 4px 12px rgba(0,0,0,0.15)'">
                      
                      <!-- Progress Indicator and Action Buttons -->
                      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                          <!-- Progress Indicator -->
                          <div style="font-size: 1.3rem; font-weight: bold;
                                  color: <%= prepack[:packs_dispensed] == prepack[:total_packs_created] ? '#dc3545' : (prepack[:packs_dispensed] >= 0 ? '#2E8B57' : '#666') %>;">
                              <%= prepack[:packs_dispensed] %>/<%= prepack[:total_packs_created] %> Dispensed
                          </div>
                          <!-- Quantity per pack -->
                          <div style="margin-bottom: 4px; right: 8px">
                              <div style="font-size: 1.5rem;">
                                  <span style="color: #666; font-weight: bold;">Qty per pack: </span>
                                  <span style="font-weight: bold; color: #2E8B57;"><%= prepack[:quantity_per_pack] %></span>
                              </div>
                          </div>

                          <div style="font-size: 1.5rem; font-weight: bold; margin-right: 315px; margin-top:-2px;">
                              <span style="font-weight: bold; right:8px;">
                                <% if prepack[:created_at].present? %>
                                  <%= l(prepack[:created_at].to_date, format: "%d/%m/%Y") %>
                                <% else %>
                                  N/A
                                <% end %>
                              </span>
                          </div>
                          
                      <!-- Action Buttons -->
                      <div style="position: absolute; top: 43%; right: 16px; transform: translateY(-50%); display: flex; gap: 18px; align-items: center;"
                           onclick="event.stopPropagation();">
                      
                        <!-- View Item Button -->
                        <div class="view-options-container" style="position: relative; right: 32px;">
                          <!-- Main View Icon -->
                          <img id="view_icon_<%= prepack[:id] %>" 
                              class="view-icon" 
                              style="cursor: pointer; width: 56px; height: 68px; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); 
                                    position: relative; z-index: 101; border-radius: 50%; 
                                    padding-top: 8px; padding-left: -6px;" 
                              src="/assets/view_icon.png" 
                              title="View Options"
                              onmousedown="event.stopPropagation(); toggleViewOptions('<%= prepack[:id] %>')"
                              
                          <!-- Expandable Options -->
                          <div id="view_options_<%= prepack[:id] %>" 
                              class="view-options-menu"
                              style="position: absolute; top: 50%; right: 100%; transform: translateY(-50%) translateX(30px); 
                                    background: white; border-radius: 12px; 
                                    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1), 0 5px 15px rgba(0, 0, 0, 0.05); 
                                    padding: 16px 20px 16px 16px; z-index: 100; opacity: 0; 
                                    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); 
                                    display: flex; align-items: center; gap: 8px; pointer-events: none;
                                    min-width: 280px;">
                            
                            <!-- The tray container -->
                            <div style="display: flex; gap: 24px; align-items: flex-start; position: relative; width: 100%; justify-content: space-between;">
                              <!-- Tray "handle" indicator -->
                              <div class="tray-handle" style="width: 4px; height: 60px; background: #e5e7eb; border-radius: 2px; margin-right: 16px; opacity: 0; align-self: center;"></div>
                              
                           <!-- Edit Button -->
<div class="option-item" style="position: relative; display: flex; flex-direction: column; align-items: center; gap: 8px; min-width: 70px; animation-delay: 0.1s;">
  <img style="cursor: pointer; width: 48px; height: 48px; transition: all 0.3s ease; 
            opacity: 0; transform: scale(0.8) translateX(10px); 
            padding: 6px; border-radius: 10px;" 
       src="/assets/edit.png" 
       title="Edit Prepack"
       data-prepack-id="<%= prepack[:id] %>"
       onmousedown="event.stopPropagation(); editPrepackInline(this.dataset.prepackId)"
       onmouseover="this.style.transform='scale(1.15)'; this.style.backgroundColor='rgba(0, 100, 149, 0.05)'"
       onmouseout="this.style.transform='scale(1)'; this.style.backgroundColor='transparent'">
  <div class="option-caption" style="font-size: 1rem; font-weight: 500; color: #333; text-align: center; 
        white-space: nowrap; opacity: 0; transition: opacity 0.3s ease 0.2s;">
    Edit
  </div>
</div>



                              <!-- Log Damages Button -->
                              <div class="option-item" style="position: relative; display: flex; flex-direction: column; align-items: center; gap: 8px; min-width: 70px; animation-delay: 0.2s;">
                                <img style="cursor: pointer; width: 48px; height: 48px; transition: all 0.3s ease; 
                                          opacity: 0; transform: scale(0.8) translateX(10px); 
                                          padding: 6px; border-radius: 10px;" 
                                    src="/assets/damage.png" 
                                    title="Log Damages"
                                    onmousedown="event.stopPropagation(); logDamages(
                                      '<%= prepack[:id] %>', 
                                      '<%= prepack[:drug_name] %>', 
                                      <%= prepack[:packs_remaining] %>, 
                                      <%= prepack[:bottle_quantity] || 0 %>,
                                      <%= prepack[:quantity_per_pack] || 0 %>
                                    )"
                                    onmouseover="this.style.transform='scale(1.15)'; this.style.backgroundColor='rgba(0, 100, 149, 0.05)'"
                                    onmouseout="this.style.transform='scale(1)'; this.style.backgroundColor='transparent'">
                                <div class="option-caption" style="font-size: 1rem; font-weight: 500; color: #333; text-align: center; 
                                      white-space: nowrap; opacity: 0; transition: opacity 0.3s ease 0.3s;">
                                  Log Damages
                                </div>
                              </div>
                              
                              <!-- Delete Button -->
                              <div class="option-item" style="position: relative; display: flex; flex-direction: column; align-items: center; gap: 8px; min-width: 70px; animation-delay: 0.3s;">
                                <img style="cursor: pointer; width: 48px; height: 48px; transition: all 0.3s ease; 
                                          opacity: 0; transform: scale(0.8) translateX(10px); 
                                          padding: 6px; border-radius: 10px;" 
                                    src="/assets/delete.png" 
                                    title="Delete Prepack"
                                    onmousedown="event.stopPropagation(); confirmAction('<%= delete_prepack_label_path(prepack[:id]) %>', 'Are you sure you want to remove this prepack from the list?')"
                                    onmouseover="this.style.transform='scale(1.15)'; this.style.backgroundColor='rgba(0, 100, 149, 0.05)'"
                                    onmouseout="this.style.transform='scale(1)'; this.style.backgroundColor='transparent'">
                                <div class="option-caption" style="font-size: 1rem; font-weight: 500; color: #333; text-align: center; 
                                      white-space: nowrap; opacity: 0; transition: opacity 0.3s ease 0.4s;">
                                  Delete
                                </div>
                              </div>
                            </div>
                          </div>

                        </div>                        
                        
                        <!-- Print Button -->
                        <img style="cursor: pointer; width: 40px; height: 40px; transition: transform 0.2s ease;" 
                            src="/assets/print.png" 
                            title="Print prepack labels"
                            onmousedown="event.stopPropagation(); window.location='/print_dispensation_label/PREPACK-<%= prepack[:id] %>?single=1'"
                            onmouseover="this.style.transform='scale(1.1)'"
                            onmouseout="this.style.transform='scale(1)'">
                        
                        <!-- Delete/Cancel Button -->
                        
                      </div>
                    
                      </div>

                      <!-- Drug Name -->
                      <div style="font-size: 1.5rem; font-weight: bold; color: #006495; margin-bottom: 4px;">
                          <%= prepack[:drug_name] %>
                      </div>

                      <!-- Bottle Info -->
                      <div style="font-size: 1.5rem; color: #666; margin-bottom: 6px;">
                          <span style="font-size: 1.5rem; font-weight: bold;">Bottle: </span> 
                          <span style="font-size: 1.5rem;">
                              <% if prepack[:gn_identifier].present? %>
                                  <%= prepack[:gn_identifier] %>
                              <% end %>
                          </span>
                      </div>

                      <!-- Progress Bar -->
                      <div style="background: #e9ecef; border-radius: 10px; height: 6px; overflow: hidden;">
                          <div style="height: 100%; background: #28a745; border-radius: 10px; 
                                  width: <%= (prepack[:packs_dispensed].to_f / prepack[:total_packs_created] * 100).round(1) %>%"></div>
                      </div>

                      <!-- Status Badge Only -->
                      <div style="position: absolute; top: -6px; right: -6px; z-index: 50;">
                        <!-- Status Badge -->
                        <div style="background: <%= 
                          case prepack[:status]
                          when 'created', 'active'
                            '#28a745'
                          when 'dispensed'
                            '#a10e0e'
                          when 'cancelled'
                            '#dc3545'
                          else
                            '#ffc107'
                          end
                        %>; 
                        color: white; padding: 1px 8px; border-radius: 8px; font-size: 0.9rem;
                        font-weight: bold; min-width: 70px; text-align: center;">
                          <% case prepack[:status] %>
                          <% when 'created', 'active' %>
                            ACTIVE
                          <% when 'dispensed' %>
                            DONE
                          <% when 'cancelled' %>
                            CANCELLED
                          <% else %>
                            <%= prepack[:status]&.upcase %>
                          <% end %>
                        </div>
                      </div>
                  </div>
              </div>
              <% end %>
              
              <!-- Fill empty cell if we have an odd number in this pair -->
              <% if prepack_pair.length == 1 %>
                <div style="display: table-cell; width: 47vw; padding: 5px;">
                  <!-- Empty cell to maintain layout -->
                </div>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <div style="display: table-row;">
            <div style="display: table-cell; padding: 40px; text-align: center; color: #666;">
              <p style="font-size: 1.4rem;">No prepack inventory found.</p>
              <p style="font-size: 1.2rem;">Scan a bottle to create prepacking labels.</p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

<!-- Modal Overlay -->
<div id="modalOverlay" style="display:none;"></div>
<%= form_for :prescription, method: 'POST', url: dispensation_index_path, html: { id: 'dispenseFormElement' } do |f| %>
  <%= hidden_field_tag :prepacking, true %>

  <!-- DISPENSE FORM MODAL -->
  <div id="dispenseForm2" style="display:none; position:absolute; top:5vh; left:5vw; width:90vw; height:90vh; background-color:#eeeeff; border:3px outset black; overflow:auto; z-index:1000;">
      
      <!-- Warning Message Overlay - Completely Outside Normal Flow -->
      <div style="position: absolute; top: 15px; right: 70px; z-index: 1001; pointer-events: none; max-width: 400px;">
        <span id="dispensationWarning" 
        style="display:none; color:red; font-weight:bold; font-size:1.8em;">
        </span>
      </div>
      
