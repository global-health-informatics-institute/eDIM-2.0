  // Proceed to print all
  function proceedToPrintAll(prepackIdToPrint, frame) {
    let printUrl = `/print_dispensation_label/PREPACK-${prepackIdToPrint}?print_all_undispensed=1&_ts=${Date.now()}`;
    
    console.log('Print All URL:', printUrl);
    
    // Show printing notification FIRST
    showFlashMessage('Printing all available labels...', 'notice', { transient: true, duration: 1500 });
    
    // Store for later
    const prepackIdForRefresh = currentPrepackId;
    const bottleIdForRefresh = currentBottleId;
    
    // Close modal but keep flash message visible during printing
    closePrinterModal();
    
    if (!frame) {
      window.location = printUrl;
      return;
    }
    
    if (prepackPrintFallbackTimer) clearTimeout(prepackPrintFallbackTimer);
    prepackPrintFallbackTimer = setTimeout(function() {
