  // Set the step/interval for increment/decrement (same as Log Damages)
  function setStep(step) {
    packNoStep = parseInt(step);
    
    // Update button styles to show selected step
    var buttons = [
      {id: 'stepBtn0', value: 0},
      {id: 'stepBtn10', value: 10},
      {id: 'stepBtn100', value: 100},
      {id: 'stepBtn1000', value: 1000}
    ];
    
    for (var i = 0; i < buttons.length; i++) {
      var btn = buttons[i];
      var el = document.getElementById(btn.id);
      if (el) {
        if (btn.value === packNoStep) {
          el.style.border = '2px solid #006495';
          el.style.background = '#006495';
          el.style.color = 'white';
        } else {
          el.style.border = '2px solid #dee2e6';
          el.style.background = '#f8f9fa';
          el.style.color = '#495057';
        }
      }
    }
  }

  // Allow direct typing in pack number field - filter non-numeric input
  (function() {
    var packNoField = document.getElementById('searchPackNo');
    if (packNoField) {
      packNoField.addEventListener('input', function(e) {
        // Remove any non-numeric characters
        this.value = this.value.replace(/[^0-9]/g, '');
        // Ensure value is at least 0
        var val = parseInt(this.value);
        if (isNaN(val) || val < 0) val = 0;
        this.value = val;
      });
      
      packNoField.addEventListener('blur', function() {
        // Ensure value is set on blur
        if (this.value === '' || parseInt(this.value) < 0) {
          this.value = '0';
        }
      });
    }
  })();
  
