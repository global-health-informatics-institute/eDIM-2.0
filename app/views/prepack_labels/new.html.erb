// SUBMIT Functions and Validations

function submitDamageWithValidation(prepackId, drugName, maxQuantity, packSize, bottle_quantity) {
  const quantityInput = document.getElementById('damageQuantity');
  const reasonSelect = document.getElementById('damageReason');

  let quantity = parseInt(quantityInput.value, 10);

  if (isNaN(quantity) || quantity < 0) {
    alert('Please enter a valid quantity (0 or greater)');
    return;
  }

  if (quantity === 0) {
    if (!confirm("You're reporting 0 damages. Are you sure?")) return;
  }

  // Determine damage type
  const damageType = [...document.getElementsByName('damageType')]
    .find(r => r.checked)?.value || 'pack';

  const maxQty = damageType === 'pack' ? maxQuantity : bottle_quantity;
  if (quantity > maxQty) {
    alert(`Quantity cannot exceed available: ${maxQty}`);
    return;
  }

  const finalQuantity = quantity;

  showDamageConfirmationModal(
    finalQuantity,
    drugName,
    reasonSelect.value,
    prepackId,
    damageType
  );
}

