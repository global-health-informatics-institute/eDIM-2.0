<script>
// Checkbox Validation for Prepack Labels
const prepackFrequencyMap = {
  OD: 1,
  BD: 2,
  TDS: 3,
  QID: 4
};

const prepackFreqRadios = document.querySelectorAll("input[name='frequency']");
const prepackCheckboxes = document.querySelectorAll(".timeOfDayGrid input[type=checkbox]");
const nextBtn = document.getElementById('nextBtn');

// Define which tabs come after directions
const tabsAfterDirections = ['qtyTab', 'labelsTab'];
const tabsBeforeDirections = ['routesTab', 'doseTab'];

// Helpers to get selected frequency and checkbox count
function getPrepackSelectedFrequency() {
  const selected = document.querySelector("input[name='frequency']:checked");
  return selected ? selected.value : null;
}

function getPrepackSelectedCheckboxCount() {
  return Array.from(prepackCheckboxes).filter(cb => cb.checked).length;
}

function isPrepackCheckboxValidationRequired(freq) {
  // Only these frequencies require checkbox validation
  return ['OD', 'BD', 'TDS', 'QID'].includes(freq);
}

// Enhanced validation function
function validatePrepackCheckboxSelection() {
  const freq = getPrepackSelectedFrequency();
  const checkedCount = getPrepackSelectedCheckboxCount();
  
  // If no frequency selected or frequency doesn't require checkbox validation
  if (!freq || !isPrepackCheckboxValidationRequired(freq)) {
    return { isValid: true, required: 0, selected: checkedCount };
  }
  
  const required = prepackFrequencyMap[freq];
  const isValid = checkedCount === required;
  
  return { isValid, required, selected: checkedCount };
}

// --- Enhanced updateCheckboxState function ---
function updateCheckboxState() {
  const freq = getPrepackSelectedFrequency();
  const validation = validatePrepackCheckboxSelection();

  // No frequency selected → disable all
  if (!freq) {
    prepackCheckboxes.forEach(cb => {
      cb.checked = false;
      cb.disabled = true;
    });
    updatePrepackTabNavigation();
    return;
  }

  // Handle special frequencies
  switch(freq) {
    case "QHR":
    case "Q2HRS":
    case "Q4HRS":
      prepackCheckboxes.forEach(cb => { 
        cb.checked = false; 
        cb.disabled = true; 
      });
      updatePrepackTabNavigation();
      return;

    case "EOD":
      prepackCheckboxes.forEach(cb => { 
        cb.checked = false; 
        cb.disabled = true; 
      });
      updatePrepackTabNavigation();
      return;

    case "QN":
      prepackCheckboxes.forEach(cb => { 
        cb.checked = false; 
        cb.disabled = false; 
      });
      const night = document.querySelector(".timeOfDayGrid input[value='night']");
      if (night && !night.checked) night.checked = true;
      updatePrepackTabNavigation();
      return;

    case "QWK":
      prepackCheckboxes.forEach(cb => { 
        cb.checked = false; 
        cb.disabled = true; 
      });
      updatePrepackTabNavigation();
      return;
  }

  // Standard frequencies (OD, BD, TDS, QID)
  const max = prepackFrequencyMap[freq];
  const checkedCount = getPrepackSelectedCheckboxCount();

  prepackCheckboxes.forEach(cb => {
    if (!cb.checked) {
      cb.disabled = checkedCount >= max;
    } else {
      cb.disabled = false;
    }
  });

  updatePrepackTabNavigation();
}

// Tab Navigation control based on validation
function updatePrepackTabNavigation() {
  const validation = validatePrepackCheckboxSelection();
  const directionsTab = document.getElementById('directionsTab');
  const currentDiv = document.querySelector('.mobi-div:not([style*="display: none"])');
  
  if (!directionsTab || !currentDiv) return;
  
  const currentDivId = currentDiv.id;
  
  // Only restrict navigation if we're on the directions tab
  if (currentDivId === 'directionsDiv' && !validation.isValid && isPrepackCheckboxValidationRequired(getPrepackSelectedFrequency())) {
    // Disable only tabs AFTER directions (qtyTab, labelsTab)
    tabsAfterDirections.forEach(tabId => {
      const tab = document.getElementById(tabId);
      if (tab) {
        tab.style.pointerEvents = 'none';
        tab.style.opacity = '0.5';
        tab.style.cursor = 'not-allowed';
      }
    });
    
    // Keep tabs BEFORE directions enabled
    tabsBeforeDirections.forEach(tabId => {
      const tab = document.getElementById(tabId);
      if (tab) {
        tab.style.pointerEvents = 'auto';
        tab.style.opacity = '1';
        tab.style.cursor = 'pointer';
      }
    });
    
    // Show validation message
    showPrepackValidationMessage(`Please select exactly ${validation.required} time(s) of day for ${getPrepackSelectedFrequency()} frequency.`);
    
    // Disable Next button
    if (nextBtn) {
      nextBtn.style.pointerEvents = 'none';
      nextBtn.style.opacity = '0.5';
      nextBtn.style.cursor = 'not-allowed';
      nextBtn.title = `Select ${validation.required} time(s) of day first`;
    }
  } else {
    // Enable ALL tabs
    ['routesTab', 'doseTab', 'directionsTab', 'qtyTab', 'labelsTab'].forEach(tabId => {
      const tab = document.getElementById(tabId);
      if (tab) {
        tab.style.pointerEvents = 'auto';
        tab.style.opacity = '1';
        tab.style.cursor = 'pointer';
      }
    });
    
    // Enable Next button
    if (nextBtn) {
      nextBtn.style.pointerEvents = 'auto';
      nextBtn.style.opacity = '1';
      nextBtn.style.cursor = 'pointer';
      nextBtn.title = '';
    }
    
    // Hide validation message
    hidePrepackValidationMessage();
  }
}

// Validation Message Functions
function showPrepackValidationMessage(message) {
  let messageDiv = document.getElementById('prepackCheckboxValidationMessage');
  if (!messageDiv) {
    messageDiv = document.createElement('div');
    messageDiv.id = 'prepackCheckboxValidationMessage';
    messageDiv.style.color = '#d32f2f';
    messageDiv.style.backgroundColor = '#ffebee';
    messageDiv.style.padding = '10px';
    messageDiv.style.margin = '10px 8px';
    messageDiv.style.borderRadius = '4px';
    messageDiv.style.border = '1px solid #ef9a9a';
    messageDiv.style.fontSize = '20px';
    
    const directionsDiv = document.getElementById('directionsDiv');
    if (directionsDiv) {
      directionsDiv.insertBefore(messageDiv, directionsDiv.firstChild);
    }
  }
  messageDiv.textContent = message;
  messageDiv.style.display = 'block';
}

function hidePrepackValidationMessage() {
  const messageDiv = document.getElementById('prepackCheckboxValidationMessage');
  if (messageDiv) {
    messageDiv.style.display = 'none';
  }
}

// Event listeners
prepackFreqRadios.forEach(radio => {
  // Remove existing onchange and add new event listener
  const originalOnChange = radio.getAttribute('onchange');
  radio.removeAttribute('onchange');
  
  radio.addEventListener("change", function() {
    prepackCheckboxes.forEach(cb => { 
      cb.checked = false; 
      cb.disabled = false; 
    });
    updateCheckboxState();
    
    // Call original setDirections if it exists
    if (typeof setDirections === 'function') {
      setDirections();
    }
    
    // Call original onchange if it was set
    if (originalOnChange) {
      eval(originalOnChange);
    }
  });
});

prepackCheckboxes.forEach(cb => {
  // Remove existing onchange and add new event listener
  const originalOnChange = cb.getAttribute('onchange');
  cb.removeAttribute('onchange');
  
  cb.addEventListener("change", function() {
    updateCheckboxState();
    
    // Call original setDirections if it exists
    if (typeof setDirections === 'function') {
      setDirections();
    }
    
    // Call original onchange if it was set
    if (originalOnChange) {
      eval(originalOnChange);
    }
  });
});

// Override the handleNextButton function to include validation
const originalHandleNextButton = handleNextButton;
handleNextButton = function() {
  const currentDiv = document.querySelector('.mobi-div:not([style*="display: none"])');
  
  // If we're on the directions tab, validate checkboxes
  if (currentDiv && currentDiv.id === 'directionsDiv') {
    const freq = getPrepackSelectedFrequency();
    const validation = validatePrepackCheckboxSelection();
    
    if (freq && ['OD', 'BD', 'TDS', 'QID'].includes(freq)) {
      if (!validation.isValid) {
        showPrepackValidationMessage(`Please select exactly ${validation.required} time(s) of day for ${freq} frequency before proceeding.`);
        return; // Prevent navigation
      }
    }
  }
  
  // Call original function if validation passes
  originalHandleNextButton();
};

// Override the showDispenseDiv function
const originalShowDispenseDiv = showDispenseDiv;
showDispenseDiv = function(option) {
  const currentDiv = document.querySelector('.mobi-div:not([style*="display: none"])');
  const currentDivId = currentDiv ? currentDiv.id : '';
  
  // If trying to navigate away from directions tab to a tab AFTER directions, check validation
  if (currentDivId === 'directionsDiv') {
    const tabsAfter = ['qtyDiv', 'labelsDiv'];
    
    if (tabsAfter.includes(option)) {
      const freq = getPrepackSelectedFrequency();
      const validation = validatePrepackCheckboxSelection();
      
      if (!validation.isValid && isPrepackCheckboxValidationRequired(freq)) {
        showPrepackValidationMessage(`Please select exactly ${validation.required} time(s) of day for ${freq} frequency before proceeding.`);
        return; // Prevent navigation to tabs after directions
      }
    }
    // Allow navigation to tabs b4 directions (routesDiv, doseDiv) without validation
  }
  
  // Call original function if validation passes or if navigating to tabs before directions
  originalShowDispenseDiv.call(this, option);
  
  // Update navigation after showing new div
  updatePrepackTabNavigation();
};

// Override the nextStep function to include validation
const originalNextStep = nextStep;
nextStep = function() {
  const currentDiv = document.querySelector('.mobi-div:not([style*="display: none"])');
  
  // If we're on the directions tab, validate checkboxes
  if (currentDiv && currentDiv.id === 'directionsDiv') {
    const freq = getPrepackSelectedFrequency();
    const validation = validatePrepackCheckboxSelection();
    
    if (freq && ['OD', 'BD', 'TDS', 'QID'].includes(freq)) {
      if (!validation.isValid) {
        showPrepackValidationMessage(`Please select exactly ${validation.required} time(s) of day for ${freq} frequency before proceeding.`);
        return; // Prevent navigation
      }
    }
  }
  
  // Call original function if validation passes
  originalNextStep();
  
  // Update navigation after moving to next step
  updatePrepackTabNavigation();
};

// setDirections function to include time of day
const originalSetDirections = typeof setDirections === 'function' ? setDirections : function() {};
setDirections = function() {
  // Call original function first
  originalSetDirections();
  
  // Get selected times of day
  const selectedTimes = [];
  prepackCheckboxes.forEach(cb => {
    if (cb.checked) {
      const label = document.querySelector(`label[for="${cb.id}"]`);
      selectedTimes.push(label ? label.textContent.trim() : cb.value);
    }
  });
  
  // Append time of day to directions if any selected
  if (selectedTimes.length > 0) {
    const field = document.getElementById("directionsDisp");
    if (field) {
      const currentText = field.innerHTML;
      
      // Remove any existing time of day text
      const timeRegex = /\(at .*\)$/;
      const newText = currentText.replace(timeRegex, '');
      
      // Add new time of day
      field.innerHTML = newText + (selectedTimes.length > 0 ? ` (at ${selectedTimes.join(', ')})` : '');
    }
  }
  
  // Update checkbox validation state
  updateCheckboxState();
};

// Initialize on page load
document.addEventListener('DOMContentLoaded', function() {
  // Wait a bit for DOM to be fully ready
  setTimeout(() => {
    updateCheckboxState();
    updatePrepackTabNavigation();
  }, 100);
});

// Reset validation
const originalResetDispenseModal = resetDispenseModal;
resetDispenseModal = function() {
  // Call original function first
  originalResetDispenseModal();
  
  // Reset checkbox validation
  prepackCheckboxes.forEach(cb => {
    cb.checked = false;
    cb.disabled = true;
  });
  
  // Reset validation message
  hidePrepackValidationMessage();
  
  // Reset tab navigation
  updatePrepackTabNavigation();
};

// ValidateDisp with checkbox validation
const originalValidateDisp = validateDisp;
validateDisp = function() {
  // Check checkbox validation if on directions tab
  const currentDiv = document.querySelector('.mobi-div:not([style*="display: none"])');
  if (currentDiv && currentDiv.id === 'directionsDiv') {
    const freq = getPrepackSelectedFrequency();
    const validation = validatePrepackCheckboxSelection();
    
    if (freq && ['OD', 'BD', 'TDS', 'QID'].includes(freq)) {
      if (!validation.isValid) {
        showPrepackValidationMessage(`Please select exactly ${validation.required} time(s) of day for ${freq} frequency before proceeding.`);
        return; // Prevent submission
      }
    }
  }
  
  // Call original validation function
  originalValidateDisp();
};

// Current Tab Functionality
function clearCurrentTab() {
  const visibleTab = document.querySelector('.mobi-div:not([style*="display: none"])');
  if (!visibleTab) return;

  const currentTabId = visibleTab.id.replace('Div', 'Tab');
  
  if (visibleTab.id === "doseDiv") {
    document.getElementById("dose").value = "";
    setDirections();
    updateQuantity();
    // Remove completed status for dose tab
    completedTabs.delete('doseTab');
  } else if (visibleTab.id === "qtyDiv") {
    document.getElementById("qty").value = "";
    setQuantity("qty");
    // Remove completed status for duration tab
    completedTabs.delete('qtyTab');
  } else if (visibleTab.id === "labelsDiv") {
    document.getElementById("numPacks").value = "";
    // Remove completed status for labels tab
    completedTabs.delete('labelsTab');
  } else if (visibleTab.id === "directionsDiv") {

  }

  // Revert the tab styling to blue and remove checkmark
  const tab = document.getElementById(currentTabId);
  if (tab) {
    tab.style.backgroundColor = '#2196F3';
    tab.style.color = 'white';
    tab.style.border = '1px outset silver';
    
    // Remove checkmark
    const checkmark = tab.querySelector('.checkmark');
    if (checkmark) {
      checkmark.remove();
    }
  }

  updateClearButtonVisibility(visibleTab.id);
}

// Update Clear Button Visibility
function updateClearButtonVisibility(activeDivId) {
  const clearBtn = document.getElementById("dispClear");
  if (!clearBtn) return;
  const keypadTabs = ["doseDiv", "qtyDiv", "labelsDiv"];
  clearBtn.style.display = keypadTabs.includes(activeDivId) ? "flex" : "none";
}
</script>

<script>
function removePrepackFromList(id) {
  if (!confirm("Are you sure you want to delete this prepack")) return;

  fetch(`/prepack_labels/delete/${id}`, {
    method: "DELETE",
    headers: { "X-CSRF-Token": csrfToken }
  })
  .then(res => res.json())
  .then(data => {
    if (data.success) {
      console.log("Deleted from server");
      const row = document.getElementById(`prepack_row_${id}`);
      if (row) row.remove();
    } else {
      console.error("Delete failed:", data);
      alert("Failed to delete. See console for details.");
    }
  })
  .catch(err => console.error("Error:", err));
}
</script>

<script>
  var barcodeTxt = null;
  const tabOrder = ['routesDiv', 'doseDiv', 'directionsDiv', 'qtyDiv', 'labelsDiv'];
  let currentStep = 0;

  // Track completed tabs
  let completedTabs = new Set();

  // Scanner focus helpers from first setup
  let isModalOpen = false;
  let barcodeTimer = null;

  function focusBarcodeInputImmediate() {
    const barcode = document.getElementById("barcode");
    if (barcode) {
      barcode.focus();
      barcode.select();
    }
  }

  function keepScannerFocused() {
    setTimeout(() => {
      if (!isModalOpen) focusBarcodeInputImmediate();
    }, 100);
  }

  function initializeBarcodeListener() {
    if (!barcodeTxt) barcodeTxt = document.getElementById("barcode");
    if (!barcodeTxt) return;

    // Remove any previous listeners to avoid double-binding
    barcodeTxt.removeEventListener('input', handleBarcodeInput);
    barcodeTxt.removeEventListener('blur', handleBarcodeBlur);

    // Ensure field is focused and empty
    barcodeTxt.value = "";
    barcodeTxt.focus();

    // Use event listener instead of timer-based checking
    barcodeTxt.addEventListener('input', handleBarcodeInput);
    barcodeTxt.addEventListener('blur', handleBarcodeBlur);
  }

  function handleBarcodeInput(event) {
    const inputEl = event.target;

    // debounce to allow the scanner to finish typing
    if (barcodeTimer) clearTimeout(barcodeTimer);
    barcodeTimer = setTimeout(() => {
      const rawValue = event.target.value.trim().toUpperCase().replace(/\-/g, "");
      if (rawValue.length >= 8) {
        processBarcode(rawValue);
      }
    }, 120); // 120ms debounce
  }

  function handleBarcodeBlur() {
    // Refocus after a short delay unless modal is open
    if (!isModalOpen) {
      setTimeout(() => {
        if (!isModalOpen && barcodeTxt) {
          barcodeTxt.focus();
        }
      }, 100);
    }
  }

  function processBarcode(rawValue) {
    if (!barcodeTxt) barcodeTxt = document.getElementById("barcode");
    if (!barcodeTxt) return;

    barcodeTxt.value = rawValue;
    document.getElementById('btl_field').value = rawValue;
    document.getElementById('bottle_id').innerHTML = rawValue;

    // Clear input for next scan and refocus shortly
    setTimeout(() => {
      if (barcodeTxt) {
        barcodeTxt.value = "";
        // Only refocus if modal isn't about to open
        if (!isModalOpen) barcodeTxt.focus();
      }
    }, 50);

    // Fetch the bottle data
    getBottle(rawValue);
  }

  // Main modal display functions
  function showDispenseForm() {
    const f = document.getElementById('dispenseForm2'); 
    const overlay = document.getElementById('modalOverlay');
    if (f) f.style.display = 'block';
    if (overlay) overlay.style.display = 'block';
    currentStep = 0;
    completedTabs.clear();

    // Set modal state
    isModalOpen = true;

    const firstDiv = 'routesDiv';
    showDispenseDiv(firstDiv);
  }

  // Cancel dispense function
  function cancelDispense() {
    const form = document.getElementById('dispenseForm2');
    const overlay = document.getElementById('modalOverlay');
    if (form) form.style.display = 'none';
    if (overlay) overlay.style.display = 'none';
    
    resetDispenseModal(); // This now properly resets everything
    
    // Reset modal state and reinitialize scanner
    isModalOpen = false;
    initializeBarcodeListener();
  }

  // Barcode + AJAX function
  function getBottle(bottleId) {
    isModalOpen = true;

    const xmlhttp = (window.XMLHttpRequest) ? new XMLHttpRequest() : new ActiveXObject("Microsoft.XMLHTTP");
    xmlhttp.onreadystatechange = function(){
      if(xmlhttp.readyState==4){
        if(xmlhttp.status==200){
          const results = xmlhttp.responseText;
          if(!results || results==='undefined'||results==='null'||results==='false'||results==='{}'){
            showFlashError(`Bottle ID ${bottleId} not found in inventory.`);
            isModalOpen = false;
            initializeBarcodeListener();
          } else {
            try {
              const result = JSON.parse(results);
              document.getElementById('item').innerHTML = result['name'];
              document.getElementById('currQty').innerHTML = result['currentQty'];
              document.getElementById('bottle_id').innerHTML = bottleId;
              
              showDispenseForm();
              showDispenseDiv('routesDiv');
            } catch(e){ 
              showFlashError(`Bottle ID ${bottleId} returned invalid data.`);
              isModalOpen = false;
              initializeBarcodeListener();
            }
          }
        } else {
          showFlashError(`Bottle ID ${bottleId} could not be fetched.`);
          isModalOpen = false;
          initializeBarcodeListener();
        }
      }
    };
    xmlhttp.open("GET","/ajax_bottle/"+bottleId,true);
    xmlhttp.send();
  }

  // Helper functions for different flash types
  function showFlashError(message) {
    showFlashMessage(message, 'errors');
  }

  function showFlashSuccess(message) {
    showFlashMessage(message, 'success');
  }

  function showFlashMessage(message, type = 'notice') {
    const flashEl = document.getElementById('flashMessage');
    const modal = document.getElementById('messageLayer');
    const overlay = document.getElementById('shadowLayer');
    if (!flashEl || !modal || !overlay) return;
    flashEl.textContent = message;
    overlay.style.display = 'block';
    modal.style.display = 'block';
  }

  function hideFlashMessage() {
    const modal = document.getElementById('messageLayer');
    const overlay = document.getElementById('shadowLayer');
    if (modal) modal.style.display = 'none';
    if (overlay) overlay.style.display = 'none';
  }

  <% if flash[:notice].present? || flash[:alert].present? || flash[:errors].present? %>
    document.addEventListener('DOMContentLoaded', function() {
      showFlashMessage("<%= j(flash[:notice] || flash[:alert] || flash[:errors]) %>");
    });
  <% end %>

  // SIMPLE: Mark tab as completed (turns it blue)
  function markTabCompleted(tabId) {
    completedTabs.add(tabId);
    const tab = document.getElementById(tabId);
    if (tab) {
      tab.style.backgroundColor = '#2196F3';
      tab.style.color = 'white';
    }
  }

  // Mark tab as completed with green color and checkmark  
  function markTabCompleted(tabId) {
    completedTabs.add(tabId);
    const tab = document.getElementById(tabId);
    if (tab) {
      tab.style.backgroundColor = '#28a745';  // Green
      tab.style.color = 'white';
      
      // Add checkmark icon if not already present
      if (!tab.querySelector('.checkmark')) {
        const checkmark = document.createElement('span');
        checkmark.className = 'checkmark';
        checkmark.innerHTML = ' ✔';  // Using heavier checkmark character
        checkmark.style.fontWeight = 'bold';
        checkmark.style.marginLeft = '8px';
        checkmark.style.fontSize = '1.1em';
        tab.appendChild(checkmark);
      }
    }
  }

  // Check if tab is completed
  function isTabCompleted(tabId) {
    return completedTabs.has(tabId);
  }

  // showDispenseDiv with simple tab styling
  function showDispenseDiv(option) {
    // Hide all divs
    ['routesDiv','doseDiv','directionsDiv','qtyDiv','labelsDiv'].forEach(d => {
      const div = document.getElementById(d);
      if (div) div.style.display = 'none';
    });

    // Show selected div
    const sel = document.getElementById(option);
    if (sel) sel.style.display = '';

    // Update tab styles - current tab gets red border, completed tabs stay green
    ['routesTab','doseTab','directionsTab','qtyTab','labelsTab'].forEach(tabId => {
      const tab = document.getElementById(tabId);
      if (tab) {
        // Reset all tabs to blue except completed ones
        if (!completedTabs.has(tabId)) {
          tab.style.backgroundColor = '#2196F3';  // Blue
          tab.style.color = 'white';
          tab.style.border = '1px outset silver';
        } else {
          // Completed tabs stay green
          tab.style.backgroundColor = '#28a745';  // Green
          tab.style.color = 'white';
          tab.style.border = '1px solid #1e7e34';
        }
      }
    });

    // Current active tab gets red border
    const currentTab = document.getElementById(option.replace('Div','Tab'));
    if (currentTab) {
      currentTab.style.border = '5px solid #de0404';
    }

    // Update step button label
    currentStep = tabOrder.indexOf(option);
    const nextBtn = document.getElementById('nextBtn');
    if (nextBtn) {
      nextBtn.textContent = (option === 'labelsDiv') ? 'Print Labels' : 'Next';
      
      // If showing the final tab (labelsDiv), recalculate and check stock
      if (option === 'labelsDiv') {
        updateQuantity(); // This will recalculate and call checkStockAndUpdateButton()
      } else {
        // Ensure button is enabled for navigation on other tabs
        nextBtn.disabled = false;
        nextBtn.style.backgroundColor = '';
        nextBtn.style.cursor = '';
        nextBtn.removeAttribute("data-stock-insufficient");
      }
    }

    // Update Clear button visibility
    updateClearButtonVisibility(option);
  }

  function nextStep() {
    // Mark current tab as completed before moving to next
    const currentTabId = tabOrder[currentStep].replace('Div', 'Tab');
    markTabCompleted(currentTabId);

    const nextBtn = document.getElementById('nextBtn');
    if (currentStep < tabOrder.length - 1) {
      currentStep++;
      showDispenseDiv(tabOrder[currentStep]);
      if (currentStep === tabOrder.length - 1) nextBtn.textContent = 'Print Labels';
    } else {
      validateDisp();
    }
  }

  function handleNextButton() {
    const nextBtn = document.getElementById('nextBtn');
    if (nextBtn.textContent === 'Print Labels') validateDispWithStockCheck();
    else nextStep();
  }

  function clearCurrentTab() {
    const visibleTab = document.querySelector('.mobi-div:not([style*="display: none"])');
    if (!visibleTab) return;

    const currentTabId = visibleTab.id.replace('Div', 'Tab');
    
    if (visibleTab.id === "doseDiv") {
      document.getElementById("dose").value = "";
      setDirections();
      updateQuantity();
      // Remove completed status for dose tab
      completedTabs.delete('doseTab');
    } else if (visibleTab.id === "qtyDiv") {
      document.getElementById("qty").value = "";
      setQuantity("qty");
      // Remove completed status for duration tab
      completedTabs.delete('qtyTab');
    } else if (visibleTab.id === "labelsDiv") {
      document.getElementById("numPacks").value = "";
      // Remove completed status for labels tab
      completedTabs.delete('labelsTab');
    }

    // Revert the tab styling to blue and remove checkmark
    const tab = document.getElementById(currentTabId);
    if (tab) {
      tab.style.backgroundColor = '#2196F3';  // Back to blue
      tab.style.color = 'white';
      tab.style.border = '1px outset silver';
      
      // Remove checkmark
      const checkmark = tab.querySelector('.checkmark');
      if (checkmark) {
        checkmark.remove();
      }
    }

    updateClearButtonVisibility(visibleTab.id);
  }

  function updateClearButtonVisibility(activeDivId) {
    const clearBtn = document.getElementById("dispClear");
    if (!clearBtn) return;
    const keypadTabs = ["doseDiv", "qtyDiv", "labelsDiv"];
    clearBtn.style.display = keypadTabs.includes(activeDivId) ? "flex" : "none";
  }

  // Global function to check stock and update button state
  function checkStockAndUpdateButton() {
    var button = document.getElementById('nextBtn');
    if (!button) return;
    
    // Only apply stock validation when on the final tab (Print Labels button)
    if (button.textContent === 'Print Labels') {
      // Recalculate the original quantity to check against stock
      var dose = parseFloat(document.getElementById('dose').value) || 0;
      var duration = parseFloat(document.getElementById('qty').value) || 0;
      var frequencyCode = document.forms[0].elements["frequency"].value;
      
      var freq = 1;
      switch(frequencyCode) {
        case 'OD': freq = 1; break;
        case 'BD': freq = 2; break;
        case 'TDS': freq = 3; break;
        case 'QID': freq = 4; break;
        case 'QHR': freq = 24; break;
        case 'Q2HRS': freq = 12; break;
        case 'Q4HRS': freq = 6; break;
        case 'EOD': freq = 0.5; break;
        case 'QN': freq = 1; break;
        case 'QWK': freq = 1/7; break;
      }
      
      var originalQty = dose * freq * duration;
      originalQty = isNaN(originalQty) ? 0 : Math.ceil(originalQty);
      
      // For prepacking, we need to multiply by number of packs
      var numPacks = parseInt(document.getElementById('numPacks').value) || 1;
      var totalQtyNeeded = originalQty * numPacks;
      
      var currentQty = parseInt(document.getElementById('currQty').innerHTML, 10) || 0;
      
      if (totalQtyNeeded > currentQty) {
        button.disabled = true;
        button.style.backgroundColor = '#ccc';
        button.style.cursor = 'not-allowed';
        button.setAttribute("data-stock-insufficient", "true");
      } else {
        button.disabled = false;
        button.style.backgroundColor = '';
        button.style.cursor = '';
        button.removeAttribute("data-stock-insufficient");
      }
    }
  }

  // Mark tabs completed when data is valid
  function updateQuantity() {
    var dose = parseFloat(document.getElementById('dose').value) || 0;
    var duration = parseFloat(document.getElementById('qty').value) || 0;
    var frequencyCode = document.forms[0].elements["frequency"].value;
    var freq = 1;
    switch(frequencyCode) {
      case 'OD': freq=1; break;
      case 'BD': freq=2; break;
      case 'TDS': freq=3; break;
      case 'QID': freq=4; break;
      case 'QHR': freq=24; break;
      case 'Q2HRS': freq=12; break;
      case 'Q4HRS': freq=6; break;
      case 'EOD': freq=0.5; break;
      case 'QN': freq=1; break;
      case 'QWK': freq=1/7; break;
    }

    var qty = dose * freq * duration;
    qty = isNaN(qty) ? 0 : Math.ceil(qty);
    var currentQty = parseInt(document.getElementById('currQty').innerHTML, 10) || 0;

    // For prepacking, check total quantity needed (qty per pack * number of packs)
    var numPacks = parseInt(document.getElementById('numPacks').value) || 1;
    var totalQtyNeeded = qty * numPacks;

    // Show warning and clamp quantity if exceeding available stock
    if (totalQtyNeeded > currentQty) {
      showDispensationWarning(`Cannot prepack more than ${currentQty} units. Requested: ${totalQtyNeeded}`);
      // Clamp to maximum possible per pack
      qty = Math.floor(currentQty / numPacks);
      if (qty < 1) qty = 1; // Minimum 1 unit per pack
    } else {
      hideDispensationWarning();
    }

    document.getElementById("qtyDisp").innerHTML = qty;
    document.getElementById("dispensed_quantity").value = qty;

    // Always check stock and update button state after quantity calculation
    checkStockAndUpdateButton();

    // Mark dose tab as completed when valid dose is entered
    if (dose > 0 && !completedTabs.has('doseTab')) {
      markTabCompleted('doseTab');
    }

    // Mark duration tab as completed when valid duration
    if (duration > 0 && !completedTabs.has('qtyTab')) {
      markTabCompleted('qtyTab');
    }
  }

  // Mark as completed when route is selected
  function setRoute(route) {
    document.getElementById("route_type").innerHTML = route;
    updateQuantity();
    
    // Mark route tab as completed
    if (route && !completedTabs.has('routesTab')) {
      markTabCompleted('routesTab');
    }
  }

  // SetDirections - mark as completed when frequency is selected
  function setDirections() {
    var field = document.getElementById("directionsDisp");
    var frequency = document.forms[0].elements["frequency"].value;
    field.innerHTML = createDirections(
      document.getElementById("route_type").innerHTML,
      document.getElementById('dose').value,
      frequency,
      "labels"
    );
    updateQuantity();
    
    // Mark directions tab as completed when frequency is selected
    if (frequency && !completedTabs.has('directionsTab')) {
      markTabCompleted('directionsTab');
    }
  }

  function validateDispWithStockCheck() {
    var button = document.getElementById('nextBtn');
    
    // Check if button is marked as having insufficient stock
    if (button && button.getAttribute("data-stock-insufficient") === "true") {
      var currentQty = parseInt(document.getElementById('currQty').innerHTML, 10) || 0;
      var numPacks = parseInt(document.getElementById('numPacks').value) || 1;
      var qtyPerPack = parseInt(document.getElementById("qtyDisp").innerHTML, 10) || 0;
      var totalNeeded = qtyPerPack * numPacks;
      showDispensationWarning(`Cannot prepack more than ${currentQty} units. Requested: ${totalNeeded} units.`);
      return false;
    }
    
    // Proceed with normal validation
    return validateDisp();
  }

  // Form submission to handle focus properly
  function validateDisp() {
    if (!checkRadio(document.getElementsByName("administration"))) {
      showDispenseDiv('routesDiv');
      return;
    }

    if (parseFloat(document.getElementById('dose').value) <= 0) {
      showDispenseDiv('doseDiv');
      return;
    }

    if (!checkRadio(document.getElementsByName("frequency"))) {
      showDispenseDiv('directionsDiv');
      return;
    }

    if (parseFloat(document.getElementById('qty').value) <= 0) {
      showDispenseDiv('qtyDiv');
      return;
    }

    const numPacks = document.getElementById('numPacks').value;
    if (!numPacks || parseFloat(numPacks) <= 0) {
      alert("Please enter number of packs to print");
      showDispenseDiv('labelsDiv');
      return;
    }

    // Final stock validation before submission
    var dose = parseFloat(document.getElementById('dose').value) || 0;
    var duration = parseFloat(document.getElementById('qty').value) || 0;
    var frequencyCode = document.forms[0].elements["frequency"].value;
    var freq = 1;
    switch(frequencyCode) {
      case 'OD': freq = 1; break;
      case 'BD': freq = 2; break;
      case 'TDS': freq = 3; break;
      case 'QID': freq = 4; break;
      case 'QHR': freq = 24; break;
      case 'Q2HRS': freq = 12; break;
      case 'Q4HRS': freq = 6; break;
      case 'EOD': freq = 0.5; break;
      case 'QN': freq = 1; break;
      case 'QWK': freq = 1/7; break;
    }
    
    var qtyPerPack = dose * freq * duration;
    qtyPerPack = isNaN(qtyPerPack) ? 0 : Math.ceil(qtyPerPack);
    var totalQtyNeeded = qtyPerPack * parseInt(numPacks);
    var currentQty = parseInt(document.getElementById('currQty').innerHTML, 10) || 0;
    
    if (totalQtyNeeded > currentQty) {
      showDispensationWarning(`Cannot prepack more than ${currentQty} units. Requested: ${totalQtyNeeded} units.`);
      return;
    }

    // Mark labels tab as completed
    if (!completedTabs.has('labelsTab')) {
      markTabCompleted('labelsTab');
    }

    updateQuantity();
    
    // Before submitting, clear modal state so focus returns after submit
    isModalOpen = false;
    document.forms[0].submit();
  }

  function checkRadio(list) {
    for(let i=0;i<list.length;i++) if(list[i].checked) return true;
    return false;
  }

  function showDispensationWarning(msg) {
    const w = document.getElementById("dispensationWarning");
    if (w) { w.innerText = msg; w.style.display = "inline"; }
  }

  function hideDispensationWarning() {
    const w = document.getElementById("dispensationWarning");
    if (w) w.style.display = "none";
  }

  // DOMContentLoaded - use the new event-driven system
  document.addEventListener("DOMContentLoaded", function() {
    // Initialize barcode listener (this replaces old timer loop)
    initializeBarcodeListener();
  });

  // ResetDispenseModal function - UPDATED
  function resetDispenseModal() {
    // Reset all modal fields to initial state
    document.getElementById('dose').value = '';
    document.getElementById('qty').value = '';
    document.getElementById('numPacks').value = '';
    document.getElementById('qtyDisp').innerHTML = '0';
    document.getElementById('dispensed_quantity').value = '0';
    document.getElementById('route_type').innerHTML = '';
    document.getElementById('directionsDisp').innerHTML = '';
    
    // Uncheck radio buttons
    ['administration', 'frequency'].forEach(name => {
        document.getElementsByName(name).forEach(el => el.checked = false);
    });
    
    // Reset completed tabs and tab styling
    completedTabs.clear();
    currentStep = 0;
    
    // Reset ALL tabs to their default styling and remove checkmarks
    ['routesTab','doseTab','directionsTab','qtyTab','labelsTab'].forEach(tabId => {
      const tab = document.getElementById(tabId);
      if (tab) {
        tab.style.backgroundColor = '#2196F3';  // Blue (default)
        tab.style.color = 'white';
        tab.style.border = '1px outset silver';
        
        // Remove checkmark if present
        const checkmark = tab.querySelector('.checkmark');
        if (checkmark) {
          checkmark.remove();
        }
      }
    });
    
    // Reset to first tab
    const firstDiv = 'routesDiv';
    showDispenseDiv(firstDiv);
  }

  // Helper function for keypad
  function append(value, fieldId) {
    const field = document.getElementById(fieldId);
    if (!field) return;
    
    if (value === 'del') {
      field.value = field.value.slice(0, -1);
    } else {
      field.value += value;
    }
    
    // Trigger update for relevant fields
    if (fieldId === 'dose' || fieldId === 'qty') {
      updateQuantity();
    }
    
    // Auto-mark labels tab as completed when valid number is entered
    if (fieldId === 'numPacks' && field.value && parseFloat(field.value) > 0 && !completedTabs.has('labelsTab')) {
      markTabCompleted('labelsTab');
    }
  }

  function setQuantity(fieldId) {
    updateQuantity();
  }

document.addEventListener('DOMContentLoaded', function() {
  // Handle void prepack links
  document.querySelectorAll('.void-prepack-btn').forEach(button => {
    button.addEventListener('click', function(e) {
      e.preventDefault();
      const prepackId = this.dataset.prepackId;
      const prepackName = this.dataset.prepackName;
      const packCount = this.dataset.packCount;
      
      if (confirm(`Are you sure you want to void all ${packCount} packs of ${prepackName}? This action cannot be undone.`)) {
        // If confirmed, make the DELETE request with confirmation
        fetch(`/prepack_labels/${prepackId}?confirm=true`, {
          method: 'DELETE',
          headers: {
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content,
            'Accept': 'application/json',
            'Content-Type': 'application/json'
          }
        })
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            window.location.href = data.redirect_url;
          } else {
            alert('Error: ' + data.error);
          }
        })
        .catch(error => {
          console.error('Error:', error);
          alert('An error occurred while voiding the prepack.');
        });
      }
    });
  });
});
</script>

<script>
// Track which view options are open
let openViewOptionsId = null;
// Store damage modal parameters for reopening
let storedDamageModalParams = null;

function toggleViewOptions(prepackId) {
  const viewIcon = document.getElementById('view_icon_' + prepackId);
  const optionsDiv = document.getElementById('view_options_' + prepackId);
  const container = viewIcon.closest('.view-options-container');
  
  // Close any other open options with animation
  if (openViewOptionsId && openViewOptionsId !== prepackId) {
    closeViewOptions(openViewOptionsId);
  }
  
  // Toggle current options with smooth animation
  if (optionsDiv.classList.contains('show')) {
    closeViewOptions(prepackId);
  } else {
    openViewOptions(prepackId);
  }
}

function openViewOptions(prepackId) {
  const viewIcon = document.getElementById('view_icon_' + prepackId);
  const optionsDiv = document.getElementById('view_options_' + prepackId);
  const container = viewIcon.closest('.view-options-container');
  
  // Add active class to icon and container
  viewIcon.classList.add('active');
  container.classList.add('active');
  
  // Show options with tray animation
  optionsDiv.classList.add('show');
  
  // Animate each icon with stagger
  const optionItems = optionsDiv.querySelectorAll('.option-item img');
  optionItems.forEach((item, index) => {
    // Reset styles
    item.style.opacity = '0';
    item.style.transform = 'scale(0.8) translateX(10px)';
    
    // Animate in with delay
    setTimeout(() => {
      item.style.transition = 'all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1)';
      item.style.opacity = '1';
      item.style.transform = 'scale(1) translateX(0)';
    }, 100 + (index * 80)); // Stagger delay
  });
  
  // Animate captions with delay
  setTimeout(() => {
    const captions = optionsDiv.querySelectorAll('.option-caption');
    captions.forEach((caption, index) => {
      caption.style.opacity = '1';
    });
  }, 300);
  
  openViewOptionsId = prepackId;
  
  // Add click outside listener
  setTimeout(() => {
    document.addEventListener('click', function closeOptions(e) {
      if (!e.target.closest('#view_options_' + prepackId) && 
          e.target.id !== 'view_icon_' + prepackId &&
          !e.target.closest('#view_icon_' + prepackId)) {
        closeViewOptions(prepackId);
        document.removeEventListener('click', closeOptions);
      }
    });
  }, 10);
  
  // Add escape key listener
  document.addEventListener('keydown', function escapeListener(e) {
    if (e.key === 'Escape') {
      closeViewOptions(prepackId);
      document.removeEventListener('keydown', escapeListener);
    }
  });
}

function closeViewOptions(prepackId) {
  const viewIcon = document.getElementById('view_icon_' + prepackId);
  const optionsDiv = document.getElementById('view_options_' + prepackId);
  const container = viewIcon.closest('.view-options-container');
  
  // Remove active classes
  viewIcon.classList.remove('active');
  container.classList.remove('active');
  
  // Hide captions immediately
  const captions = optionsDiv.querySelectorAll('.option-caption');
  captions.forEach(caption => {
    caption.style.opacity = '0';
  });
  
  // Animate out option icons
  const optionItems = optionsDiv.querySelectorAll('.option-item img');
  optionItems.forEach((item, index) => {
    setTimeout(() => {
      item.style.opacity = '0';
      item.style.transform = 'scale(0.8) translateX(10px)';
    }, index * 30); // Stagger delay out
  });
  
  // Hide options after icons have animated out
  setTimeout(() => {
    optionsDiv.classList.remove('show');
    openViewOptionsId = null;
  }, 200);
}

// logDamages function with modal
function logDamages(prepackId, drugName, availablePacks, bottle_quantity, packSize) {
  console.log("logDamages called with:", prepackId, drugName, availablePacks, bottle_quantity);
  
  // Close any open options
  if (openViewOptionsId) {
    closeViewOptions(openViewOptionsId);
  }
  
  // Store parameters for possible reopening
  storedDamageModalParams = {
    prepackId,
    drugName,
    availablePacks,
    bottle_quantity,
    packSize
  };
  
  // Create and show modal
  showDamageModal(prepackId, drugName, availablePacks, packSize, bottle_quantity);
}

