                <!-- Keypad container -->
                <div class="dose-keypad">
                  <% (1..9).each do |n| %>
                  <div class="customButton" onmousedown="append(<%= n %>,'dose');setDirections(); updateQuantity();">
                    <%= n %>
                  </div>
                  <% end %>
                  <div class="customButton" onmousedown="append('0','dose');setDirections(); updateQuantity();">0</div>
                  <div class="customButton" onmousedown="append('.','dose');setDirections(); updateQuantity();">.</div>
                  <div class="customButton" onmousedown="append('del','dose');setDirections(); updateQuantity();">del</div>
                </div>
              </div>
            </div>

            <!-- DIRECTIONS DIV -->
            <div class="mobi-div" id="directionsDiv" style="display: none;">
                <h3 style="font-weight:bold; font-size:1.5em; margin-left: 15px;"><%= t('forms.labels.select_directions')%></h3>
                <div style="height: 55vh; overflow-x: hidden; overflow-y: auto;">
                  <table width="100" style="border-collapse: collapse">
                    <tr>
                      <td>
                        <div class="radioDiv">
                          <input type="radio" name="frequency" class="radio" id="OD" value="OD" onchange="setDirections()" required>
                          <label class="custom" for="OD" style="width: 200px !important;"><%= t('forms.options.once_a_day')%></label>
                        </div>
                      </td>
                      <td>
                        <div class="radioDiv">
                          <input type="radio" name="frequency" class="radio" id="BD" value="BD" onchange="setDirections()" required>
                          <label class="custom" for="BD" style="width: 200px !important;"><%= t('forms.options.two_times_a_day')%></label>
                        </div>
                      </td>
                    </tr>
                    <tr>
                      <td>
                        <div class="radioDiv">
                          <input type="radio" name="frequency" class="radio" id="TDS" value="TDS" onchange="setDirections()" required>
                          <label class="custom" for="TDS" style="width: 200px !important;"><%= t('forms.options.three_times_a_day')%></label>
                        </div>
                      </td>
                      <td>
                        <div class="radioDiv">
                          <input type="radio" name="frequency" class="radio" id="QID" value="QID" onchange="setDirections()" required>
                          <label class="custom" for="QID" style="width: 200px !important;"><%= t('forms.options.four_times_a_day')%></label>
                        </div>
                      </td>
                    </tr>
                    <tr>
                      <td>
                        <div class="radioDiv">
                          <input type="radio" name="frequency" class="radio" id="QHR" value="QHR" onchange="setDirections()" required>
                          <label class="custom" for="QHR" style="width: 200px !important;"><%= t('forms.options.every_hour')%></label>
                        </div>
                      </td>
                      <td>
                        <div class="radioDiv">
                          <input type="radio" name="frequency" class="radio" id="Q2HRS" value="Q2HRS" onchange="setDirections()" required>
                          <label class="custom" for="Q2HRS" style="width: 200px !important;"><%= t('forms.options.every_two_hours')%></label>
                        </div>
                      </td>
                    </tr>
                    <tr>
                      <td>
                        <div class="radioDiv">
                          <input type="radio" name="frequency" class="radio" id="Q4HRS" value="Q4HRS" onchange="setDirections()" required>
                          <label class="custom" for="Q4HRS" style="width: 200px !important;"><%= t('forms.options.every_four_hours')%></label>
                        </div>
                      </td>
                      <td>
                        <div class="radioDiv">
                          <input type="radio" name="frequency" class="radio" id="EOD" value="EOD" onchange="setDirections()" required>
                          <label class="custom" for="EOD" style="width: 200px !important;"><%= t('forms.options.every_other_day')%></label>
                        </div>
                      </td>
                    </tr>
                    <tr>
                      <td>
                        <div class="radioDiv">
                          <input type="radio" name="frequency" class="radio" id="QN" value="QN" onchange="setDirections()" required>
                          <label class="custom" for="QN" style="width: 200px !important;"><%= t('forms.options.every_night')%></label>
                        </div>
                      </td>
                      <td>
                        <div class="radioDiv">
                          <input type="radio" name="frequency" class="radio" id="QWK" value="QWK" onchange="setDirections()" required>
                          <label class="custom" for="QWK" style="width: 200px !important;"><%= t('forms.options.once_a_week')%></label>
                        </div>
                      </td>
                    </tr>
                  </table>
                </div>
            </div>

            <!--- DURATION DIV ---->  
            <div class="mobi-div" id="qtyDiv" style="display: none;">
                <div style="margin-top: 5px; margin-left: 15px;">
                  <label for="qty"><span style="font-weight: bold;font-size: 1.5em;"><%= t('forms.labels.enter_number_of_days')%></span></label> <br/>
                  <input type="text" id="qty" name="duration" required style="width:200px; height: 15px;max-width:50%; padding:5px 8px; font-size:1.2em;">
                </div>
                <!-- Duration keypad -->
                <div class="duration-keypad">
                  <div class="customButton" onmousedown="append(1,'qty');setQuantity('qty')">1</div>
                  <div class="customButton" onmousedown="append(2,'qty');setQuantity('qty')">2</div>
                  <div class="customButton" onmousedown="append(3,'qty');setQuantity('qty')">3</div>

                  <div class="customButton" onmousedown="append(4,'qty');setQuantity('qty')">4</div>
                  <div class="customButton" onmousedown="append(5,'qty');setQuantity('qty')">5</div>
                  <div class="customButton" onmousedown="append(6,'qty');setQuantity('qty')">6</div>

                  <div class="customButton" onmousedown="append(7,'qty');setQuantity('qty')">7</div>
                  <div class="customButton" onmousedown="append(8,'qty');setQuantity('qty')">8</div>
                  <div class="customButton" onmousedown="append(9,'qty');setQuantity('qty')">9</div>

                  <div class="customButton" onmousedown="append(0,'qty');setQuantity('qty')">0</div>
                  <div class="customButton" onmousedown="append('.','qty');setQuantity('qty')">.</div>
                  <div class="customButton" onmousedown="append('del','qty');setQuantity('qty')">del</div>
                </div>
            </div>

            <!-- DOSE TYPE DIV - MOVED INSIDE THE CONTENT CELL -->
            <div class="mobi-div" id="labelsDiv" style="display:none;">
              <div class="section-wrapper">
                <label for="numPacks" id="numPacksLabel"><span style="font-weight:bold; font-size:1.5em;">Enter number of packs</span></label>
                <input type="text" id="numPacks" name="numPacks" required style="width:200px; max-width:50%; height: 15px; padding:5px 8px; font-size:1.2em;">

                <!-- Keypad container (reuse same style as Dose/Duration) -->
                <div class="duration-keypad" style="margin-top:10px; margin-left:15px;">
                  <div class="customButton" onmousedown="append(1,'numPacks')">1</div>
                  <div class="customButton" onmousedown="append(2,'numPacks')">2</div>
                  <div class="customButton" onmousedown="append(3,'numPacks')">3</div>

                  <div class="customButton" onmousedown="append(4,'numPacks')">4</div>
                  <div class="customButton" onmousedown="append(5,'numPacks')">5</div>
                  <div class="customButton" onmousedown="append(6,'numPacks')">6</div>

                  <div class="customButton" onmousedown="append(7,'numPacks')">7</div>
                  <div class="customButton" onmousedown="append(8,'numPacks')">8</div>
                  <div class="customButton" onmousedown="append(9,'numPacks')">9</div>

                  <div class="customButton" onmousedown="append(0,'numPacks')">0</div>
                  <div class="customButton" onmousedown="append('.','numPacks')">.</div>
                  <div class="customButton" onmousedown="append('del','numPacks')">del</div>
                </div>
