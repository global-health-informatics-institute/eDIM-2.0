  // Fetch available label indexes and update quick select buttons
  function fetchAvailableLabelIndexes(bottleId) {
    if (!bottleId) return;
    
    fetch('/prepack_labels/available_labels?bottle_id=' + encodeURIComponent(bottleId))
      .then(response => response.json())
      .then(data => {
        if (data.error) {
          console.log('Error fetching available labels:', data.error);
          return;
        }
        
        console.log('Available labels:', data.labels);
        console.log('Min index:', data.min_index, 'Max index:', data.max_index, 'Available count:', data.available_count);
        
        // Store min/max for +/- button constraints
        window.availableMinIndex = data.min_index;
        window.availableMaxIndex = data.max_index;
        window.availableCount = data.available_count;
        window.availableIndexes = data.available_indexes || [];
        
        // Set initial pack number to min_index
        const packNoInput = document.getElementById('searchPackNo');
        if (packNoInput && data.min_index > 0) {
          packNoInput.value = data.min_index;
          updateFullLabelDisplay();
        }
        
        // Update the quick select buttons - disable based on available count
        updateQuickSelectButtonsForReprint(data.labels, data.available_count, data.min_index);
        
        // Update +/- button constraints
        updateIncrementDecrementButtons(data.min_index, data.max_index);
      })
      .catch(error => {
        console.error('Error fetching available labels:', error);
      });
  }

  // Update +/- button constraints based on available indexes
  function updateIncrementDecrementButtons(minIndex, maxIndex) {
    const decrementBtn = document.getElementById('decrementPackBtn');
    const incrementBtn = document.getElementById('incrementPackBtn');
    const packNoInput = document.getElementById('searchPackNo');
    
    if (decrementBtn) {
      decrementBtn.onclick = function() {
        var f = document.getElementById('searchPackNo');
        var v = parseInt(f.value) || 0;
        var step = parseInt(packNoStep) || 1;
        v = v - step;
        // Constrain to minimum available index
        if (v < minIndex) v = minIndex;
        f.value = v;
        updateFullLabelDisplay();
      };
    }
    
    if (incrementBtn) {
      incrementBtn.onclick = function() {
        var f = document.getElementById('searchPackNo');
        var v = parseInt(f.value) || 0;
        var step = parseInt(packNoStep) || 1;
        v = v + step;
        // Constrain to maximum available index
        if (v > maxIndex) v = maxIndex;
        f.value = v;
        updateFullLabelDisplay();
      };
    }
    
    // Also constrain manual input
    if (packNoInput) {
      packNoInput.onchange = function() {
        var v = parseInt(packNoInput.value) || minIndex;
        if (v < minIndex) v = minIndex;
        if (v > maxIndex) v = maxIndex;
        packNoInput.value = v;
        updateFullLabelDisplay();
      };
    }
  }
  
