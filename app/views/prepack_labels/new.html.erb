        <div style="display:flex; width:100%;">
          <button type="button" id="stepBtn1" onclick="packNoStep=1; this.style.border='2px solid #006495';this.style.background='#006495';this.style.color='white'; document.getElementById('stepBtn10').style.border='2px solid #dee2e6';document.getElementById('stepBtn10').style.background='#f8f9fa';document.getElementById('stepBtn10').style.color='#495057'; document.getElementById('stepBtn100').style.border='2px solid #dee2e6';document.getElementById('stepBtn100').style.background='#f8f9fa';document.getElementById('stepBtn100').style.color='#495057'; document.getElementById('stepBtn1000').style.border='2px solid #dee2e6';document.getElementById('stepBtn1000').style.background='#f8f9fa';document.getElementById('stepBtn1000').style.color='#495057';"
                  style="width:22%; height:42px; border:2px solid #006495; border-radius:6px; background:#006495; color:white; font-size:0.9rem; font-weight:600; cursor:pointer; user-select:none; margin:2px; text-align:center; display:flex; align-items:center; justify-content:center;">1</button>
