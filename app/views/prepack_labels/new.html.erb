<html xmlns="http://www.w3.org/1999/html">
<head>
<style>
/* --- Administration Route Boxes: 2 Rows --- */
.routes-container {
  display: grid;
  grid-template-columns: repeat(3, minmax(140px, 1fr)); /* 3 columns max */
  grid-template-rows: repeat(2, auto);                  /* 2 rows */
  gap: 1em 2em;                                         /* vertical | horizontal spacing */
  justify-content: start;
  padding-left: 1.5em;
  margin-top: 0.5em;
  width: 100%;
  box-sizing: border-box;
}

.routes-container .radioDiv {
  min-width: 140px;
}

div.radioDiv {
  min-width: 16vw;
}

input.radio:empty {
  margin-left: -999px;
  visibility: hidden;
}

label.custom {
  border-radius: 3px;
  border: 1px solid #D1D3D4;
  font-size: 1.4em !important;
  display: inline-block;
  margin-top: 1em;
  line-height: 3em;
  text-indent: 3.25em;
  position: relative;
  cursor: pointer;
  user-select: none;
}

input.radio:empty ~ label:before {
  position: absolute;
  display: block;
  top: 0;
  bottom: 0;
  left: 0;
  content: '';
  width: 2.5em;
  background: #D1D3D4;
  border-radius: 3px 0 0 3px;
}

input.radio:checked ~ label:before {
  content: '\2714';
  text-indent: .9em;
  color: #000;
  background-color: #CCCCCC;
}

input.radio:checked ~ label {
  color: #000;
  font-weight: bold;
}

/* Wrapper for Route or Dose sections */
/* Adjust gap between label and input */
.section-wrapper {
  display: flex;
  flex-direction: column;
  gap: 5px;         /* smaller space between label and input/grid */
  margin-left: 15px; /* keeps the whole section slightly indented */
}

/* Optionally, align the text labels slightly */
.section-wrapper h3,
.section-wrapper label {
  margin-left: 0;   /* remove extra default margins */
}
  /* Dose input field styling */
.section-wrapper input#dose {
  width: 200px;       /* set a reasonable width */
  max-width: 50%;     /* optional: prevent from growing too wide on big screens */
  padding: 5px 8px;   /* add some padding for nicer text */
  font-size: 1.2em;   /* match the style of other labels */
}

/* --- Dose Keypad  --- */
.dose-keypad {
  display: grid;
  grid-template-columns: repeat(3, 60px);
  grid-auto-rows: 60px;
  gap: 60px 60px;
  justify-content: start;
  margin-top: 10px;
  margin-left: 10px;          /* shift keypad a bit right */
}

.customButton {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #D1D3D4;
  border: 1px solid #999;
  border-radius: 5px;
  font-size: 1.4em;
  font-weight: bold;
  cursor: pointer;
  user-select: none;
  transition: background-color 0.2s, transform 0.1s;
  width: 60px;      /* fixed width */
  height: 60px;     /* fixed height */
}

.customButton:hover {
  background-color: #CCCCCC;
  transform: scale(1.05);
}

.customButton:active {
  background-color: #AAAAAA;
  transform: scale(0.95);
}

/* Directions selection: 2 columns, 5 rows */
.directions-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr); /* flexible two columns */
  grid-template-rows: repeat(5, auto);
  gap: 0.5em 1em;  /* vertical | horizontal */
  justify-content: start;
  padding-left: 1.5em;
}

.directions-grid .radioDiv {
  min-width: auto; /* remove forced width */
}
/* --- Duration tab --- */
.duration-keypad {
  display: grid;
  grid-template-columns: repeat(3, 60px);
  grid-auto-rows: 60px;
  gap: 60px 60px;
  justify-content: start;     /* still left-aligned */
  margin-top: 15px;
  margin-left: 25px; 
}

.duration-keypad .customButton {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60px;
  height: 60px;
  font-size: 1.4em;
  font-weight: bold;
  background-color: #D1D3D4;
  border: 1px solid #999;
  border-radius: 5px;
  cursor: pointer;
  user-select: none;
  transition: background-color 0.2s, transform 0.1s;
}

.duration-keypad .customButton:hover {
  background-color: #CCCCCC;
  transform: scale(1.05);
}

.duration-keypad .customButton:active {
  background-color: #AAAAAA;
  transform: scale(0.95);
}
</style>

</head>
<body style="margin:0; padding:0;">
  <div style="width:99vw; margin:auto;">
    <!-- HEADER -->
    <div style="display: table-row;">
      <div style="width: 83vw; float:left; margin-top:1vh; padding:10px; height:100px;" class="header-cell">
        <div style="display:flex; align-items:center; gap:10px; margin-bottom:8px;">
          <strong style="font-size:1.3em;">Prepack Labels</strong>
          <img src="/assets/barcode.jpg" style="height:32px; vertical-align:middle;">
          <input type="text" id="barcode" class="scanner" style="flex:1; max-width:300px; height:28px;" autofocus>
        </div>

        <table style="width:40%; border-collapse:collapse; font-size:1.1em; margin-bottom:8px;">
          <tr>
            <td style="font-weight:bold; width:100px;">Facility</td>
            <td style="padding-left:10px;"><%= facility_name rescue '—' %></td>
          </tr>
          <tr>
            <td style="font-weight:bold;">Location</td>
            <td style="padding-left:10px;"><%= current_location.name.titleize rescue '—' %></td>
          </tr>
        </table>
      </div>

      <div class="header-cell" style="float:right; width:9vw; text-align:center; margin-top:1vh; margin-left:1vw; padding:10px; font-size:1.1em;">
        <h1>eDIM</h1>
        <%= l(Date.today, format: '%d %b %Y') %>
      </div>
    </div>

    <!-- MAIN CONTENT -->
    <div style="border:3px solid #06425C; margin-top:3vh; height:55vh;">
      <div style="width:100%; background-color:#006495; height:4vh; text-align:center; color:white; padding-top:1vh;">
        <span style="font-size:1.5em; font-family:'Arial Black', Gadget, sans-serif;">Prepacking</span>
      </div>
      <div style="padding:20px; text-align:center;">
        <h2 style="color:#06425C;">Scan bottle to create labels</h2>
        <p style="font-size:1.2em;">Once scanned, you'll be able to print or manage prepack labels.</p>
      </div>
    </div>
  </div>

  <!-- Modal Overlay -->
  <div id="modalOverlay" style="display:none;"></div>
<%= form_for :prescription, method: 'POST', url: dispensation_index_path, html: { id: 'dispenseFormElement' } do |f| %>
  <%= hidden_field_tag :prepacking, true %>

  <!-- DISPENSE FORM MODAL -->
  <div id="dispenseForm2" style="display:none; position:absolute; top:5vh; left:5vw; width:90vw; height:90vh; background-color:#eeeeff; border:3px outset black; overflow:auto; z-index:1000;">
      <table style="width:100%; border-bottom:2px solid black; border-collapse: collapse;">
          <tr>
              <td style="font-weight:bold; width:100px;">Item</td>
              <td id="item">&nbsp;</td>
              <td style="font-weight:bold;">Route</td>
              <td id="route_type">&nbsp;</td>
              <td rowspan="3">
              <img style="float:right; cursor:pointer;" src="/assets/delete.png" onmousedown="cancelDispense()">
              </td>
              <td>
              <span id="dispensationWarning" style="display:none; color:red; font-weight:bold;"></span>
              </td>
          </tr>
          <tr>
              <td style="font-weight:bold;">Bottle ID</td>
              <td id="bottle_id">&nbsp;</td>
              <td style="font-weight:bold;">Directions</td>
              <td id="directionsDisp">&nbsp;</td>
          </tr>
          <tr>
              <td style="font-weight:bold;">Current Qty</td>
              <td id="currQty">&nbsp;</td>
              <td style="font-weight:bold;">Quantity</td>
              <td id="qtyDisp">&nbsp;</td>
          </tr>
      </table>

      <!-- TABS -->
      <div style="display: table; width:100%;">
        <div style="display: table-row;">
          <div style="display: table-cell; width:20%; padding:5px; vertical-align:top;">
            <table style="width:100%; border-spacing:0 10px;">
              <tr><th class="tab" id="routesTab" onmousedown="showDispenseDiv('routesDiv')">Route</th></tr>
              <tr><th class="tab" id="doseTab" onmousedown="showDispenseDiv('doseDiv')">Dose</th></tr>
              <tr><th class="tab" id="directionsTab" onmousedown="showDispenseDiv('directionsDiv')">Directions</th></tr>
              <tr><th class="tab" id="qtyTab" onmousedown="showDispenseDiv('qtyDiv')">Duration</th></tr>
