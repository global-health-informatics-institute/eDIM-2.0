                  style="width:25%; height:42px; border:2px solid #dee2e6; border-radius:6px; background:#f8f9fa; color:#495057; font-size:0.9rem; font-weight:600; cursor:pointer; user-select:none; margin:2px; text-align:center; display:flex; align-items:center; justify-content:center;">10</button>
          <button type="button" id="stepBtn100" onclick="packNoStep=100; this.style.border='2px solid #006495';this.style.background='#006495';this.style.color='white'; document.getElementById('stepBtn1').style.border='2px solid #dee2e6';document.getElementById('stepBtn1').style.background='#f8f9fa';document.getElementById('stepBtn1').style.color='#495057'; document.getElementById('stepBtn10').style.border='2px solid #dee2e6';document.getElementById('stepBtn10').style.background='#f8f9fa';document.getElementById('stepBtn10').style.color='#495057'; document.getElementById('stepBtn1000').style.border='2px solid #dee2e6';document.getElementById('stepBtn1000').style.background='#f8f9fa';document.getElementById('stepBtn1000').style.color='#495057';"
                  style="width:25%; height:42px; border:2px solid #dee2e6; border-radius:6px; background:#f8f9fa; color:#495057; font-size:0.9rem; font-weight:600; cursor:pointer; user-select:none; margin:2px; text-align:center; display:flex; align-items:center; justify-content:center;">100</button>
          <button type="button" id="stepBtn1000" onclick="packNoStep=1000; this.style.border='2px solid #006495';this.style.background='#006495';this.style.color='white'; document.getElementById('stepBtn1').style.border='2px solid #dee2e6';document.getElementById('stepBtn1').style.background='#f8f9fa';document.getElementById('stepBtn1').style.color='#495057'; document.getElementById('stepBtn10').style.border='2px solid #dee2e6';document.getElementById('stepBtn10').style.background='#f8f9fa';document.getElementById('stepBtn10').style.color='#495057'; document.getElementById('stepBtn100').style.border='2px solid #dee2e6';document.getElementById('stepBtn100').style.background='#f8f9fa';document.getElementById('stepBtn100').style.color='#495057';"
                  style="width:25%; height:42px; border:2px solid #dee2e6; border-radius:6px; background:#f8f9fa; color:#495057; font-size:0.9rem; font-weight:600; cursor:pointer; user-select:none; margin:2px; text-align:center; display:flex; align-items:center; justify-content:center;">1000</button>
        </div>
        
        <div style="font-size:0.85rem; color:#6c757d; text-align:center; margin-bottom:8px;">Select step then use +/- buttons</div>
        
        <button type="button" onclick="document.getElementById('searchPackNo').value='0'; updateFullLabelDisplay();"
                style="padding:10px 20px; border:2px solid #6c757d; border-radius:6px; background:#FFDBBB; text-align:center; color:#40464b; font-size:1rem; font-weight:600; cursor:pointer; min-height:40px; display:flex; align-items:center; justify-content:center; box-sizing: border-box;">Clear</button>
      </div>
    </div>
    
    <button id="printSinglePackBtn" type="button" onclick="searchAndPrintLabel();"
            style="padding:14px 24px; font-size:1.2rem; background:#008000; color:white; border:none; border-radius:8px; cursor:pointer; width:100%; position:relative; z-index:1000000; text-align:center; display:flex; align-items:center; justify-content:center; box-sizing: border-box;">
      Print a Pack
    </button>
  </div>
  
  <div id="printAllSection" style="display:none;">
  </div>
  
  <button onclick="closePrinterModal(); setTimeout(function(){ var b=document.getElementById('barcode'); if(b){b.focus(); b.select(); }},100);" 
          style="padding:14px 24px; font-size:1.1rem; background:#FF2C2C; color:white; border:none; border-radius:8px; cursor:pointer; margin-top:15px; width:100%; text-align:center; display:flex; align-items:center; justify-content:center; box-sizing:border-box; flex-shrink:0;">
