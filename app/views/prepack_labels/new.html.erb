// Close confirmation modal and reopen damage modal with preserved values
function closeConfirmationModalAndReopenDamageModal() {
  closeDamageConfirmationModal();
  
  // Reopen damage modal with stored parameters
  setTimeout(() => {
    if (storedDamageModalParams) {
      const {
        prepackId,
        drugName,
        availablePacks,
        bottle_quantity,
        packSize
      } = storedDamageModalParams;
      
      // Reopen with the stored parameters
      showDamageModal(prepackId, drugName, availablePacks, packSize, bottle_quantity);
