<script>
function editPrepackInline(id) {
  fetch('/prepack_labels/' + id + '/edit.json')
    .then(r => r.json())
    .then(d => {
      document.getElementById('item').textContent = d.gn_identifier || 'Paracetamol';
      document.getElementById('bottle_id').textContent = d.gn_identifier || '';
      document.getElementById('currQty').textContent = d.current_num_packs || d.total_quantity || '';
      document.getElementById('directionsDisp').textContent = d.directions || '';
      
      document.getElementById('btl_field').value = d.bottle_id;
      document.getElementById('prepack_id').value = d.id;
      document.getElementById('dose').value = d.quantity_per_pack || '';      // DOSE ✅
      document.getElementById('numPacks').value = d.num_packs || '';          // LABELS ✅
      
      // Times checkboxes ✅
      if (d.times) {
        let times = JSON.parse(d.times.replace(/\\"/g, '"'));
        document.querySelectorAll("input[name='times[]']").forEach(cb => cb.checked = false);
        times.forEach(time => {
          let checkbox = document.querySelector("input[name='times[]'][value='" + time + "']");
          if (checkbox) checkbox.checked = true;
        });
      }
      
      // Frequency from directions ✅
      if (d.directions) {
        let freqMatch = d.directions.match(/(Once|Two|Three|Four|Every|Night|Week)/i);
        if (freqMatch) {
          let freqText = freqMatch[0].toUpperCase();
          let freqCode = '';
          if (freqText.includes('TWO')) freqCode = 'BD';
          else if (freqText.includes('THREE')) freqCode = 'TDS';
          else if (freqText.includes('FOUR')) freqCode = 'QID';
          else if (freqText.includes('ONCE')) freqCode = 'OD';
          else if (freqText.includes('NIGHT')) freqCode = 'QN';
          
          if (freqCode) {
            let freqRadio = document.getElementById(freqCode);
            if (freqRadio) freqRadio.checked = true;
          }
        }
      }
      
      document.getElementById('dispenseForm2').style.display = 'block';
      showDispenseDiv('labelsDiv');
      setDirections(); 
      updateQuantity();
    })
    .catch(e => alert('Could not load prepack data'));
}
  function handleNextButton() {
