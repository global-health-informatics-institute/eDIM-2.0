// Close confirmation modal
function closeDamageConfirmationModal() {
  const confirmationModal = document.getElementById('damageConfirmationModal');
  if (confirmationModal) {
    confirmationModal.style.opacity = '0';
    const modalContent = document.getElementById('damageConfirmationModalContent');
    if (modalContent) {
      modalContent.style.transform = 'scale(0.9)';
    }
    
    setTimeout(() => {
      if (confirmationModal.parentNode) {
        confirmationModal.parentNode.removeChild(confirmationModal);
      }
    }, 300);
  }
}

// Process the actual damage submission after confirmation
function processDamageSubmission(prepackId, quantity, reason, damageType) {
  console.log("Processing damage submission:", prepackId, quantity, reason, damageType);
  
  // Close confirmation modal
  closeDamageConfirmationModal();
  
  // Show "processing" notification
  showProcessingNotification();

  const url = `/general_inventory/${prepackId}/damage_item`;
  
  fetch(url, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      "X-CSRF-Token": document.querySelector("meta[name='csrf-token']").content
    },
    body: JSON.stringify({
      quantity: quantity,
      reason: reason,
      damage_type: damageType,
      prepack_id: prepackId
    })
  })
  .then(res => {
    if (!res.ok) {
      throw new Error(`HTTP error! status: ${res.status}`);
    }
    return res.json();
  })
  .then(data => {
    // Remove processing notification
    removeProcessingNotification();
    
    if (data.success) {
      // Show success message
      showSuccessNotification("Damage Recorded Successfully!");
      
      // Reload after delay
      setTimeout(() => {
        location.reload();
      }, 2500);
    } else {
      alert(data.message || "An error occurred");
    }
  })
  .catch(err => {
    // Remove processing notification
    removeProcessingNotification();
    
    console.error("Error submitting damage:", err);
    alert("An error occurred while submitting the damage.");
  });
}

// Show processing notification
function showProcessingNotification() {
  const processingNotification = document.createElement('div');
  processingNotification.id = 'processing-notification';
  processingNotification.style.cssText = `
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: rgba(0, 0, 0, 0.8);
    color: white;
    padding: 20px 40px;
    border-radius: 10px;
    z-index: 10002;
    font-size: 1.8rem;
    font-weight: 600;
    text-align: center;
    animation: fadeIn 0.3s ease-out;
  `;
  processingNotification.innerHTML = `
    <div style="margin-bottom: 10px; font-size: 2.5rem;">⏳</div>
    Processing...
  `;
  
  document.body.appendChild(processingNotification);
}

// Remove processing notification
function removeProcessingNotification() {
  const processingNotification = document.getElementById('processing-notification');
  if (processingNotification && processingNotification.parentNode) {
    processingNotification.parentNode.removeChild(processingNotification);
  }
}

// Helper function to show success notification without blocking
function showSuccessNotification(message) {
  // Remove any existing notification
  const existingNotification = document.getElementById('success-notification');
  if (existingNotification) {
    existingNotification.parentNode.removeChild(existingNotification);
  }

  // Create a notification div
  const notification = document.createElement('div');
  notification.style.cssText = `
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: #28a745;
    color: white;
    padding: 30px 50px;
    border-radius: 12px;
    box-shadow: 0 8px 30px rgba(0,0,0,0.3);
    z-index: 10003;
    font-size: 2rem;
    font-weight: 700;
    text-align: center;
    min-width: 400px;
    max-width: 600px;
    border: 4px solid rgba(255,255,255,0.3);
    animation: fadeIn 0.3s ease-out;
  `;
  notification.textContent = message;
  notification.id = 'success-notification';
  
  // Add checkmark
  const checkmark = document.createElement('div');
  checkmark.style.cssText = `
    font-size: 3.5rem;
    margin-bottom: 15px;
  `;
  checkmark.textContent = '✓';
  notification.insertBefore(checkmark, notification.firstChild);
  
  // Add to page
  document.body.appendChild(notification);
  
  // Auto-remove after 2.3 seconds (just before page reloads)
  setTimeout(() => {
    if (notification.parentNode) {
      notification.style.opacity = '0';
      notification.style.transform = 'translate(-50%, -50%) scale(0.9)';
      notification.style.transition = 'all 0.3s ease-out';
      
      setTimeout(() => {
        if (notification.parentNode) {
          notification.parentNode.removeChild(notification);
        }
      }, 300);
    }
  }, 2300);
}

// SUBMIT Functions and Validations

function submitDamageWithValidation(prepackId, drugName, maxQuantity, packSize, bottle_quantity) {
  const quantityInput = document.getElementById('damageQuantity');
  const reasonSelect = document.getElementById('damageReason');

  let quantity = parseInt(quantityInput.value, 10);

  if (isNaN(quantity) || quantity < 0) {
    alert('Please enter a valid quantity (0 or greater)');
    return;
  }

  if (quantity === 0) {
    if (!confirm("You're reporting 0 damages. Are you sure?")) return;
  }

  // Determine damage type
  const selectedDamageRadio = [...document.getElementsByName('damageType')].find(r => r.checked);
  const damageType = (selectedDamageRadio && selectedDamageRadio.value) || 'pack';

  const maxQty = damageType === 'pack' ? maxQuantity : bottle_quantity;
  if (quantity > maxQty) {
    alert(`Quantity cannot exceed available: ${maxQty}`);
    return;
  }

  const finalQuantity = quantity;

  showDamageConfirmationModal(
    finalQuantity,
    drugName,
    reasonSelect.value,
    prepackId,
    damageType
  );
}

// function to handle damage type selection
function selectDamageType(type, maxPacks, packSize, bottle_quantity) {
  // Update radio button selection
  const packRadio = document.getElementById('damageTypePack');
  const bottleRadio = document.getElementById('damageTypeBottle');
  
  if (type === 'pack') {
    packRadio.checked = true;
    bottleRadio.checked = false;
  } else {
    packRadio.checked = false;
    bottleRadio.checked = true;
  }
  
  // Update visual styling of the labels
  const packLabel = packRadio.parentElement;
  const bottleLabel = bottleRadio.parentElement;
  
  if (type === 'pack') {
    packLabel.style.background = '#e3f2fd';
    packLabel.style.borderColor = '#006495';
    packLabel.style.color = '#006495';
    bottleLabel.style.background = '#f8f9fa';
    bottleLabel.style.borderColor = '#dee2e6';
    bottleLabel.style.color = '#495057';
  } else {
    bottleLabel.style.background = '#e3f2fd';
    bottleLabel.style.borderColor = '#006495';
    bottleLabel.style.color = '#006495';
    packLabel.style.background = '#f8f9fa';
    packLabel.style.borderColor = '#dee2e6';
    packLabel.style.color = '#495057';
  }
  
  // Update the info card content dynamically
  const leftInfoLabel = document.getElementById('leftInfoLabel');
  const leftInfoValue = document.getElementById('leftInfoValue');
  const rightInfoLabel = document.getElementById('rightInfoLabel');
  const rightInfoValue = document.getElementById('rightInfoValue');
  
  if (type === 'pack') {
    leftInfoLabel.textContent = 'Available Packs';
    leftInfoValue.innerHTML = `${maxPacks} packs`;
    leftInfoValue.style.color = '#28a745';
    rightInfoLabel.textContent = 'Pack Size';
    rightInfoValue.innerHTML = `${packSize} units`;
    rightInfoValue.style.color = '#495057';
  } else {
    leftInfoLabel.textContent = 'Bottle Quantity';
    leftInfoValue.innerHTML = `${bottle_quantity} units`;
    leftInfoValue.style.color = '#28a745';
    rightInfoLabel.textContent = 'Available Packs';
    rightInfoValue.innerHTML = `${maxPacks} packs`;
    rightInfoValue.style.color = '#495057';
  }
  
  // Update the quantity label and limits
  updateDamageQuantityLabel(type, maxPacks, packSize, bottle_quantity);
}

// Helper function to update quantity label and max
function updateDamageQuantityLabel(type, maxPacks, packSize, bottle_quantity) {
  const label = document.getElementById('damageQuantityLabel');
  const input = document.getElementById('damageQuantity');

  if (!input) return;

  if (type === 'pack') {
    label.textContent = 'Number of Packs Damaged';
    input.max = maxPacks;  // max packs
  } else {
    label.textContent = 'Number of Drugs Damaged';
    input.max = bottle_quantity; // max drugs in bottle
  }

  // Ensure current value does not exceed new max
  if (parseInt(input.value, 10) > input.max) {
    input.value = input.max;
  }
  updateQuickSelectButtons();
}

// Quick select buttons
function updateQuickSelectButtons() {
  const buttons = document.querySelectorAll('.quick-select-btn');
  const input = document.getElementById('damageQuantity');
  if (!buttons.length || !input) return;

  const selectedDamageTypeEl = document.querySelector('input[name="damageType"]:checked');
  const selectedType = selectedDamageTypeEl ? selectedDamageTypeEl.value : null;

  let maxAllowed = 0;
  if (selectedType === 'pack') {
    maxAllowed = parseInt(input.max, 10);
  } else {
    maxAllowed = parseInt(input.max, 10);
  }

  const currentValue = parseInt(input.value, 10) || 0;

  buttons.forEach(btn => {
    const value = parseInt(btn.dataset.value, 10);

    if (value <= maxAllowed) {
      enableQuickButton(btn);
      
      // Highlight if this button matches current input value
      if (value === currentValue) {
        btn.style.background = '#006495';
        btn.style.borderColor = '#006495';
        btn.style.color = 'white';
        btn.style.boxShadow = '0 4px 12px rgba(0, 100, 149, 0.4)';
        btn.style.transform = 'translateY(-2px)';
      } else {
        btn.style.background = '#f8f9fa';
        btn.style.borderColor = '#dee2e6';
        btn.style.color = '#495057';
        btn.style.boxShadow = 'none';
        btn.style.transform = 'translateY(0)';
      }
    } else {
      disableQuickButton(btn);
    }
  });
}

function disableQuickButton(btn) {
  btn.disabled = true;
  btn.style.opacity = '0.3';
  btn.style.cursor = 'not-allowed';
  btn.style.pointerEvents = 'none';
  btn.style.background = '#e9ecef';
  btn.style.borderColor = '#dee2e6';
  btn.style.color = '#6c757d';
}

function enableQuickButton(btn) {
  btn.disabled = false;
  btn.style.opacity = '1';
  btn.style.cursor = 'pointer';
  btn.style.pointerEvents = 'auto';
}

function setQuickSelectValue(value) {
  const input = document.getElementById('damageQuantity');
  if (!input) return;

  const max = parseInt(input.max, 10) || Infinity;
  const currentValue = parseInt(input.value, 10) || 0;
  
  // If clicking the same button that's currently selected, add to the value
  // Otherwise, set the value directly
  let newValue;
  if (currentValue > 0 && currentValue % value === 0) {
    // Current value is a multiple of the button value, so add to it
    newValue = currentValue + value;
  } else {
    // Set to the button value directly
    newValue = value;
  }
  
  // Respect the maximum limit
  if (newValue <= max) {
    input.value = newValue;
  } else {
    // If adding would exceed max, set to max
    input.value = max;
  }
  
  // Update button highlights
  updateQuickSelectButtons();
}

function setupQuantityControls(maxPacks, bottle_quantity) {
  const input = document.getElementById('damageQuantity');
  const increaseBtn = document.getElementById('increaseBtn');
  const decreaseBtn = document.getElementById('decreaseBtn');
  const clearBtn = document.getElementById('clearBtn');

  if (!input || !increaseBtn || !decreaseBtn || !clearBtn) return;

  // Ensure input starts at 0
  if (parseInt(input.value) !== 0) {
    input.value = 0;
  }

  let holdTimeout = null;
  let repeatTimeout = null;
  let isHolding = false;
  let holdDirection = 0;

  function getCurrentMax() {
    const selectedDamageTypeEl = document.querySelector('input[name="damageType"]:checked');
    const selectedType = selectedDamageTypeEl ? selectedDamageTypeEl.value : null;
    if (selectedType === 'pack') return maxPacks;
    return bottle_quantity; // bottle
  }

  // Adjust quantity
  function adjustQuantity(amount) {
    const input = document.getElementById('damageQuantity');
    if (!input) return;

    let current = parseInt(input.value, 10);
    if (isNaN(current)) current = 0;

    let max = parseInt(input.max, 10);
    if (isNaN(max)) max = Infinity;

    let min = 0; // Changed from 1 to 0

    let newValue = current + amount;

    if (newValue < min) newValue = min;
    if (newValue > max) newValue = max;

    input.value = newValue;
    updateQuickSelectButtons();
  }

  // HOLD ENGINE
  function startPress(direction) {
    holdDirection = direction;
    holdTimeout = setTimeout(() => {
      isHolding = true;
      repeatHold();
    }, 180);
  }

  function repeatHold() {
    if (!isHolding) return;
    adjustQuantity(holdDirection);
    repeatTimeout = setTimeout(repeatHold, 80);
  }

  function endPress() {
    clearTimeout(holdTimeout);
    clearTimeout(repeatTimeout);
    const wasHold = isHolding;
    isHolding = false;
    return wasHold;
  }

  function bindButton(btn, delta) {
    btn.addEventListener('mousedown', () => startPress(delta));
    btn.addEventListener('mouseup', () => {
      const held = endPress();
      if (!held) adjustQuantity(delta);
    });
    btn.addEventListener('mouseleave', endPress);
    btn.addEventListener('touchstart', e => {
      e.preventDefault();
      startPress(delta);
    });
    btn.addEventListener('touchend', () => {
      const held = endPress();
      if (!held) adjustQuantity(delta);
    });
  }

  bindButton(increaseBtn, +1);
  bindButton(decreaseBtn, -1);

  clearBtn.addEventListener('click', () => {
    input.value = 0; // Changed from 1 to 0
    updateQuickSelectButtons();
  });

  // Expose helpers
  window.adjustDamageQuantity = adjustQuantity;
  window.clearDamageQuantity = () => {
    input.value = 0; // Changed from 1 to 0
    updateQuickSelectButtons();
  };
}

function closeDamageModal() {
  const overlay = document.getElementById('damageModalOverlay');
  const modal = document.getElementById('damageModal');
  
  if (overlay) {
    // Animate out
    overlay.style.opacity = '0';
    if (modal) modal.style.transform = 'scale(0.9)';
    
    // Remove after animation
    setTimeout(() => {
      if (overlay && overlay.parentNode) {
        overlay.remove();
      }
      
      // Re-enable scanner when modal closes
      isModalOpen = false;
      const barcodeInput = document.getElementById('barcode');
      if (barcodeInput) {
        barcodeInput.disabled = false;
        // Don't auto-focus immediately to avoid the warning
        setTimeout(() => {
          barcodeInput.focus();
          barcodeInput.select();
        }, 100);
      }
    }, 300);
  }
}


document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    closeDamageModal();
  }
});
