// Helper function to update quantity label and max
function updateDamageQuantityLabel(type, maxPacks, packSize, bottle_quantity) {
  const label = document.getElementById('damageQuantityLabel');
  const input = document.getElementById('damageQuantity');

  if (!input) return;

  if (type === 'pack') {
    label.textContent = 'Number of Packs Damaged';
    input.max = maxPacks;  // max packs
  } else {
    label.textContent = 'Number of Drugs Damaged';
    input.max = bottle_quantity; // max drugs in bottle
  }

  // Ensure current value does not exceed new max
  if (parseInt(input.value, 10) > input.max) {
    input.value = input.max;
  }
  updateQuickSelectButtons();
}

// Quick select buttons
function updateQuickSelectButtons() {
  const buttons = document.querySelectorAll('.quick-select-btn');
  const input = document.getElementById('damageQuantity');
  if (!buttons.length || !input) return;

  const selectedType = document.querySelector('input[name="damageType"]:checked')?.value;

  let maxAllowed = 0;
  if (selectedType === 'pack') {
    maxAllowed = parseInt(input.max, 10);
  } else {
    maxAllowed = parseInt(input.max, 10);
  }

  const currentValue = parseInt(input.value, 10) || 0;

  buttons.forEach(btn => {
    const value = parseInt(btn.dataset.value, 10);

    if (value <= maxAllowed) {
      enableQuickButton(btn);
      
      // Highlight if this button matches current input value
      if (value === currentValue) {
        btn.style.background = '#006495';
        btn.style.borderColor = '#006495';
        btn.style.color = 'white';
        btn.style.boxShadow = '0 4px 12px rgba(0, 100, 149, 0.4)';
        btn.style.transform = 'translateY(-2px)';
      } else {
        btn.style.background = '#f8f9fa';
        btn.style.borderColor = '#dee2e6';
        btn.style.color = '#495057';
        btn.style.boxShadow = 'none';
        btn.style.transform = 'translateY(0)';
      }
    } else {
      disableQuickButton(btn);
    }
  });
}

function disableQuickButton(btn) {
  btn.disabled = true;
  btn.style.opacity = '0.3';
  btn.style.cursor = 'not-allowed';
  btn.style.pointerEvents = 'none';
  btn.style.background = '#e9ecef';
  btn.style.borderColor = '#dee2e6';
  btn.style.color = '#6c757d';
}

function enableQuickButton(btn) {
  btn.disabled = false;
  btn.style.opacity = '1';
  btn.style.cursor = 'pointer';
  btn.style.pointerEvents = 'auto';
}

function setQuickSelectValue(value) {
  const input = document.getElementById('damageQuantity');
  if (!input) return;

  const max = parseInt(input.max, 10) || Infinity;
  const currentValue = parseInt(input.value, 10) || 0;
  
  // If clicking the same button that's currently selected, add to the value
  // Otherwise, set the value directly
  let newValue;
  if (currentValue > 0 && currentValue % value === 0) {
    // Current value is a multiple of the button value, so add to it
    newValue = currentValue + value;
  } else {
    // Set to the button value directly
    newValue = value;
  }
  
  // Respect the maximum limit
  if (newValue <= max) {
    input.value = newValue;
  } else {
    // If adding would exceed max, set to max
    input.value = max;
  }
  
  // Update button highlights
  updateQuickSelectButtons();
}

function setupQuantityControls(maxPacks, bottle_quantity) {
  const input = document.getElementById('damageQuantity');
  const increaseBtn = document.getElementById('increaseBtn');
  const decreaseBtn = document.getElementById('decreaseBtn');
  const clearBtn = document.getElementById('clearBtn');

  if (!input || !increaseBtn || !decreaseBtn || !clearBtn) return;

  // Ensure input starts at 0
  if (parseInt(input.value) !== 0) {
    input.value = 0;
  }

  let holdTimeout = null;
  let repeatTimeout = null;
  let isHolding = false;
  let holdDirection = 0;

  function getCurrentMax() {
    const selectedType = document.querySelector('input[name="damageType"]:checked')?.value;
    if (selectedType === 'pack') return maxPacks;
    return bottle_quantity; // bottle
  }

  // Adjust quantity
  function adjustQuantity(amount) {
    const input = document.getElementById('damageQuantity');
    if (!input) return;

    let current = parseInt(input.value, 10);
    if (isNaN(current)) current = 0;

    let max = parseInt(input.max, 10);
    if (isNaN(max)) max = Infinity;

    let min = 0; // Changed from 1 to 0

    let newValue = current + amount;

    if (newValue < min) newValue = min;
    if (newValue > max) newValue = max;

    input.value = newValue;
    updateQuickSelectButtons();
  }

  // HOLD ENGINE
  function startPress(direction) {
    holdDirection = direction;
    holdTimeout = setTimeout(() => {
      isHolding = true;
      repeatHold();
    }, 180);
  }

  function repeatHold() {
    if (!isHolding) return;
    adjustQuantity(holdDirection);
    repeatTimeout = setTimeout(repeatHold, 80);
  }

  function endPress() {
    clearTimeout(holdTimeout);
    clearTimeout(repeatTimeout);
    const wasHold = isHolding;
    isHolding = false;
    return wasHold;
  }

  function bindButton(btn, delta) {
    btn.addEventListener('mousedown', () => startPress(delta));
    btn.addEventListener('mouseup', () => {
      const held = endPress();
      if (!held) adjustQuantity(delta);
    });
    btn.addEventListener('mouseleave', endPress);
    btn.addEventListener('touchstart', e => {
      e.preventDefault();
      startPress(delta);
    });
    btn.addEventListener('touchend', () => {
      const held = endPress();
      if (!held) adjustQuantity(delta);
    });
  }

  bindButton(increaseBtn, +1);
  bindButton(decreaseBtn, -1);

  clearBtn.addEventListener('click', () => {
    input.value = 0; // Changed from 1 to 0
    updateQuickSelectButtons();
  });

  // Expose helpers
  window.adjustDamageQuantity = adjustQuantity;
  window.clearDamageQuantity = () => {
    input.value = 0; // Changed from 1 to 0
    updateQuickSelectButtons();
  };
}

function closeDamageModal() {
  const overlay = document.getElementById('damageModalOverlay');
  const modal = document.getElementById('damageModal');
  
  if (overlay) {
    // Animate out
    overlay.style.opacity = '0';
    if (modal) modal.style.transform = 'scale(0.9)';
    
    // Remove after animation
    setTimeout(() => {
      if (overlay && overlay.parentNode) {
        overlay.remove();
      }
      
      // Re-enable scanner when modal closes
      isModalOpen = false;
      const barcodeInput = document.getElementById('barcode');
      if (barcodeInput) {
        barcodeInput.disabled = false;
        // Don't auto-focus immediately to avoid the warning
        setTimeout(() => {
          barcodeInput.focus();
          barcodeInput.select();
        }, 100);
      }
    }, 300);
  }
}

// Close modal on escape key
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    closeDamageModal();
  }
});
</script>

