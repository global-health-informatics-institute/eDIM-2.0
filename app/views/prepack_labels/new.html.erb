    }, 1500);
    
    frame.onload = function() {
      if (prepackPrintFallbackTimer) clearTimeout(prepackPrintFallbackTimer);
      hideFlashMessage();
      frame.onload = null;
    };
    
    frame.src = printUrl;
  }

  // Open the printer modal
  function openPrinterModal(prepackId) {
    // Handle case where prepackId might be null, undefined, or empty string
    // Also handle case where it might be the string "null"
    console.log('openPrinterModal called with:', prepackId, typeof prepackId);
    
    if (prepackId == null || prepackId === 'null' || prepackId === '' || prepackId === 'undefined' || prepackId === 'NaN') {
      showFlashMessage('Error: No valid prepack ID', 'error', { transient: true, duration: 5000 });
      console.log('Print error: prepackId =', prepackId);
      return;
    }
    
    // Try to convert to number and back to ensure it's valid
    const prepackNum = Number(prepackId);
    if (isNaN(prepackNum) || prepackNum === 0) {
      showFlashMessage('Error: Invalid prepack ID', 'error', { transient: true, duration: 5000 });
      console.log('Print error: prepackId is not a valid number:', prepackId);
      return;
    }
    
    console.log('Opening printer modal for prepack:', prepackId);
    
    currentPrepackId = prepackId;
    
    // Get prepack data from the DOM
    const prepackRow = document.getElementById('prepack_row_' + prepackId);
    let bottleId = '';
    let packsRemaining = 0;
    
    if (prepackRow) {
      // Try to get gn_identifier from the prepack data
      const gnIdentifier = prepackRow.getAttribute('data-gn-identifier');
      if (gnIdentifier) {
        bottleId = gnIdentifier;
      }
      packsRemaining = parseInt(prepackRow.getAttribute('data-packs-remaining')) || 0;
    }
    
    // If no bottle ID found, try to get from the view options menu
    if (!bottleId) {
      const viewOptions = document.getElementById('view_options_' + prepackId);
      if (viewOptions) {
        // Try to find bottle ID in the view options
        const bottleMatch = viewOptions.textContent.match(/Bottle:\s*(G\d+)/i);
        if (bottleMatch) {
          bottleId = bottleMatch[1];
        }
      }
    }
    
    // Update currentBottleId with the found bottle ID (whether from row or view options)
    currentBottleId = bottleId;
    
    // If only 1 pack remaining, directly print
    if (packsRemaining === 1) {
      currentPacksRemaining = packsRemaining;
      setTimeout(function() {
        printLowestUndispensed();
      }, 100);
      return;
    }
    
    // If 2 packs remaining, show simplified options (direct print buttons)
    if (packsRemaining === 2) {
      currentPacksRemaining = packsRemaining;
      // Show modal with just Print All option
      currentPacksRemaining = packsRemaining;
    } else {
      // More than 2 packs - show full modal
      currentPacksRemaining = packsRemaining;
    }
    
    // Update the modal
    var searchBottleIdEl = document.getElementById('searchBottleId');
    if (searchBottleIdEl) {
      searchBottleIdEl.value = bottleId || '';
    }
    document.getElementById('searchPackNo').value = '0';
    
    // Update the Print All Available radio button with the count from database
    var printAllRadioCount = document.getElementById('printAllRadioCount');
    if (!printAllRadioCount) return;
    
    // Show count immediately from prepack data (while fetching from DB)
    printAllRadioCount.textContent = '(' + packsRemaining + ' labels)';
    console.log('currentBottleId:', currentBottleId, 'packsRemaining:', packsRemaining);
    
    if (currentBottleId) {
      let cleanBottleId = currentBottleId;
      if (cleanBottleId.toUpperCase().startsWith('PK-')) {
        cleanBottleId = cleanBottleId.substring(3);
      }
      let labelIdentifier = 'PK-' + cleanBottleId + '-1';
      console.log('Fetching from:', '/prepack_labels/check_label?label_identifier=' + encodeURIComponent(labelIdentifier));
      
      fetch('/prepack_labels/check_label?label_identifier=' + encodeURIComponent(labelIdentifier))
        .then(response => response.json())
        .then(data => {
          if (data.available_count !== undefined) {
            currentPacksRemaining = data.available_count;
            printAllRadioCount.textContent = '(' + data.available_count + ' labels)';
          }
        })
        .catch(error => {
          console.error('Error fetching available count:', error);
        });
    }
    
    // Update full label display and increment button state
    setTimeout(function() {
      updateFullLabelDisplay();
      updateIncrementButtonState();
    }, 100);
    
   
    switchPrintOption('single');
    
    var barcodeInput = document.getElementById('barcode');
    if (barcodeInput) {
      barcodeInput.blur();
      barcodeInput.value = '';
    }
    
    // Set modal state to prevent barcode scanner from refocusing
    isModalOpen = true;
    
    document.getElementById('printerModal').style.setProperty('display', 'block', 'important');
