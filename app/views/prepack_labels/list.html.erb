<style>
@keyframes fadeInUp {
  from { 
    opacity: 0; 
    transform: translateX(-50%) translateY(10px); 
  }
  to { 
    opacity: 1; 
    transform: translateX(-50%) translateY(0); 
  }
}
/* Adjust DataTables filter and pagination spacing */
.dataTables_wrapper .dataTables_filter {
  padding-bottom: 30px !important;
  margin-bottom: 10px !important;
}

/* Override  any existing styeles */
.user-list-expanded[style] {
  position: absolute !important;
  bottom: 100% !important;
  top: auto !important;
}

/* Ensure DataTable doesn't push content */
.dataTables_wrapper {
  position: relative !important;
  height: 100% !important;
}

/* Override DataTables default styling */
.dataTables_wrapper {
  background: transparent !important;
  padding: 0 !important;
}

.dataTables_wrapper .dataTables_filter input {
  border: 2px solid #d1d5db !important;
  border-radius: 6px !important;
  padding: 8px 12px !important;
  background: white !important;
  margin-bottom: 15px !important;
}

.dataTables_wrapper .dataTables_paginate .paginate_button {
  border: 1px solid #d1d5db !important;
  background: white !important;
  color: #374151 !important;
  border-radius: 4px !important;
  margin: 0 2px !important;
}

.dataTables_wrapper .dataTables_paginate .paginate_button.current {
  background: #006495 !important;
  color: white !important;
  border-color: #006495 !important;
}

.dataTables_wrapper .dataTables_paginate .paginate_button:hover {
  background: #f3f4f6 !important;
  border-color: #9ca3af !important;
}

/* Main container */
.main-report-container {
  background: white;
  border-radius: 12px;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
  margin: 20px;
  overflow: hidden;
  height: 62vh;
}

/* Table row hover effect */
#prepackReport tbody tr:hover {
  background-color: #e8f4fe !important;
  transform: translateY(-1px);
  transition: all 0.2s ease;
  box-shadow: 0 2px 8px rgba(0, 100, 149, 0.1);
}

/* Column-specific hover effects */
#prepackReport tbody tr:hover td:nth-child(1),
#prepackReport tbody tr:hover td:nth-child(7) {
  background-color: #d8ecff !important;
}

#prepackReport tbody tr:hover td:nth-child(2),
#prepackReport tbody tr:hover td:nth-child(4) {
  background-color: #e8e8e8 !important;
}

#prepackReport tbody tr:hover td:nth-child(3) {
  background-color: #d8f5e3 !important;
}

#prepackReport tbody tr:hover td:nth-child(5) {
  background-color: <%= 'dispensed_count > 0' ? '#d8f5e3' : '#fff0d6' %> !important; 
}

#prepackReport tbody tr:hover td:nth-child(6) {
  background-color: <%= 'damages_count > 0' ? '#ffd6d6' : '#e8e8e8' %> !important; 
}

/* Print styles */
@media print {
  .footer, .nav-bttn, .dataTables_wrapper .dataTables_filter,
  .dataTables_wrapper .dataTables_paginate, .dataTables_wrapper .dataTables_info {
    display: none !important;
  }
  
  .table-container {
    overflow: visible !important;
    max-height: none !important;
    border: none !important;
  }
  
  #prepackReport {
    width: 100% !important;
