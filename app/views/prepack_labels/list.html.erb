<%= javascript_include_tag 'jquery.dataTables.min.js' %>
<script type="text/javascript">
  function debounce(fn, wait) {
    let t;
    return function(...args) {
      clearTimeout(t);
      t = setTimeout(() => fn.apply(this, args), wait);
    };
  }

  $(document).ready(function() {
    const table = $('#prepackReport').DataTable({
      "bLengthChange": false,
      "bDestroy": true,
      "pageLength": 7,
      "responsive": true,
      "paging": true,
      "pagingType": "full_numbers",
      "autoWidth": false,
      "language": {
        "search": "Search:",
        "zeroRecords": "No matching records found",
        "info": "Showing _START_ to _END_ of _TOTAL_ entries",
        "infoEmpty": "No records available",
        "infoFiltered": "(filtered from _MAX_ total entries)",
        "oPaginate": {
          "sNext": "Next",
          "sPrevious": "Previous"
        }
      },
      "columnDefs": [
        { "width": "21%", "targets": 0 },  // Drug
        { "width": "11%", "targets": 1 },  // Total Packs 
        { "width": "11%", "targets": 2 },  // Qty per Pack)
        { "width": "14%", "targets": 3 },  // Date Created
        { "width": "11%", "targets": 4 },  // Packs Dispensed
        { "width": "11%", "targets": 5 },  // Packs Remaining
        { "width": "11%", "targets": 6 },  // Damages/Expired
        { "width": "15%", "targets": 7 }   // Dispensed By
      ],
      "order": [[3, 'desc']], // Sort by creation date descending
      "initComplete": function() {
        // Remove any DataTables default styling conflicts
        $('.dataTables_wrapper').css('background', 'transparent');
        
        // Style search box with larger font
        $('.dataTables_wrapper .dataTables_filter label').css({
          'font-size': '1.4rem',
          'font-weight': '600',
          'color': '#06425C',
          'margin-bottom': '10px'
        });
        
        const searchInput = $('.dataTables_wrapper .dataTables_filter input');
        searchInput.css({
          'border': '2px solid #d1d5db',
          'border-radius': '8px',
          'padding': '12px 15px',
          'background': 'white',
          'font-size': '1.3rem',
          'width': '300px',
          'margin-left': '10px'
        });
        
        //Set focus to search input immediately
        searchInput.focus();
        
        // Style pagination buttons
        $('.dataTables_paginate .paginate_button').css({
          'font-size': '1.3rem',
          'padding': '10px 18px',
          'margin': '0 5px',
          'padding-top': '16px',
        });
        
        // Style info text
        $('.dataTables_info').css({
          'font-size': '1.3rem',
          'color': '#06425C',
          'font-weight': '500',
          'padding-left': '4px',
        });
        
        // Search-as-you-type
        searchInput.off('keyup').on('keyup', function() {
          table.search(this.value).draw();
        });
      }
    });

    const adjustTable = debounce(() => {
      table.columns.adjust().responsive.recalc();
    }, 150);

    window.addEventListener('resize', adjustTable);
    window.addEventListener('orientationchange', adjustTable);
    
    const container = document.querySelector('#prepackReport').parentElement;
    const resizeObserver = new ResizeObserver(adjustTable);
    resizeObserver.observe(container);

    setTimeout(() => table.columns.adjust().responsive.recalc(), 50);
    
    // CONSTANT FOCUS MANAGEMENT
    setTimeout(() => {
      $('.dataTables_filter input').focus();
    }, 100);
    
    // Re-focus on search input whenever user clicks anywhere else
    $(document).on('click', function(e) {
      // Don't refocus if user is clicking on the search input itself
      if (!$(e.target).closest('.dataTables_filter input').length) {
        // Small delay to ensure any other click handlers have run
        setTimeout(() => {
          $('.dataTables_filter input').focus();
        }, 50);
      }
    });
    
    // Re-focus when user clicks within the table area
    $('#prepackReport').on('click', function(e) {
      if (!$(e.target).closest('.dataTables_filter input').length) {
        setTimeout(() => {
          $('.dataTables_filter input').focus();
        }, 100);
      }
    });
    
    // Refocus when user presses tab key
    $(document).on('keydown', function(e) {
      if (e.key === 'Tab') {
        setTimeout(() => {
          $('.dataTables_filter input').focus();
        }, 10);
      }
    });
    
    // Keep focus on search input even after DataTable redraws
    table.on('draw', function() {
      setTimeout(() => {
        $('.dataTables_filter input').focus();
      }, 50);
    });
    
    // Use an interval to constantly check and maintain focus
    const maintainFocusInterval = setInterval(() => {
      const activeElement = document.activeElement;
      const searchInputElement = $('.dataTables_filter input')[0];
      
      // If search input is not focused and user isn't typing in another input
      if (activeElement !== searchInputElement && 
          activeElement.tagName !== 'INPUT' && 
          activeElement.tagName !== 'TEXTAREA') {
        searchInputElement.focus();
        // Place cursor at the end of any existing text
        const length = searchInputElement.value.length;
        searchInputElement.setSelectionRange(length, length);
      }
    }, 500); // Check every 500ms
    
    // Clean up interval when page unloads
    $(window).on('beforeunload', function() {
      clearInterval(maintainFocusInterval);
    });
    
    // Select all text when search input gets focus (for easy clearing)
    $('.dataTables_filter input').on('focus', function() {
      // Don't select all if there's already text user might want to edit
      if (this.value.length > 0) {
        // Just place cursor at the end
        const length = this.value.length;
        this.setSelectionRange(length, length);
      }
    });
    
    // Visual indicator when search input has focus
    $('.dataTables_filter input')
      .focus(function() {
        $(this).css({
          'border-color': '#006495',
          'box-shadow': '0 0 0 3px rgba(0, 100, 149, 0.2)',
          'outline': 'none'
        });
      })
      .blur(function() {
        $(this).css({
          'border-color': '#d1d5db',
          'box-shadow': 'none'
        });
      });
  });
</script>

<!-- MAIN CONTAINER -->
<div style="background: white; border-radius: 12px; padding: 20px; margin: 20px; box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);">

  <div style="height: auto; border-bottom: 3px solid #06425C; padding-bottom: 15px; margin-bottom: 20px;">
    <h1 style="color: #06425C; margin: 0 0 15px 0; font-size: 1.8rem;">
      <%= @report_type.titleize %>
    </h1>
    
    <!-- Summary Statistics - UPDATED to include Damaged count -->
    <div style="display: flex; justify-content: space-around; margin: 15px 0; padding: 15px; background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); border-radius: 10px; border: 1px solid #dee2e6;">
      <div style="text-align: center;">
        <div style="font-size: 1.5rem; color: #6c757d; font-weight: 600;">Total Packs</div>
        <div style="font-size: 1.8rem; font-weight: bold; color: #007bff;"><%= @total_packs %></div>
      </div>
      <div style="text-align: center;">
        <div style="font-size: 1.5rem; color: #6c757d; font-weight: 600;">Total Dispensed</div>
        <div style="font-size: 1.8rem; font-weight: bold; color: #28a745;"><%= @total_dispensed %></div>
      </div>
      <div style="text-align: center;">
        <div style="font-size: 1.5rem; color: #6c757d; font-weight: 600;">Total Damaged</div>
        <div style="font-size: 1.8rem; font-weight: bold; color: #dc3545;"><%= @total_damaged %></div>
      </div>
      <div style="text-align: center;">
        <div style="font-size: 1.5rem; color: #6c757d; font-weight: 600;">Total Remaining</div>
        <div style="font-size: 1.8rem; font-weight: bold; color: #ffc107;"><%= @total_remaining %></div>
      </div>
    </div>
  </div>

  <!-- Table Container -->
  <div class="table-container" style="background: white; border: 1px solid #dee2e6; border-radius: 8px; overflow: hidden; height: 100vh;">  <table id="prepackReport" class="display" style="width: 100%; background: white; border-collapse: collapse;">
    <thead>
      <tr>
        <th style="background: linear-gradient(135deg, #006495 0%, #004d73 100%); color: white; padding: 14px 10px; font-weight: 700; border-right: 1px solid rgba(255,255,255,0.2);">Drug</th>
        <th style="background: linear-gradient(135deg, #006495 0%, #004d73 100%); color: white; padding: 14px 10px; font-weight: 700; border-right: 1px solid rgba(255,255,255,0.2);">Total Packs</th>
        <th style="background: linear-gradient(135deg, #006495 0%, #004d73 100%); color: white; padding: 14px 10px; font-weight: 700; border-right: 1px solid rgba(255,255,255,0.2);">Qty per Pack</th>
        <th style="background: linear-gradient(135deg, #006495 0%, #004d73 100%); color: white; padding: 14px 10px; font-weight: 700; border-right: 1px solid rgba(255,255,255,0.2);">Date Created</th>
        <th style="background: linear-gradient(135deg, #006495 0%, #004d73 100%); color: white; padding: 14px 10px; font-weight: 700; border-right: 1px solid rgba(255,255,255,0.2);">Dispensed</th>
        <th style="background: linear-gradient(135deg, #006495 0%, #004d73 100%); color: white; padding: 14px 10px; font-weight: 700;">Dispensed By</th>
        <th style="background: linear-gradient(135deg, #006495 0%, #004d73 100%); color: white; padding: 14px 10px; font-weight: 700; border-right: 1px solid rgba(255,255,255,0.2);">Damages</th>
        <th style="background: linear-gradient(135deg, #006495 0%, #004d73 100%); color: white; padding: 14px 10px; font-weight: 700; border-right: 1px solid rgba(255,255,255,0.2);">Remaining</th>
      </tr>
    </thead>
                                  
    <tbody>
      <% if @prepacks&.any? %>
        <% @prepacks.group_by(&:drug_name).each do |drug_name, prepacks_for_drug| %>
          <% sorted_prepacks = prepacks_for_drug.sort_by(&:created_at) %>
          <% sorted_prepacks.each_with_index do |prepack, index| %>
            <%
              dispensed_labels = prepack.prepack_labels.where(dispensed: true, deleted: false, voided: false).order(updated_at: :desc)
              
              # Get unique users by their actual user ID to prevent duplicates
              dispensed_users = dispensed_labels.map do |dl| 
                user = User.find_by(user_id: dl.dispensed_by)
                user ? { id: user.user_id, name: user.display_name } : nil
              end.compact.uniq { |u| u[:id] }
              
              # Group labels by user to show count of dispenses per user
              user_dispense_counts = dispensed_labels.each_with_object(Hash.new(0)) do |label, hash|
                if label.dispensed_by.present?
                  hash[label.dispensed_by] += 1
                end
              end
              
              # Get unique user objects with their dispense counts
              unique_users_with_counts = dispensed_users.map do |user|
                user_obj = User.find_by(user_id: user[:id])
                if user_obj
                  count = user_dispense_counts[user[:id]] || 0
                  { user: user_obj, dispense_count: count }
                end
              end.compact
              
              damages_count = prepack.instance_variable_get(:@damages_count) || 0
              dispensed_count = dispensed_labels.count
              
              original_packs = prepack.num_packs + damages_count
              remaining_count = prepack.num_packs - dispensed_count - damages_count
              
              row_class = cycle('even', 'odd')
              batch_text = "#{(index + 1).ordinalize} Batch"
            %>

            <tr style="background: <%= row_class == 'even' ? '#ffffff' : '#f8fafc' %>;">
              <td style="padding: 12px 10px; font-size:1.5rem; border-bottom: 1px solid #e5e7eb; background-color: #f0f9ff; border-right: 1px solid #e5e7eb;">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                  <span style="text-align: right;"><%= prepack.drug_name %></span>
                  <span style="text-align: left; font-weight: 600; color: #006495;"><%= batch_text %></span>
                </div>
              </td>

              <td style="padding: 12px 10px; text-align: center; border-bottom: 1px solid #e5e7eb; font-weight: 600; font-size:1.4rem; background-color: #f8fafc; border-right: 1px solid #e5e7eb;">
                <%= prepack.num_packs %>
              </td>

              <td style="padding: 12px 10px; text-align: center; border-bottom: 1px solid #e5e7eb; font-size:1.4rem; background-color: #f0fff4; border-right: 1px solid #e5e7eb;">
                <%= prepack.quantity_per_pack %>
              </td>

              <td style="padding: 12px 10px; text-align: center; border-bottom: 1px solid #e5e7eb; font-size:1.4rem; background-color: #f8fafc; border-right: 1px solid #e5e7eb;">
                <%= l(prepack.created_at, format: "%d/%m/%Y") %>
              </td>

              <td style="padding: 12px 10px; text-align: center; border-bottom: 1px solid #e5e7eb; font-weight: bold; font-size:1.4rem; color: <%= dispensed_count > 0 ? '#28a745' : '#6c757d' %>; background-color: <%= dispensed_count > 0 ? '#f0fff4' : '#fffaf0' %>; border-right: 1px solid #e5e7eb;">
                <%= dispensed_count %>
              </td>
              <td style="padding: 12px 10px; border-bottom: 1px solid #e5e7eb; font-size:1.4rem; background-color: #f0f9ff;">
                <% if unique_users_with_counts.any? %>
                  <% if unique_users_with_counts.size == 1 %>
                    <!-- unique user name -->
                    <div style="text-align: center;">
                      <span class="user-badge" style="display: inline-block; background: #e8f4fc; color: #006495; padding: 4px 12px; border-radius: 12px; font-weight: 500; border: 1px solid #b6e0fe;">
                        <%= unique_users_with_counts.first[:user].display_name %>
                      </span>
                    </div>
                  <% else %>
                    <!-- show expandable list if multiple users -->
                    <div style="text-align: center;">
                      <div class="user-badge-main" style="display: inline-block; color: #006495; padding: 4px 12px; border-radius: 20px; font-weight: 500; border: 1px solid #b6e0fe; cursor: pointer; transition: all 0.3s ease; margin-bottom: 5px;"
                           onclick="toggleUserList(this)">
                        <%= unique_users_with_counts.first[:user].display_name %>
                        <span style="background: #006495; color: white; border-radius: 50%; min-width: 22px; height: 22px; display: inline-flex; align-items: center; justify-content: center; font-size: 1.1rem; margin-left: 5px; padding: 0 4px;">
                          +<%= unique_users_with_counts.size - 1 %>
                        </span>
                        <i class="fas fa-chevron-down" style="margin-left: 8px; font-size: 1.1rem; transition: transform 0.3s ease;"></i>
                      </div>
                      
                      <div class="user-list-expanded" style="position: absolute; bottom: 100%; left: 50%; transform: translateX(-50%); margin-bottom: 8px; display: none;">
                        <div style="background: white; border-radius: 8px; padding: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); border: 1px solid #e5e7eb; min-width: 200px; max-width: 300px;">
                          <div style="color: #006495; font-weight: 600; margin-bottom: 8px; padding-bottom: 5px; border-bottom: 1px solid #e5e7eb; font-size: 1.3rem;">
                            All
                          </div>
                          <% unique_users_with_counts.each_with_index do |user_data, idx| %>
                            <div style="display: flex; justify-content: space-between; align-items: center; padding: 6px 0; <%= idx < unique_users_with_counts.size - 1 ? 'border-bottom: 1px solid #f1f5f9;' : '' %>">
                              <span style="color: #374151;">
                                <%= user_data[:user].display_name %>
                              </span>
                              <span style="background: #e8f4fc; color: #006495; border-radius: 12px; padding: 2px 8px; font-size: 1.2rem; font-weight: 600;">
                                <%= user_data[:dispense_count] %> time<%= user_data[:dispense_count] > 1 ? 's' : '' %>
                              </span>
                            </div>
                          <% end %>
                        </div>
                      </div>
                    </div>
                  <% end %>
                <% else %>
                  <div style="text-align: center;">
                    <span style="color: #9ca3af; font-style: italic;">-</span>
                  </div>
                <% end %>
              </td>

              <td style="padding: 12px 10px; text-align: center;font-size:1.4rem; border-bottom: 1px solid #e5e7eb; color: <%= damages_count > 0 ? '#dc3545' : '#6c757d' %>; background-color: <%= damages_count > 0 ? '#fff5f5' : '#f8fafc' %>; border-right: 1px solid #e5e7eb;">
                <%= damages_count > 0 ? damages_count : '0' %>
              </td>

              <td style="padding: 12px 10px; text-align: center; border-bottom: 1px solid #e5e7eb; font-weight: bold; font-size:1.4rem; color: <%= remaining_count > 0 ? '#006495' : '#dc3545' %>; background-color: #f0f9ff; border-right: 1px solid #e5e7eb;">
                <%= remaining_count %>
              </td>
            </tr>
          <% end %>
        <% end %>
      <% else %>
        <tr>
          <td colspan="8" style="text-align: center; padding: 50px; background: #f8fafc;">
            <div style="color: #6b7280; font-size: 1.5rem; margin-bottom: 10px;">
              <i class="fas fa-inbox" style="font-size: 2rem; margin-bottom: 15px; display: block;"></i>
              No prepack records found for selected period.
            </div>
            <div style="color: #9ca3af; font-size: 1.5rem;">
              Try adjusting your date range filters.
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  .user-badge-main:hover {
    background: linear-gradient(135deg, #d4edff, #b6e0fe) !important;
    transform: translateY(-1px);
    box-shadow: 0 4px 8px rgba(0,100,149,0.1);
  }
</style>
<script>
function toggleUserList(element) {
  const userList = element.parentElement.querySelector('.user-list-expanded');
  const chevron = element.querySelector('.fa-chevron-down');
  
  // Close all other open dropdowns first
  document.querySelectorAll('.user-list-expanded').forEach(dropdown => {
    if (dropdown !== userList && dropdown.style.display === 'block') {
      dropdown.style.display = 'none';
      const otherChevron = dropdown.parentElement.querySelector('.fa-chevron-down');
      if (otherChevron) {
        otherChevron.style.transform = 'rotate(0deg)';
      }
    }
  });
  
  if (userList.style.display === 'none' || userList.style.display === '') {
    userList.style.display = 'block';
    chevron.style.transform = 'rotate(180deg)';
    
    // Position the dropdown correctly
    positionDropdown(element, userList);
  } else {
    userList.style.display = 'none';
    chevron.style.transform = 'rotate(0deg)';
  }
}

function positionDropdown(button, dropdown) {
  // Get positions
  const buttonRect = button.getBoundingClientRect();
  const dropdownRect = dropdown.getBoundingClientRect();
  const viewportHeight = window.innerHeight;
  
  // Reset styles
  dropdown.style.position = 'fixed';
  dropdown.style.zIndex = '9999';
  
  // Calculate space
  const spaceBelow = viewportHeight - buttonRect.bottom;
  const spaceAbove = buttonRect.top;
  const dropdownHeight = dropdownRect.height || 200; // Estimate if not rendered yet
  
  // Check if we should open upwards or downwards
  if (spaceBelow < dropdownHeight + 20 && spaceAbove >= dropdownHeight + 20) {
    // Open upwards
    dropdown.style.top = (buttonRect.top - dropdownHeight - 8) + 'px';
    dropdown.style.bottom = 'auto';
  } else {
    // Open downwards (default)
    dropdown.style.top = (buttonRect.bottom + 8) + 'px';
    dropdown.style.bottom = 'auto';
  }
  
  // Center horizontally
  dropdown.style.left = (buttonRect.left + (buttonRect.width / 2) - (dropdownRect.width / 2)) + 'px';
  dropdown.style.right = 'auto';
  dropdown.style.transform = 'translateX(0)';
}

// Close dropdowns when clicking outside
document.addEventListener('click', function(event) {
  if (!event.target.closest('.user-badge-main')) {
    document.querySelectorAll('.user-list-expanded').forEach(dropdown => {
      dropdown.style.display = 'none';
    });
    document.querySelectorAll('.fa-chevron-down').forEach(chevron => {
      chevron.style.transform = 'rotate(0deg)';
    });
  }
});
</script>

