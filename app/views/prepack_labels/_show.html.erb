<style type="text/css">
  th.tab{
    border: 1px outset silver;
    background-color: #39bf87;
    padding: 15px;
    line-height: 6vh;
    margin-top: 5px;
    margin-bottom: 5px;
    font-size: 1.2em !important;
  }
  div.mobi-div{
    padding-left: 5px;
  }
  td.heading{
    font-size: 1em;
  }
</style>

<div id="dispenseForm" class="questionLayer">
  <div style="margin-top: 5vh;margin-left: 5vw; height: 90vh;width: 90vw;background-color: #eeeeff;border: 3px outset black;">
    <table style="width: 100%; border: 2px solid black; border-width: 0px 0px 2px 0px;">
      <tr>
        <td class='heading'><%= t('menu.terms.item')%></td>
        <th id="item" style="text-align: left;width: 30%;">&nbsp;</th>
        <td class='heading' style="text-align: left;"><%= t('menu.terms.route')%></td>
        <th style="text-align: left;width: 30%;" id="route_type">&nbsp;</th>
        <td style="width:20%; text-align:right; vertical-align:middle;">
          <span id="dispensationWarning" style="display:none; color:red; font-weight:bold; font-size:1em; line-height:1.2em; margin-top:10px; display:block;"></span>
        </td>
        <td style="width: 5%;" rowspan="3">
          <img style="padding-right: 2px;float: right;" src="/assets/delete.png" onmousedown="cancelDispense()">
        </td>
      </tr>
      <tr>
        <td class='heading'><%= t('menu.terms.bottle_id')%></td>
        <th id="bottle_id" style="text-align: left;width: 20%;">&nbsp;</th>
        <td class='heading' style="text-align: left;"><%= t('menu.terms.directions')%></td>
        <th style="text-align: left;" id="directionsDisp">&nbsp;</th>
      </tr>
      <tr>
        <td class='heading'><%= t('menu.terms.current_quantity')%></td>
        <th style="text-align: left;" id="currQty">&nbsp;</th>
        <td class='heading'><%= t('menu.terms.quantity')%></td>
        <th style="text-align: left;" id="qtyDisp">&nbsp;</th>
      </tr>
    </table>

    <div style="display: table;width: 100%;">
      <div style="display: table-row">
        <div style="display: table-cell;width: 20%;padding: 5px;vertical-align: top;">
          <table width="100%" style="border-collapse:separate;border-spacing:0 10px;">
            <tr><th class="tab" id="routesTab" onmousedown="showDispenseDiv('routesDiv')"><%= t('forms.buttons.administration_route')%></th></tr>
            <tr><th class="tab" id="doseTab" onmousedown="showDispenseDiv('doseDiv')"><%= t('forms.buttons.dose')%></th></tr>
            <tr><th class="tab" id="directionsTab" onmousedown="showDispenseDiv('directionsDiv')"><%= t('forms.buttons.directions')%></th></tr>
            <tr><th class="tab" id="qtyTab" onmousedown="showDispenseDiv('qtyDiv')"><%= t('forms.buttons.duration')%></th></tr>
            <tr><th class="tab" id="doseTypeTab" onmousedown="showDispenseDiv('doseTypeDiv')"><%= t('forms.buttons.dose_type')%></th></tr>
          </table>
        </div>

        <div style="display: table-cell;border: 2px solid black;border-width: 0px 0px 0px 2px;height: 70vh; justify-content: flex-end">
          <%= form_for :prescription, method: 'POST', url: dispensation_index_path, html: { id: 'dispenseFormElement' } do |f| %>
            <div style="position: absolute;left: 72vw;top: 80vh;" onmousedown="showDispenseDiv('doseDiv')" class="nextButton" id="dispNext">
              <%= t('forms.buttons.next')%>
            </div>
            <div style="position: absolute; left: 62vw; top: 80vh; background-color: #053a54; color: white; justify-content: flex-end; display:none;" 
                 class="nextButton" id="dispClear" onmousedown="clearCurrentTab()">
              <%= t('forms.buttons.clear') %>
            </div>

            <!-- Tab Divs -->
            <div class="mobi-div" id="routesDiv">
              <h3><%= t('forms.labels.select_administration_route')%></h3>
              <table width="100" style="border-collapse: collapse">
                <tr>
                  <td>
                    <div class="radioDiv">
                      <input type="radio" name="administration" class="radio" value="oral" id="route-oral" onchange="setRoute('<%= t('forms.options.oral')%>');setDirections();" required>
                      <label class="custom" for="route-oral"><%= t('forms.options.oral')%></label>
                    </div>
                  </td>
                  <td>
                    <div class="radioDiv">
                      <input type="radio" name="administration" class="radio" value="topical" id="route-topical" onchange="setRoute('<%= t('forms.options.topical')%>');setDirections();" required>
                      <label class="custom" for="route-topical"><%= t('forms.options.topical')%></label>
                    </div>
                  </td>
                </tr>
                <tr>
                  <td>
                    <div class="radioDiv">
                      <input type="radio" name="administration" class="radio" value="respiratory" id="route-respiratory" onchange="setRoute('<%= t('forms.options.respiratory')%>');setDirections();" required>
                      <label class="custom" for="route-respiratory"><%= t('forms.options.respiratory')%></label>
                    </div>
                  </td>
                  <td>
                    <div class="radioDiv">
                      <input type="radio" name="administration" class="radio" value="injection" id="route-injection" onchange="setRoute('<%= t('forms.options.injection')%>');setDirections();" required>
                      <label class="custom" for="route-injection"><%= t('forms.options.injection')%></label>
                    </div>
                  </td>
                </tr>
                <tr>
                  <td>
                    <div class="radioDiv">
                      <input type="radio" name="administration" class="radio" value="other" id="route-other" onchange="setRoute('<%= t('forms.options.other')%>');setDirections();" required>
                      <label class="custom" for="route-other"><%= t('forms.options.other')%></label>
                    </div>
                  </td>
                  <td>&nbsp;</td>
                </tr>
              </table>
            </div>

            <div class="mobi-div" id="doseDiv" style="display: none;">
              <div style="margin-top: 5px;">
                <label for="dose"><span style="font-weight: bold;font-size: 1.2em;"><%= t('forms.labels.enter_dose')%></span></label> <br/>
                <input type="text" id="dose" name="dose" style="font-size: 1.2em;" required>
              </div>
              <div style="margin-top: 5px;">
                <table width="70%" cellspacing="15">
                  <% (1..9).each_slice(3) do |row| %>
                    <tr>
                      <% row.each do |num| %>
                        <td class="customButton" onmousedown="append(<%= num %>,'dose');setDirections(); updateQuantity();"><span><%= num %></span></td>
                      <% end %>
                    </tr>
                  <% end %>
                  <tr>
                    <td class="customButton" onmousedown="append(0,'dose');setDirections(); updateQuantity();"><span>0</span></td>
                    <td class="customButton" onmousedown="append('.','dose');setDirections(); updateQuantity();"><span>.</span></td>
                    <td class="customButton" onmousedown="append('del','dose');setDirections(); updateQuantity();"><span>del</span></td>
                  </tr>
                </table>
              </div>
            </div>

            <!-- Repeat similar structure for doseTypeDiv, directionsDiv, qtyDiv, extDiv -->

            <input type="hidden" name="bottle_id" id="btl_field"/>
            <input type="hidden" name="quantity" id="dispensed_quantity"/>
          <% end %>
        </div>
      </div>
    </div>

    <div id="noPrescriptionBtn"
         style="position: absolute; left: 55vw; top: 81vh; background-color: #053a54; color: white; padding: 15px 12px; display: flex; align-items: center; justify-content: center; font-size: 1rem;"
         onmousedown="switchToNoPrescription()">
      <%= t('forms.buttons.continue_without_prescriptions') %>
    </div>
</div>

  <script type="text/javascript">
    var timerHand;
    var noPrescriptionMode = false;

    // Function to reset the modal to its initial state
    function resetDispenseModal() {
        // Reset input fields
        document.getElementById('dose').value = '';
        document.getElementById('qty').value = '';
        
        // Clear calculated quantity
        document.getElementById('qtyDisp').innerHTML = '0';
        document.getElementById('dispensed_quantity').value = '0';
        
        // Clear displayed selections
        document.getElementById('route_type').innerHTML = '';
        document.getElementById('directionsDisp').innerHTML = '';
        
        // Uncheck all radio buttons
        ['doseType', 'administration', 'frequency'].forEach(name => {
            document.getElementsByName(name).forEach(el => el.checked = false);
        });
        
        // Reset tab visibility
        ['routesDiv','doseDiv','directionsDiv','qtyDiv','doseTypeDiv'].forEach(t => {
            document.getElementById(t).style.display = 'none';
            document.getElementById(t.replace('Div','Tab')).style.border = '1px outset silver';
        });
        
        // Show first tab
        document.getElementById('routesDiv').style.display = '';
        document.getElementById('routesTab').style.border = '2px solid #de0404';
        
        // Reset buttons
        var button = document.getElementById('dispNext');
        button.setAttribute('onmousedown', "showDispenseDiv('routesDiv')");
        button.innerHTML = '<%= t("forms.buttons.next") %>';
        
        // Hide Clear button & warnings
        document.getElementById('dispClear').style.display = 'none';
        hideDispensationWarning();
        
        // Reset no prescription mode
        noPrescriptionMode = false;
        
        // Show the no prescription button
        document.getElementById('noPrescriptionBtn').style.display = 'flex';
        
        // Reset all tabs to be visible
        ['routesTab','doseTab','directionsTab','qtyTab','doseTypeTab'].forEach(t => {
            document.getElementById(t).style.display = '';
        });
        
        // Reset the dose label
        document.getElementById('doseLabel').innerHTML = '<span style="font-weight: bold;font-size: 1.2em;"><%= t("forms.labels.enter_dose") %></span>';
    }

    function checkBarcode() {
      var barcodeTxt = document.getElementById("barcode");
      var rawValue = barcodeTxt.value.trim().toUpperCase().replace(/\-/, ""); // normalize

      if (rawValue.length >= 8) { // trigger as soon as we have enough characters
        barcodeTxt.value = rawValue;
        document.getElementById("bottle_id").innerHTML = rawValue;
        document.getElementById("btl_field").value = rawValue;

        // Reset the modal before fetching bottle data
        resetDispenseModal();

        // Fetch the bottle immediately
        getBottle(rawValue);

        // Reset input for next scan
        barcodeTxt.value = "";
      } else {
        // Wait a bit and check again
        setTimeout(checkBarcode, 300);
      }
    }
    
    // Start listening when page loads
    document.addEventListener("DOMContentLoaded", function() {
      document.getElementById("barcode").focus();
      checkBarcode();
      
      // Add ID to dose label for easier resetting
      document.querySelector("label[for='dose']").id = "doseLabel";
    });

    function updateQuantity() {
      var dose = parseFloat(document.getElementById('dose').value) || 0;
      var duration = parseFloat(document.getElementById('qty').value) || 0;

      var frequencyCode = document.forms[0].elements["frequency"].value;
      var freq = 1;
      switch(frequencyCode) {
        case 'OD': freq = 1; break;
        case 'BD': freq = 2; break;
        case 'TDS': freq = 3; break;
        case 'QID': freq = 4; break;
        case 'QHR': freq = 24; break;
        case 'Q2HRS': freq = 12; break;
        case 'Q4HRS': freq = 6; break;
        case 'EOD': freq = 0.5; break;
        case 'QN': freq = 1; break;
        case 'QWK': freq = 1/7; break;
      }

      var qty = dose * freq * duration;
      qty = isNaN(qty) ? 0 : Math.ceil(qty);

      var currentQty = parseInt(document.getElementById('currQty').innerHTML, 10) || 0;

      if (qty > currentQty) {
        showDispensationWarning(`Cannot dispense more than ${currentQty} units.`);
        qty = currentQty; // clamp
      } else {
        hideDispensationWarning();
      }

      document.getElementById("qtyDisp").innerHTML = qty;
      document.getElementById("dispensed_quantity").value = qty;
    }

    function cancelDispense() {
        // Hide the modal first
        hideLayer('shadow', 'dispenseForm');
        
        // Reset the modal
        resetDispenseModal();

        // Reset barcode input
        var barcodeTxt = document.getElementById("barcode");
        barcodeTxt.value = "";
        barcodeTxt.focus();

        // Restart barcode listener
        initializeListener();
    }

    function initializeListener() {
      const barcode = document.getElementById("barcode");
      if (!barcode) return;
      barcode.focus();

      if (timerHand) clearTimeout(timerHand);
      timerHand = setTimeout(checkBarcode, 3000);
    }

    setTimeout(initializeListener, 3000);


    function hasPrescription() {
          var route = document.getElementsByName("administration");
          var doseType = document.getElementsByName("doseType");
          var frequency = document.getElementsByName("frequency");
          var dose = parseFloat(document.getElementById('dose').value) || 0;
          var qty = parseFloat(document.getElementById('qty').value) || 0;

          return checkRadio(route) && checkRadio(doseType) && checkRadio(frequency) && dose > 0 && qty > 0;
    }


    function showDispenseDiv(option) {
      
        var tabs = ['routesDiv','doseDiv','directionsDiv','qtyDiv','doseTypeDiv'];
        var currentTab = tabs.indexOf(option);
        var button = document.getElementById('dispNext');
        var clearButton = document.getElementById('dispClear');
        var noPrescriptionBtn = document.getElementById('noPrescriptionBtn');

        // Reset noPrescriptionMode when opening normally
        if (!noPrescriptionMode) {
            noPrescriptionMode = false;
        }

        $(".mobi-div").css("display", "none");
        $(".tab").css("border", "1px outset silver");
        document.getElementById(option).style.display = "";
        document.getElementById(option.replace("Div", "Tab")).style.border = "2px solid #de0404";

        // Show Clear button only on doseDiv or qtyDiv
        if (option === 'doseDiv' || option === 'qtyDiv') {
            clearButton.style.display = "inline-block";
        } else {
            clearButton.style.display = "none";
        }

        // Show NoPrescriptionDisp btn only on route
        if (option === 'routesDiv')  {
            noPrescriptionBtn.style.display = "inline-block";
        } else {
            noPrescriptionBtn.style.display = "none";
        }

        if (noPrescriptionMode) {
            // In no-prescription mode, Next should just finish directly
            button.setAttribute("onmousedown", "validateDisp()");
            button.innerHTML = '<%= t("forms.buttons.finish") %>';
        } else {
            if (option == 'doseTypeDiv') {
                button.setAttribute("onmousedown", "validateDisp()");
                button.innerHTML = '<%= t("forms.buttons.finish") %>';
            } else {
                button.setAttribute("onmousedown", "showDispenseDiv('" + tabs[currentTab + 1] + "')");
                button.innerHTML = '<%= t("forms.buttons.next") %>';
            }
        }
    }

    function setRoute(route) {
      document.getElementById("route_type").innerHTML = route;
      updateQuantity();
    }

    function setDirections(){
      var field = document.getElementById("directionsDisp");
      var frequency = document.forms[0].elements["frequency"].value
      field.innerHTML = createDirections(
          document.getElementById("route_type").innerHTML, 
          document.getElementById('dose').value, 
          frequency,
          "doseType"
      );
      updateQuantity();
    }

    function validateDisp() {

        // submit form immediately when in no-prescription mode
        if (noPrescriptionMode) {
          var qty = parseInt(document.getElementById('dose').value, 10) || 0;
          document.getElementById('dispensed_quantity').value = qty;
          document.getElementById('qtyDisp').innerHTML = qty;
          document.forms[0].submit();
          return;
        }
        checkRoute = document.getElementsByName("administration");
        checkDoseType = document.getElementsByName("doseType");
        checkdirections = document.getElementsByName("frequency");

        if (checkRadio(checkRoute)) {
            if (checkRadio(checkDoseType)) {
                if (parseFloat(document.getElementById('dose').value) > 0) {
                    if (checkRadio(checkdirections)) {
                        if (parseFloat(document.getElementById('qty').value) > 0) {
                            updateQuantity(); // <-- important
                            document.forms[0].submit();
                        } else {
                            showDispenseDiv('qtyDiv');
                        }
                    } else {
                        showDispenseDiv('directionsDiv');
                    }
                } else {
                    showDispenseDiv('doseDiv');
                }
            } else {
                showDispenseDiv('doseTypeDiv');
            }
        } else { 
            showDispenseDiv('routesDiv');
        }
    }

    function checkRadio(list)
    {
      for(i=0; i < list.length; i++){
        if(list[i].checked)
        {
          return true;
        }
      }
      return false;
    }
     
    function showDispensationWarning(message) {
      const warning = document.getElementById("dispensationWarning");
      warning.innerText = message;
      warning.style.display = "inline";
    }

    function hideDispensationWarning() {
      document.getElementById("dispensationWarning").style.display = "none";
    }

    function setQuantity(input) {
      var duration = parseFloat(document.getElementById(input).value) || 0;
      var frequencyCode = document.forms[0].elements["frequency"].value;

      var freq = 1;
      switch(frequencyCode) {
        case 'OD': freq = 1; break;
        case 'BD': freq = 2; break;
        case 'TDS': freq = 3; break;
        case 'QID': freq = 4; break;
        case 'QHR': freq = 24; break;
        case 'Q2HRS': freq = 12; break;
        case 'Q4HRS': freq = 6; break;
        case 'EOD': freq = 0.5; break;
        case 'QN': freq = 1; break;
        case 'QWK': freq = 1/7; break;
      }

      var qty = parseFloat(document.getElementById('dose').value) * freq * duration;
      qty = isNaN(qty) ? 0 : Math.ceil(qty);

      var currentQty = parseInt(document.getElementById('currQty').innerHTML, 10) || 0;

      if (qty > currentQty) {
        showDispensationWarning(`Cannot dispense more than ${currentQty} units.`);
        qty = currentQty;
      } else {
        hideDispensationWarning();
      }

      document.getElementById("qtyDisp").innerHTML = qty;
      document.getElementById("dispensed_quantity").value = qty;
    }

    // Fetch bottle details
    function getBottle(bottleId) {
      var xmlhttp = (window.XMLHttpRequest) ? new XMLHttpRequest() : new ActiveXObject("Microsoft.XMLHTTP");

      xmlhttp.onreadystatechange = function() {
        if (xmlhttp.readyState == 4) {
          if (xmlhttp.status == 200) {
            var results = xmlhttp.responseText;

            if (!results || results === 'undefined' || results === 'null' || results === 'false' || results === '{}') {
              showFlashMessage(`Bottle ID ${bottleId} not found in inventory.`, true);
              initializeListener();
            } else {
              try {
                var result = JSON.parse(results);
                document.getElementById('item').innerHTML = result['name'];
                document.getElementById('currQty').innerHTML = result['currentQty'];

                // Only open modal when valid
                showDispenseForm();
                showDispenseDiv('routesDiv');
              } catch (e) {
                alert(`Bottle ID ${bottleId} returned invalid data.`);
                initializeListener();
              }
            }
          } else {
            alert(`Bottle ID ${bottleId} could not be fetched.`);
            initializeListener();
          }
        }
      };
      xmlhttp.open("GET", "/ajax_bottle/" + bottleId, true);
      xmlhttp.send();
    }

    function switchToNoPrescription() {
      noPrescriptionMode = true;

      // Hide all tabs except Dose
      ['routes','dose','directions','qty','doseType'].forEach(t => {
        const div = document.getElementById(t + 'Div');
        const tab = document.getElementById(t + 'Tab');
        if (div) div.style.display = 'none';
        if (tab) tab.style.display = 'none';
      });

      // Show only Dose tab
      const doseDiv = document.getElementById('doseDiv');
      const doseTab = document.getElementById('doseTab');
      if (doseDiv) doseDiv.style.display = '';
      if (doseTab) {
        doseTab.style.display = '';
        doseTab.style.border = '2px solid #de0404';
      }
      // Update Dose label
      const doseLabel = document.getElementById('doseLabel');
      if (doseLabel) doseLabel.innerHTML = "<b>Enter quantity to Dispense</b>";

      // Show "Dispensed without prescription" immediately
      const directionsDisp = document.getElementById('directionsDisp');
      if (directionsDisp) directionsDisp.innerHTML = "<b>Dispensing without prescription</b>";

      // Force stepper to final step (skip internal steps)
      if (typeof currentStep !== "undefined") {
        currentStep = 999;
      }

      // Replace Next button with Finish button that directly submits
      const button = document.getElementById('dispNext');
      if (button) {
        button.setAttribute('onmousedown', "validateDisp()");
        button.innerHTML = '<%= t("forms.buttons.finish") %>';
      }

      // Hide the no prescription button
      document.getElementById('noPrescriptionBtn').style.display = "none";

      // Number pad buttons only modify dose
      if (doseDiv) {
        const doseButtons = doseDiv.querySelectorAll(".customButton");
        doseButtons.forEach(btn => {
          btn.onmousedown = function() {
            append(btn.querySelector('span').innerText, 'dose');
            if (noPrescriptionMode) {
              const val = parseFloat(document.getElementById('dose').value) || 0;
              document.getElementById('qtyDisp').innerHTML = val;
              document.getElementById('dispensed_quantity').value = val;
              document.getElementById('directionsDisp').innerHTML = "<b>Dispensing without prescription</b>";

              // Show Clear button if value exists
              const dispClear = document.getElementById('dispClear');
              if (dispClear) {
                dispClear.style.display = (document.getElementById('dose').value.length > 0) ? "inline-block" : "none";
              }
            }
          }
        });
      }

      // Update dose field input in real-time
      const doseInput = document.getElementById('dose');
      if (doseInput) {
        doseInput.addEventListener('input', function() {
          if (noPrescriptionMode) {
            const val = parseFloat(this.value) || 0;
            document.getElementById('qtyDisp').innerHTML = val;
            document.getElementById('dispensed_quantity').value = val;
            document.getElementById('directionsDisp').innerHTML = "<b>Dispensed without prescription</b>";

            // Show/hide Clear button dynamically
            const dispClear = document.getElementById('dispClear');
            if (dispClear) {
              dispClear.style.display = (this.value.length > 0) ? "inline-block" : "none";
            }
          }
        });
      }
    }
  
  // Reset fields
  document.addEventListener("DOMContentLoaded", function() {
    const dispClear = document.getElementById("dispClear");
    if (dispClear) {
      dispClear.addEventListener("click", function() {
        if (noPrescriptionMode) {
          // In no-prescription mode, just clear quantity
          document.getElementById("dose").value = "";
          document.getElementById("qtyDisp").innerHTML = "0";
          document.getElementById("dispensed_quantity").value = "0";
          document.getElementById("directionsDisp").innerHTML = "<b>Dispensing without prescription</b>";
        } else {
          // In normal prescription mode, clear everything relevant
          document.getElementById("dose").value = "";
          document.getElementById("qty").value = "";
          document.getElementById("qtyDisp").innerHTML = "0";
          document.getElementById("dispensed_quantity").value = "0";
          document.getElementById("directionsDisp").innerHTML = "";
        }

        // Hide button again
        dispClear.style.display = "none";
      });
    }
  });
  </script>
</html>