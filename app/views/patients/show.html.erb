<html xmlns="http://www.w3.org/1999/html">
  <header>
      <style type="text/css">
        th.tab{
          border: 1px outset silver;
          background-color: #2196F3;
          padding: 15px;
          line-height: 6vh;
          margin-top: 5px;
          margin-bottom: 5px;
          font-size: 1.2em !important;
          color: white;
        }
        div.mobi-div{
          padding-left: 5px;
        }
        td.heading{
          font-size: 1em;
        }
      </style>
  </header>
  <body style="margin: 0px; padding: 0px;">
    <div id="dispenseForm" class="questionLayer" >
      <div style="margin-top: 5vh;margin-left: 5vw; height: 90vh;width: 90vw;background-color: #eeeeff;border: 3px outset black;">
          
          <!-- Warning Message Overlay - Completely Outside Normal Flow -->
          <div style="position: absolute; top: 15px; right: 70px; z-index: 1001; pointer-events: none; max-width: 400px;">
            <span id="dispensationWarning" 
            style="display:none; color:red; font-weight:bold; font-size:1.8em;">
            </span>
          </div>
          
          <table style="width: 100%; border: 2px solid black; border-width: 0px 0px 2px 0px;">
            <tr>
              <td class='heading' style="font-size: 1.8rem; font-weight: bold;"><%= t('menu.terms.item:')%></td>
              <th id="item" style="text-align: left;width: 30%; font-size: 1.6rem; font-weight: normal;">&nbsp;</th>
              <td class='heading' style="text-align: left; font-size: 1.8rem; font-weight: bold;"><%= t('menu.terms.route:')%></td>
              <th style="text-align: left;width: 30%; font-size: 1.6rem; font-weight: normal;" id="route_type">&nbsp;</th>
              <td style="width: 5%;" rowspan="3">
                <img style="padding-right: 2px;float: right;" src="/assets/delete.png" onmousedown="cancelDispense()">
              </td>
            </tr>
            <tr>
              <td class='heading' style="font-size: 1.8rem; font-weight: bold;"><%= t('menu.terms.bottle_id:')%></td>
              <th id="bottle_id" style="text-align: left;width: 20%; font-size: 1.6rem; font-weight: normal; ">&nbsp;</th>
              <td class='heading' style="text-align: left; font-size: 1.8rem; font-weight: bold;"><%= t('menu.terms.directions:')%></td>
              <th style="text-align: left; font-size: 1.6rem; font-weight: normal; word-wrap: break-word; max-width: 300px;" id="directionsDisp">&nbsp;</th>
            </tr>
            <tr>
              <td class='heading' style="font-size: 1.8rem; font-weight: bold;"><%= t('menu.terms.current_quantity:')%></td>
              <th style="text-align: left; font-size: 1.6rem; font-weight: normal;" id="currQty" >&nbsp;</th>
              <td class='heading' style="font-size: 1.8rem; font-weight: bold;"><%= t('menu.terms.quantity:')%></td>
              <th style="text-align: left; font-size: 1.8rem; font-weight: normal;" id="qtyDisp">&nbsp;</th>
            </tr>
          </table>
        <div style="display: table;width: 100%;">
          <div style="display: table-row">
            <div style="display: table-cell;width: 20%;padding: 5px;vertical-align: top;">
                <table width="100%" style="border-collapse:separate;border-spacing:0 10px;">
                  <tr>
                    <th class="tab" id="routesTab" onmousedown="showDispenseDiv('routesDiv')">
                     <span style="font-size: 1.4rem;"><%= t('forms.buttons.administration_route')%></span>
                    </th>
                  </tr>
                  <tr>
                    <th class="tab" id="doseTab" onmousedown="showDispenseDiv('doseDiv')">
                      <span style="font-size: 1.4rem;"><%= t('forms.buttons.dose')%></span>
                    </th>
                  </tr>
                  <tr>
                    <th class="tab" id="directionsTab" onmousedown="showDispenseDiv('directionsDiv')">
                      <span style="font-size: 1.4rem;"><%= t('forms.buttons.directions')%></span>
                    </th>
                  </tr>
                  <tr>
                    <th class="tab" id="qtyTab" onmousedown="showDispenseDiv('qtyDiv')">
                      <span style="font-size: 1.4rem;"><%= t('forms.buttons.duration')%></span>
                    </th>
                  </tr>
                  <tr>
                    <th class="tab" id="doseTypeTab" onmousedown="showDispenseDiv('doseTypeDiv')">
                      <span style="font-size: 1.4rem;"><%= t('forms.buttons.dose_type')%></span>
                    </th>
                  </tr>
                </table>
            </div>
            <div style="display: table-cell;border: 2px solid black;border-width: 0px 0px 0px 2px;height: 70vh; justify-content: flex-end">
              <%= form_for :prescription,method: 'POST',:url => dispensation_index_path, :html => { :id => 'dispenseFormElement' }  do |f| %>
              <div style="position: absolute;left: 75vw;top: 80vh;" onmousedown="showDispenseDiv('doseDiv')" class="nextButton" id="dispNext">
                <%= t('forms.buttons.next')%>
              </div>
              <div style="position: absolute; left: 60vw; top: 80vh; background-color: #053a54; color: white; justify-content: flex-end" 
                  class="nextButton" id="dispClear" 
                  style="display:none;">
                <%= t('forms.buttons.clear') %>
              </div>

              <div class="mobi-div" id="routesDiv" >
                <h3 style="font-size: 1.5rem;"><%= t('forms.labels.select_administration_route')%></h3>
                <table width="100" style="border-collapse: collapse">
                  <tr>
                    <td>
                      <div class="radioDiv">
                        <input type="radio" name="administration" class="radio" value="oral" id="route-oral" onchange="setRoute('<%= t('forms.options.oral')%>');setDirections();" required>
                        <label class="custom" for="route-oral" style="font-size:1.4rem !important; padding: 15px 10px !important;"><%= t('forms.options.oral')%></label>
                      </div>
                    </td>
                    <td>
                      <div class="radioDiv">
                        <input type="radio" name="administration" class="radio" value="topical" id="route-topical" onchange="setRoute('<%= t('forms.options.topical')%>');setDirections();" required>
                        <label class="custom" for="route-topical" style="font-size:1.4rem !important; padding: 15px 10px !important;"><%= t('forms.options.topical')%></label>
                      </div>
                    </td>
                  </tr>
                  <tr>
                    <td>
                      <div class="radioDiv">
                        <input type="radio" name="administration" class="radio" value="respiratory" id="route-respiratory" onchange="setRoute('<%= t('forms.options.respiratory')%>');setDirections();" required>
                        <label class="custom" for="route-respiratory" style="font-size:1.4rem !important; padding: 15px 10px !important;"><%= t('forms.options.respiratory')%></label>
                      </div>
                    </td>
                    <td>
                      <div class="radioDiv">
                        <input type="radio" name="administration" class="radio" value="injection" id="route-injection" onchange="setRoute('<%= t('forms.options.injection')%>');setDirections();" required>
                        <label class="custom" for="route-injection" style="font-size:1.4rem !important; padding: 15px 10px !important;"><%= t('forms.options.injection')%></label>
                      </div>
                    </td>
                  </tr>
                  <tr>
                    <td>
                      <div class="radioDiv">
                        <input type="radio" name="administration" class="radio" value="other" id="route-other" onchange="setRoute('<%= t('forms.options.other')%>');setDirections();" required>
                        <label class="custom" for="route-other" style="font-size:1.4rem !important; padding: 15px 10px !important;"><%= t('forms.options.other')%></label>
                      </div>
                    </td>
                    <td>
                      &nbsp;
                    </td>
                  </tr>
                </table>

              </div>
              <div class="mobi-div" id="doseDiv" style="display: none;">
                <div style="margin-top: 5px;">
                  <label for="dose"><span style="font-weight: bold;font-size: 1.2rem;"><%= t('forms.labels.enter_dose')%></span></label> <br/>
                  <input type="text" id="dose" name="dose" style="font-size: 1.2rem;" required>
                </div>
                <div style="margin-top: 5px;">
                  <table width="80%" cellspacing="15" >
                    <tr>
                      <td class="customButton" onmousedown="append(1,'dose');setDirections(); updateQuantity();"><span>1</span></td>
                      <td class="customButton" onmousedown="append(2,'dose');setDirections(); updateQuantity();"><span>2</span></td>
                      <td class="customButton" onmousedown="append(3,'dose');setDirections(); updateQuantity();"><span>3</span></td>
                    </tr>
                    <tr>
                      <td class="customButton" onmousedown="append(4,'dose');setDirections(); updateQuantity();"><span>4</span></td>
                      <td class="customButton" onmousedown="append(5,'dose');setDirections(); updateQuantity();"><span>5</span></td>
                      <td class="customButton" onmousedown="append(6,'dose');setDirections(); updateQuantity();"><span>6</span></td>
                    </tr>
                    <tr>
                      <td class="customButton" onmousedown="append(7,'dose');setDirections(); updateQuantity();"><span>7</span></td>
                      <td class="customButton" onmousedown="append(8,'dose');setDirections(); updateQuantity();"><span>8</span></td>
                      <td class="customButton" onmousedown="append(9,'dose');setDirections(); updateQuantity();"><span>9</span></td>
                    </tr>
                    <tr>
                      <td class="customButton" onmousedown="append(0,'dose');setDirections(); updateQuantity();"><span>0</span></td>
                      <td class="customButton" onmousedown="append('.','dose');setDirections(); updateQuantity();"><span>.</span></td>
                      <td class="customButton" onmousedown="append('del','dose');setDirections(); updateQuantity();"><span>del</span></td>
                    </tr>
                  </table>
                </div>
              </div>
              <div class="mobi-div" id="doseTypeDiv" style="display: none;">
                <h3 style="font-size: 1.7rem;"><%= t('forms.labels.select_dose_type')%></h3>
                <table width="100" style="border-collapse: collapse">
                  <tr>
                    <td>
                      <div class="radioDiv">
                        <input type="radio" name="doseType" value="PRN" class="radio" id="typePRN" onchange="setDirections();" required>
                        <label class="custom" for="typePRN" style="font-size:1.3rem !important; padding: 15px 10px !important;"><%= t('forms.options.as_needed')%></label>
                      </div>
                    </td>
                  </tr>
                  <tr>
                    <td>
                      <div class="radioDiv">
                        <input type="radio" name="doseType" value="NPRN" class="radio" id="typeNPRN" onchange="setDirections();" required>
                        <label class="custom" for="typeNPRN" style="font-size:1.3rem !important; padding: 15px 10px !important;"><%= t('forms.options.as_prescribed')%></label>
                      </div>
                    </td>
                  </tr>
                </table>
              </div>
              <!-- DIRECTIONS DIV -->
              <div class="mobi-div" id="directionsDiv" style="display: none;">
                  <h3 style="font-weight:bold; font-size:1.8rem; margin-left: 15px;"><%= t('forms.labels.select_directions')%></h3>
                  <div style="height: 58vh; overflow-x: hidden; overflow-y: auto;">
                    <div class="directions-grid">
                      <!-- Row 1 -->
                      <div class="radioDiv">
                        <input type="radio" name="frequency" class="radio" id="OD" value="OD" onchange="setDirections()" required>
                        <label class="custom" for="OD" style="font-size:1.3rem !important; padding: 15px 10px !important;"><%= t('forms.options.once_a_day')%></label>
                      </div>
                      <div class="radioDiv">
                        <input type="radio" name="frequency" class="radio" id="BD" value="BD" onchange="setDirections()" required>
                        <label class="custom" for="BD" style="font-size:1.3rem !important; padding: 15px 10px !important;"><%= t('forms.options.two_times_a_day')%></label>
                      </div>
                      <div class="radioDiv">
                        <input type="radio" name="frequency" class="radio" id="TDS" value="TDS" onchange="setDirections()" required>
                        <label class="custom" for="TDS" style="font-size:1.3rem !important; padding: 15px 10px !important;"><%= t('forms.options.three_times_a_day')%></label>
                      </div>
                      
                      <!-- Row 2 -->
                      <div class="radioDiv">
                        <input type="radio" name="frequency" class="radio" id="QID" value="QID" onchange="setDirections()" required>
                        <label class="custom" for="QID" style="font-size:1.3rem !important; padding: 15px 10px !important;"><%= t('forms.options.four_times_a_day')%></label>
                      </div>
                      <div class="radioDiv">
                        <input type="radio" name="frequency" class="radio" id="QHR" value="QHR" onchange="setDirections()" required>
                        <label class="custom" for="QHR" style="font-size:1.3rem !important; padding: 15px 10px !important;"><%= t('forms.options.every_hour')%></label>
                      </div>
                      <div class="radioDiv">
                        <input type="radio" name="frequency" class="radio" id="Q2HRS" value="Q2HRS" onchange="setDirections()" required>
                        <label class="custom" for="Q2HRS" style="font-size:1.3rem !important; padding: 15px 10px !important;"><%= t('forms.options.every_two_hours')%></label>
                      </div>
                      
                      <!-- Row 3 -->
                      <div class="radioDiv">
                        <input type="radio" name="frequency" class="radio" id="Q4HRS" value="Q4HRS" onchange="setDirections()" required>
                        <label class="custom" for="Q4HRS" style="font-size:1.3rem !important; padding: 15px 10px !important;"><%= t('forms.options.every_four_hours')%></label>
                      </div>
                      <div class="radioDiv">
                        <input type="radio" name="frequency" class="radio" id="EOD" value="EOD" onchange="setDirections()" required>
                        <label class="custom" for="EOD" style="font-size:1.3rem !important; padding: 15px 10px !important;"><%= t('forms.options.every_other_day')%></label>
                      </div>
                      <div class="radioDiv">
                        <input type="radio" name="frequency" class="radio" id="QN" value="QN" onchange="setDirections()" required>
                        <label class="custom" for="QN" style="font-size:1.3rem !important; padding: 15px 10px !important;"><%= t('forms.options.every_night')%></label>
                      </div>
                      
                      <!-- Row 4 - Last row with only one item -->
                      <div class="radioDiv">
                        <input type="radio" name="frequency" class="radio" id="QWK" value="QWK" onchange="setDirections()" required>
                        <label class="custom" for="QWK" style="font-size:1.3rem !important; padding: 15px 10px !important;"><%= t('forms.options.once_a_week')%></label>
                      </div>
                    </div>

                    <!-- Time of Day section -->
                    <div style="margin-top: 25px; padding: 0 1.5em;">
                      <h4 style="margin-top:15px; font-size: 1.6rem; margin-left: 0;">Time of Day</h4>

                      <div class="timeOfDayGrid">
                        <label class="timeBox">
                          <input style="width: 24px; height: 24px;" type="checkbox" name="times[]" value="morning" onchange="setDirections()">
                          <img style="width: 40px; height: 40px;" src="/assets/sunrise.png" alt="Morning">
                          <span style="font-size: 1.3rem">Morning</span>
                        </label>

                        <label class="timeBox">
                          <input style="width: 24px; height: 24px;" type="checkbox" name="times[]" value="afternoon" onchange="setDirections()">
                          <img style="width: 40px; height: 40px;" src="/assets/sun.png" alt="Afternoon">
                          <span style="font-size: 1.3rem">Afternoon</span>
                        </label>

                        <label class="timeBox">
                          <input style="width: 24px; height: 24px;" type="checkbox" name="times[]" value="evening" onchange="setDirections()">
                          <img style="width: 46px; height: 46px;" src="/assets/sunset.png" alt="Evening">
                          <span style="font-size: 1.3rem">Evening</span>
                        </label>

                        <label class="timeBox">
                          <input style="width: 24px; height: 24px;" type="checkbox" name="times[]" value="night" onchange="setDirections()">
                          <img src="/assets/moon.png" alt="Night">
                          <span style="font-size: 1.3rem">Night&nbsp;&nbsp;</span>
                        </label>
                      </div>
                    </div>
                  </div>
              </div>

              <div class="mobi-div" id="qtyDiv" style="display: none;">
                <div style="margin-top: 5px;">
                  <label for="qty"><span style="font-weight: bold;font-size: 1.7rem;"><%= t('forms.labels.enter_number_of_days')%></span></label> <br/>
                  <input type="text" id="qty" style="font-size: 1.2rem;" name="duration" required>
                </div>
                <div style="margin-top: 5px;">
                  <table width="70%" cellspacing="15" >
                    <tr>
                      <td class="customButton" onmousedown="append(1,'qty');setQuantity('qty')"><span>1</span></td>
                      <td class="customButton" onmousedown="append(2,'qty');setQuantity('qty')"><span>2</span></td>
                      <td class="customButton" onmousedown="append(3,'qty');setQuantity('qty')"><span>3</span></td>
                    </tr>
                    <tr>
                      <td class="customButton" onmousedown="append(4,'qty');setQuantity('qty')"><span>4</span></td>
                      <td class="customButton" onmousedown="append(5,'qty');setQuantity('qty')"><span>5</span></td>
                      <td class="customButton" onmousedown="append(6,'qty');setQuantity('qty')"><span>6</span></td>
                    </tr>
                    <tr>
                      <td class="customButton" onmousedown="append(7,'qty');setQuantity('qty')"><span>7</span></td>
                      <td class="customButton" onmousedown="append(8,'qty');setQuantity('qty')"><span>8</span></td>
                      <td class="customButton" onmousedown="append(9,'qty');setQuantity('qty')"><span>9</span></td>
                    </tr>
                    <tr>
                      <td class="customButton" onmousedown="append(0,'qty');setQuantity('qty')"><span>0</span></td>
                      <td class="customButton" onmousedown="append('.','qty');setQuantity('qty')"><span>.</span></td>
                      <td class="customButton" onmousedown="append('del','qty');setQuantity('qty')"><span>del</span></td>
                    </tr>
                  </table>
                </div>
              </div>
              <div class="mobi-div" id="extDiv" style="display: none;">
                <div style="margin-top: 5px;">
                  <label for="extBtl"><span style="font-weight: bold;font-size: 1.2em;"><%= t('forms.labels.enter_number_of_days')%></span></label> <br/>
                  <input type="text" id="extraBtl" style="font-size: 1.2em;" name="extBtl" required>
                </div>
              </div>
                  <input type="hidden" value="<%= @patient.id%>" name="patient_id" />
                  <input type="hidden" name="bottle_id" id="btl_field"/>
                  <input type="hidden" name="quantity" id="dispensed_quantity"/>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div style="display: table; width: 99vw;margin-top: 1vh;margin-left: auto;margin-right: auto">
      <div style="display: table-row;">
        <div style="width: 77.5vw;float: left;height: 12vh;padding:10px; outline:none; border-radius:8px; margin-top:8px; border:none; box-shadow: 8px 8px 8px 8px rgba(0, 0, 0, 0.21);margin-bottom:12px;  background-color: #fff;" class="header-cell ">
          <table style="width: 100%;font-size: 1.2em">
            <tr>
              <td rowspan="2">
                  <div class="<%=@patient.sex.downcase%>">
                    <img src="/assets/<%=@patient.sex.downcase%>.png"
                    style="height: 8vh;  width: 8vh;  display: block; object-fit:contain" />

                  </div>
              </td>
              <th style="text-align: left; font-size: 1.5rem;"><%= t('menu.terms.name') %></th>
              <th>:</th>
              <td style="font-size: 1.5rem;"><%= @patient.full_name %></td>
              <th style="text-align: left; font-size: 1.5rem;"><%= t('menu.terms.age') %></th>
              <th>:</th>
              <td style="font-size: 1.5rem;"><%= @patient.age %></td>
            </tr>
            <tr>
              <th style="text-align: left; font-size: 1.5rem;"><%= t('menu.terms.national_id') %></th>
              <th>:</th>
              <td style="font-size: 1.5rem;"><%= @patient.formatted_pnid %></td>
              <th style="text-align: left; font-size: 1.5rem;"><%= t('menu.terms.current_address') %></th>
              <th>:</th>
              <td style="font-size: 1.5rem;"> <%= @patient.current_address %></td>
            </tr>
          </table>
          </div>
          <div class="header-cell" style="float: right; width: 20vw; margin-right: 4px; height: 13.9vh; outline:none; border:none; border-radius:8px; box-shadow: 8px 8px 8px  8px rgba(0, 0, 0, 0.21);margin-top:8px;  background-color: #fff;">

            <!-- Title -->
            <div style="text-align: center; margin-bottom: 6px;padding-top:12px;">
              <strong style="font-size: 1.5rem;">
               <span style="font-size: 1.5rem; padding-top: 14px;"><%= t('menu.terms.scan_label_barcode') %></span>
              </strong>
            </div>

            <div style="display: flex; align-items: center; justify-content: center; gap: 8px;">
              <img src="/assets/barcode.jpg" style="height: 40px; display: block;">
              
              <input type="text" 
                    id="barcode" 
                    class="scanner" 
                    style="width: 70%; margin-top: 3px;" 
                    autofocus>
            </div>

          </div>
      </div>
      <div style="display: table-row;">
     <div style="border: 4px solid #070738 !important; margin-top:10px; outline:none; border-radius:12px;">
            <% if has_prescribe %>
              <%= render '/patients/prescribe_view' %>
            <% else %>
              <%= render '/patients/dispense_view' %>
            <% end %>
        </div>
      </div>
    </div>
    <!-- FOOTER -->
    <div class="footer" style="margin-left: 0vw; width: 100vw; font-size: 1.4rem">
      <button class="nav-bttn green" style="float:right; margin-right: 1vw;" onmousedown="window.location='/'">Finish</button>
    </div>
  </body>

  <div id="shadowLayer"></div>
  <div id="messageLayer">
    <span id="flashMessage"></span>
  </div>
<script type="text/javascript">
  var timerHand;

  // Track completed tabs
  let completedTabs = new Set();
  const tabOrder = ['routesDiv', 'doseDiv', 'directionsDiv', 'qtyDiv', 'doseTypeDiv'];

  // --- Focus / scanner management variables & helpers ---
  let barcodeInput = null;
  let isModalOpen = false;
  let barcodeTimer = null;

  function focusBarcodeInputImmediate() {
    const barcode = document.getElementById("barcode");
    if (barcode) {
      barcode.focus();
      barcode.select();
    }
  }

  // Small helper used after modal transitions to avoid fighting animations
  function keepScannerFocused() {
    setTimeout(() => {
      if (!isModalOpen) focusBarcodeInputImmediate();
    }, 100);
  }

  // --- Focus management (event-driven) ---
  function initializeBarcodeListener() {
    if (!barcodeInput) barcodeInput = document.getElementById("barcode");
    if (!barcodeInput) return;

    // Remove any previous listeners to avoid double-binding
    barcodeInput.removeEventListener('input', handleBarcodeInput);
    barcodeInput.removeEventListener('blur', handleBarcodeBlur);

    // Clear any existing timers
    if (timerHand) clearTimeout(timerHand);

    // Ensure field is focused and empty
    barcodeInput.value = "";
    barcodeInput.focus();

    // Use event listener instead of timer-based checking
    barcodeInput.addEventListener('input', handleBarcodeInput);
    barcodeInput.addEventListener('blur', handleBarcodeBlur);
  }

  function handleBarcodeInput(event) {
    const inputEl = event.target;

    // debounce to allow the scanner to finish typing
    if (barcodeTimer) clearTimeout(barcodeTimer);
    barcodeTimer = setTimeout(() => {
      const rawValue = event.target.value.trim().toUpperCase(); // remove all dashes
      if (rawValue.length >= 8) {
        processBarcode(rawValue);
      }
    }, 120); // 120ms debounce - adjust down if needed
  }

  function handleBarcodeBlur() {
    // Refocus after a short delay unless modal is open
    if (!isModalOpen) {
      setTimeout(() => {
        if (!isModalOpen && barcodeInput) {
          barcodeInput.focus();
        }
      }, 100);
    }
  }

  function processBarcode(rawValue) {
    if (!barcodeInput) barcodeInput = document.getElementById("barcode");
    if (!barcodeInput) return;

    barcodeInput.value = rawValue;
    document.getElementById("bottle_id").innerHTML = rawValue;
    document.getElementById("btl_field").value = rawValue;

    // Reset the modal before fetching bottle data
    resetDispenseModal();

    // Fetch the bottle immediately
    getBottle(rawValue);

    // Clear input for next scan and refocus shortly
    setTimeout(() => {
      if (barcodeInput) {
        barcodeInput.value = "";
        // Only refocus if modal isn't about to open
        if (!isModalOpen) barcodeInput.focus();
      }
    }, 50);
  }

  // --- Main functions ---

  // Mark a tab as completed
  function markTabCompleted(tabId) {
    completedTabs.add(tabId);
    const tab = document.getElementById(tabId);
    if (tab) {
      tab.style.backgroundColor = '#28a745';  // Green
      tab.style.color = 'white';
      
      // Add checkmark icon
      if (!tab.querySelector('.checkmark')) {
        const checkmark = document.createElement('span');
        checkmark.className = 'checkmark';
        checkmark.innerHTML = ' ✔';
        checkmark.style.fontWeight = 'bold';
        checkmark.style.marginLeft = '8px';
        checkmark.style.fontSize = '1.1rem';
        tab.appendChild(checkmark);
      }
    }
  }

  // Handle dose type selection
  function setDoseType() {
    // Mark doseType tab as completed when a dose type is selected
    if (checkRadio(document.getElementsByName("doseType")) && !completedTabs.has('doseTypeTab')) {
      markTabCompleted('doseTypeTab');
    }
  }

 // Function to reset the modal to its initial state
  function resetDispenseModal() {
      // Reset input fields
      document.getElementById('dose').value = '';
      document.getElementById('qty').value = '';
      
      // Clear calculated quantity
      document.getElementById('qtyDisp').innerHTML = '0';
      document.getElementById('dispensed_quantity').value = '0';
      
      // Clear displayed selections
      document.getElementById('route_type').innerHTML = '';
      document.getElementById('directionsDisp').innerHTML = '';
      
      // Uncheck all radio buttons
      ['doseType', 'administration', 'frequency'].forEach(name => {
          document.getElementsByName(name).forEach(el => el.checked = false);
      });
      
      // Reset completed tabs
      completedTabs.clear();
      
      // Reset ALL tabs to their default styling and remove checkmarks
      ['routesTab','doseTab','directionsTab','qtyTab','doseTypeTab'].forEach(tabId => {
          const tab = document.getElementById(tabId);
          if (tab) {
              tab.style.backgroundColor = '#2196F3';  // Blue (default)
              tab.style.color = 'white';
              tab.style.border = '1px outset silver';
              
              // Remove checkmark if present
              const checkmark = tab.querySelector('.checkmark');
              if (checkmark) {
                  checkmark.remove();
              }
          }
      });
      
      // Reset tab visibility
      ['routesDiv','doseDiv','directionsDiv','qtyDiv','doseTypeDiv'].forEach(t => {
          document.getElementById(t).style.display = 'none';
      });
      
      // Show first tab with active styling
      document.getElementById('routesDiv').style.display = '';
      document.getElementById('routesTab').style.border = '5px solid #de0404'; // Red border for active tab
      
      // Reset buttons
      var button = document.getElementById('dispNext');
      button.setAttribute('onmousedown', "showDispenseDiv('routesDiv')");
      button.innerHTML = '<%= t("forms.buttons.nexttt") %>';
      button.disabled = false;
      button.style.backgroundColor = '';
      button.style.cursor = '';
      button.removeAttribute("data-stock-insufficient");
      
      // Hide Clear button & warnings
      document.getElementById('dispClear').style.display = 'none';
      hideDispensationWarning();
  }

  // Global function to check stock and update button state
  function checkStockAndUpdateButton() {
    var button = document.getElementById('dispNext');
    if (!button) return;
    
    // Only apply stock validation when on the final tab (Finish button)
    if (button.innerHTML.includes('<%= t("forms.buttons.finish") %>')) {
      // Recalculate the original quantity to check against stock
      var dose = parseFloat(document.getElementById('dose').value) || 0;
      var duration = parseFloat(document.getElementById('qty').value) || 0;
      var frequencyCode = document.forms[0].elements["frequency"].value;
      
      var freq = 1;
      switch(frequencyCode) {
        case 'OD': freq = 1; break;
        case 'BD': freq = 2; break;
        case 'TDS': freq = 3; break;
        case 'QID': freq = 4; break;
        case 'QHR': freq = 24; break;
        case 'Q2HRS': freq = 12; break;
        case 'Q4HRS': freq = 6; break;
        case 'EOD': freq = 0.5; break;
        case 'QN': freq = 1; break;
        case 'QWK': freq = 1/7; break;
      }
      
      var originalQty = dose * freq * duration;
      originalQty = isNaN(originalQty) ? 0 : Math.ceil(originalQty);
      var currentQty = parseInt(document.getElementById('currQty').innerHTML, 10) || 0;
      
      if (originalQty > currentQty) {
        button.disabled = true;
        button.style.backgroundColor = '#ccc';
        button.style.cursor = 'not-allowed';
        button.setAttribute("data-stock-insufficient", "true");
      } else {
        button.disabled = false;
        button.style.backgroundColor = '';
        button.style.cursor = '';
        button.removeAttribute("data-stock-insufficient");
      }
    }
  }

  function updateQuantity() {
    var dose = parseFloat(document.getElementById('dose').value) || 0;
    var duration = parseFloat(document.getElementById('qty').value) || 0;

    var frequencyCode = document.forms[0].elements["frequency"].value;
    var freq = 1;
    switch(frequencyCode) {
      case 'OD': freq = 1; break;
      case 'BD': freq = 2; break;
      case 'TDS': freq = 3; break;
      case 'QID': freq = 4; break;
      case 'QHR': freq = 24; break;
      case 'Q2HRS': freq = 12; break;
      case 'Q4HRS': freq = 6; break;
      case 'EOD': freq = 0.5; break;
      case 'QN': freq = 1; break;
      case 'QWK': freq = 1/7; break;
    }

    var qty = dose * freq * duration;
    qty = isNaN(qty) ? 0 : Math.ceil(qty);

    var currentQty = parseInt(document.getElementById('currQty').innerHTML, 10) || 0;

    // Show warning and clamp quantity if exceeding available stock
    if (qty > currentQty) {
      showDispensationWarning(`Cannot dispense more than ${currentQty} units.`);
      qty = currentQty; // clamp to available quantity
    } else {
      hideDispensationWarning();
    }

    document.getElementById("qtyDisp").innerHTML = qty;
    document.getElementById("dispensed_quantity").value = qty;

    // Always check stock and update button state after quantity calculation
    checkStockAndUpdateButton();

    // Mark dose tab as completed when valid dose is entered
    if (dose > 0 && !completedTabs.has('doseTab')) {
      markTabCompleted('doseTab');
    }

    // Mark duration tab as completed when valid duration is entered
    if (duration > 0 && !completedTabs.has('qtyTab')) {
      markTabCompleted('qtyTab');
    }
  }

  function hasPrescription() {
    var route = document.getElementsByName("administration");
    var doseType = document.getElementsByName("doseType");
    var frequency = document.getElementsByName("frequency");
    var dose = parseFloat(document.getElementById('dose').value) || 0;
    var qty = parseFloat(document.getElementById('qty').value) || 0;

    return checkRadio(route) && checkRadio(doseType) && checkRadio(frequency) && dose > 0 && qty > 0;
  }

  // showDispenseDiv function
  function showDispenseDiv(option) {
      var tabs = ['routesDiv','doseDiv','directionsDiv','qtyDiv','doseTypeDiv'];
      var currentTab = tabs.indexOf(option);
      var button = document.getElementById('dispNext');
      var clearButton = document.getElementById('dispClear');

      $(".mobi-div").css("display", "none");
      
      // Update tab styles - current tab gets red border, completed tabs stay green
      ['routesTab','doseTab','directionsTab','qtyTab','doseTypeTab'].forEach(tabId => {
          const tab = document.getElementById(tabId);
          if (tab) {
              // Reset all tabs to blue (default) except completed ones
              if (!completedTabs.has(tabId)) {
                  tab.style.backgroundColor = '#2196F3';  // Blue (default)
                  tab.style.color = 'white';
                  tab.style.border = '1px outset silver';
              } else {
                  // Completed tabs stay green
                  tab.style.backgroundColor = '#28a745';  // Green
                  tab.style.color = 'white';
                  tab.style.border = '1px solid #1e7e34';
              }
          }
      });

      // Current active tab gets red border
      const currentTabElement = document.getElementById(option.replace('Div','Tab'));
      if (currentTabElement) {
          currentTabElement.style.border = '5px solid #de0404'; 
      }

      document.getElementById(option).style.display = "";

      // Show Clear button only on doseDiv or qtyDiv
      if (option === 'doseDiv' || option === 'qtyDiv') {
          clearButton.style.display = "inline-block";
      } else {
          clearButton.style.display = "none";
      }

      // Standard prescription mode flow
      if (option == 'doseTypeDiv') {
          button.setAttribute("onmousedown", "validateDispWithStockCheck()");
          button.innerHTML = '<%= t("forms.buttons.finish") %>';
          
          // ALWAYS recalculate and check stock when showing the finish tab
          updateQuantity(); // This will recalculate and call checkStockAndUpdateButton()
          
      } else {
          button.setAttribute("onmousedown", "showDispenseDiv('" + tabs[currentTab + 1] + "')");
          button.innerHTML = '<%= t("forms.buttons.next") %>';
          // Ensure button is enabled for navigation
          button.disabled = false;
          button.style.backgroundColor = '';
          button.style.cursor = '';
          button.removeAttribute("data-stock-insufficient");
      }
  }

  function setRoute(route) {
    document.getElementById("route_type").innerHTML = route;
    updateQuantity();
    
    // Mark route tab as completed
    if (route && !completedTabs.has('routesTab')) {
      markTabCompleted('routesTab');
    }
  }

  function setDirections(){
    var field = document.getElementById("directionsDisp");
    var frequency = document.forms[0].elements["frequency"].value
    field.innerHTML = createDirections(
        document.getElementById("route_type").innerHTML, 
        document.getElementById('dose').value, 
        frequency,
        "doseType"
    );
    updateQuantity();
    
    // Mark directions tab as completed when frequency is selected
    if (frequency && !completedTabs.has('directionsTab')) {
      markTabCompleted('directionsTab');
    }
  }

  function validateDispWithStockCheck() {
    var button = document.getElementById('dispNext');
    
    // Check if button is marked as having insufficient stock
    if (button && button.getAttribute("data-stock-insufficient") === "true") {
      var currentQty = parseInt(document.getElementById('currQty').innerHTML, 10) || 0;
      showDispensationWarning(`Cannot dispense more than ${currentQty} units.`);
      return false;
    }
    
    // Proceed with normal validation
    return validateDisp();
  }

  function validateDisp() {
    var button = document.getElementById('dispNext');
    
    // Prevent submission if button is disabled due to insufficient stock
    if (button && button.disabled) {
      var currentQty = parseInt(document.getElementById('currQty').innerHTML, 10) || 0;
      showDispensationWarning(`Cannot dispense more than ${currentQty} units.`);
      return;
    }

    checkRoute = document.getElementsByName("administration");
    checkDoseType = document.getElementsByName("doseType");
    checkdirections = document.getElementsByName("frequency");

    if (checkRadio(checkRoute)) {
        if (checkRadio(checkDoseType)) {
            if (parseFloat(document.getElementById('dose').value) > 0) {
                if (checkRadio(checkdirections)) {
                    if (parseFloat(document.getElementById('qty').value) > 0) {
                        updateQuantity(); // <-- important
                        
                        // Final check before submission - ensure we're not exceeding stock
                        var qty = parseInt(document.getElementById("qtyDisp").innerHTML, 10) || 0;
                        var currentQty = parseInt(document.getElementById('currQty').innerHTML, 10) || 0;
                        
                        if (qty > currentQty) {
                          showDispensationWarning(`Cannot dispense more than ${currentQty} units.`);
                          return;
                        }
                        
                        // Mark doseType tab as completed before submitting
                        if (!completedTabs.has('doseTypeTab')) {
                          markTabCompleted('doseTypeTab');
                        }
                        
                        // Before submitting, clear modal state so focus returns after submit
                        isModalOpen = false;
                        document.forms[0].submit();
                    } else {
                        showDispenseDiv('qtyDiv');
                    }
                } else {
                    showDispenseDiv('directionsDiv');
                }
            } else {
                showDispenseDiv('doseDiv');
            }
        } else {
            showDispenseDiv('doseTypeDiv');
        }
    } else { 
        showDispenseDiv('routesDiv');
    }
  }

  function checkRadio(list)
  {
    for(i=0; i < list.length; i++){
      if(list[i].checked)
      {
        return true;
      }
    }
    return false;
  }
   
  function showDispensationWarning(message) {
    const warning = document.getElementById("dispensationWarning");
    warning.innerText = message;
    warning.style.display = "inline";
  }

  function hideDispensationWarning() {
    document.getElementById("dispensationWarning").style.display = "none";
  }

  // setQuantity function to mark duration tab as completed
  function setQuantity(input) {
    var duration = parseFloat(document.getElementById(input).value) || 0;
    var frequencyCode = document.forms[0].elements["frequency"].value;

    var freq = 1;
    switch(frequencyCode) {
      case 'OD': freq = 1; break;
      case 'BD': freq = 2; break;
      case 'TDS': freq = 3; break;
      case 'QID': freq = 4; break;
      case 'QHR': freq = 24; break;
      case 'Q2HRS': freq = 12; break;
      case 'Q4HRS': freq = 6; break;
      case 'EOD': freq = 0.5; break;
      case 'QN': freq = 1; break;
      case 'QWK': freq = 1/7; break;
    }

    var qty = parseFloat(document.getElementById('dose').value) * freq * duration;
    qty = isNaN(qty) ? 0 : Math.ceil(qty);

    var currentQty = parseInt(document.getElementById('currQty').innerHTML, 10) || 0;

    // Show warning and clamp quantity if exceeding available stock
    if (qty > currentQty) {
      showDispensationWarning(`Cannot dispense more than ${currentQty} units.`);
      qty = currentQty; // clamp to available quantity
    } else {
      hideDispensationWarning();
    }

    document.getElementById("qtyDisp").innerHTML = qty;
    document.getElementById("dispensed_quantity").value = qty;

    // Always check stock and update button state after quantity calculation
    checkStockAndUpdateButton();

    // MARK DURATION TAB AS COMPLETED WHEN VALID DURATION IS ENTERED
    if (duration > 0 && !completedTabs.has('qtyTab')) {
      markTabCompleted('qtyTab');
    }
  }

  function getBottle(bottleId) {
    isModalOpen = true;

    var xmlhttp = (window.XMLHttpRequest)
      ? new XMLHttpRequest()
      : new ActiveXObject("Microsoft.XMLHTTP");

    var context = window.location.pathname.includes('/prepack_labels')
      ? 'prepacking'
      : 'patient';

    // Get patient_id and prescription_id from the current page
    var patientId = getCurrentPatientId();
    var prescriptionId = getCurrentPrescriptionId();

    xmlhttp.onreadystatechange = function() {
      if (xmlhttp.readyState === 4) {
        if (xmlhttp.status === 200) {
          var results = xmlhttp.responseText;

          if (!results || results === 'undefined' || results === 'null' || results === 'false' || results === '{}') {
            showFlashMessage(`Bottle ID ${bottleId} not found in inventory.`, true);
            isModalOpen = false;
            initializeBarcodeListener();
            return;
          }

          try {
            var result = JSON.parse(results);

            if (result.error) {
              showFlashMessage(result.error, true);
              isModalOpen = false;
              initializeBarcodeListener();
              return;
            }

            // Handle auto-dispensed prepack
            if (result.prepack && context === 'patient' && result.dispensation_id) {
              showFlashMessage(result.message || "Prepack dispensed successfully.");

              // Refresh page so dispensation appears immediately
              setTimeout(function() {
                window.location.reload();
              }, 1200);

              isModalOpen = false;
              return;
            }

            document.getElementById('item').innerHTML = result['name'] || '';
            document.getElementById('currQty').innerHTML = result['currentQty'] || 0;

            // Open modal only in patient context when not auto-dispensed
            if (context === 'patient') {
              showDispenseForm();
              showDispenseDiv('routesDiv');
              isModalOpen = true;
            }

            if (context === 'prepacking') {
              isModalOpen = false;
              initializeBarcodeListener();
            }

          } catch (e) {
            alert(`Bottle ID ${bottleId} returned invalid data.`);
            isModalOpen = false;
            initializeBarcodeListener();
          }
        } else {
          let message = `Bottle ID ${bottleId} could not be fetched.`;

          try {
            const res = JSON.parse(xmlhttp.responseText);

            if (res.expired) {
              message = `\n\nThis bottle is expired.\nExpiration date: ${res.expiration_date}`;
            } else if (res.error) {
              message = res.error;
            }
          } catch (e) {
            // ignore JSON parse errors
          }

          showFlashMessage(message, true);

          isModalOpen = false;
          initializeBarcodeListener();
        }
      }
    };

    // Build URL with patient and prescription data
    var url = "/ajax_bottle/" + bottleId + "?context=" + context;
    if (patientId) url += "&patient_id=" + patientId;
    if (prescriptionId) url += "&prescription_id=" + prescriptionId;

    xmlhttp.open("GET", url, true);
    xmlhttp.send();
  }

  // Helper functions to get current patient and prescription IDs
  function getCurrentPatientId() {
    // Try different ways to get patient_id
    return document.getElementById('patient_id')?.value || 
          document.querySelector('input[name="patient_id"]')?.value ||
          window.currentPatientId ||
          new URLSearchParams(window.location.search).get('patient_id') ||
          sessionStorage.getItem('currentPatientId');
  }

  function getCurrentPrescriptionId() {
    // Try different ways to get prescription_id
    return document.getElementById('prescription_id')?.value || 
          document.querySelector('input[name="prescription_id"]')?.value ||
          window.currentPrescriptionId ||
          new URLSearchParams(window.location.search).get('prescription_id') ||
          sessionStorage.getItem('currentPrescriptionId');
  }

  // Reset fields and bind dispClear if present
  document.addEventListener("DOMContentLoaded", function() {
    // Initialize barcode listener (this replaces old timer loop)
    initializeBarcodeListener();

    // Add event listeners to dose type radio buttons
    const doseTypeRadios = document.getElementsByName("doseType");
    if (doseTypeRadios.length > 0) {
      doseTypeRadios.forEach(radio => {
        radio.addEventListener('change', setDoseType);
      });
    }

    const dispClear = document.getElementById("dispClear");
    if (dispClear) {
      dispClear.addEventListener("click", function() {
        const visibleTab = document.querySelector('.mobi-div:not([style*="display: none"])');
        if (!visibleTab) return;

        const currentTabId = visibleTab.id.replace('Div', 'Tab');
        
        if (visibleTab.id === "doseDiv") {
          document.getElementById("dose").value = "";
          setDirections();
          updateQuantity();
          // Remove completed status for dose tab
          completedTabs.delete('doseTab');
        } else if (visibleTab.id === "qtyDiv") {
          document.getElementById("qty").value = "";
          // Manually update without calling setQuantity to avoid re-marking dose tab
          document.getElementById("qtyDisp").innerHTML = "0";
          document.getElementById("dispensed_quantity").value = "0";
          hideDispensationWarning();
          // Remove completed status for duration tab
          completedTabs.delete('qtyTab');
        }

        // Revert the tab styling to blue and remove checkmark
        const tab = document.getElementById(currentTabId);
        if (tab) {
          tab.style.backgroundColor = '#2196F3';  // Back to blue
          tab.style.color = 'white';
          tab.style.border = '1px outset silver';
          
          // Remove checkmark
          const checkmark = tab.querySelector('.checkmark');
          if (checkmark) {
            checkmark.remove();
          }
        }

        // Hide button again
        dispClear.style.display = "none";
      });
    }

    // Add ID to dose label for easier resetting
    const doseLabel = document.querySelector("label[for='dose']");
    if (doseLabel) doseLabel.id = "doseLabel";
  });

  // Update cancelDispense
  function cancelDispense() {
      isModalOpen = false;

      // Hide the modal
      hideLayer('shadow', 'dispenseForm');
      
      // Reset the modal (this now properly resets tabs)
      resetDispenseModal();

      // Reset barcode input
      if (!barcodeInput) barcodeInput = document.getElementById("barcode");
      if (barcodeInput) {
          barcodeInput.value = "";
          // allow modal hide animation to finish then refocus
          setTimeout(() => {
              barcodeInput.focus();
              initializeBarcodeListener();
          }, 150);
      } else {
          initializeBarcodeListener();
      }
  }
</script>

<script>
// Configuration
const frequencyMap = {
  OD: 1,
  BD: 2,
  TDS: 3,
  QID: 4
};

const freqRadios = document.querySelectorAll("input[name='frequency']");
const checkboxes = document.querySelectorAll(".timeOfDayGrid input[type=checkbox]");
const nextButton = document.getElementById('dispNext');

// Define which tabs come after directions
const tabsAfterDirections = ['qtyTab', 'doseTypeTab'];
const tabsBeforeDirections = ['routesTab', 'doseTab'];

// Helpers
function getSelectedFrequency() {
  const selected = document.querySelector("input[name='frequency']:checked");
  return selected ? selected.value : null;
}

function getSelectedCheckboxCount() {
  return Array.from(checkboxes).filter(cb => cb.checked).length;
}

function isCheckboxValidationRequired(freq) {
  // Only these frequencies require checkbox validation
  return ['OD', 'BD', 'TDS', 'QID'].includes(freq);
}

// Validation function
function validateCheckboxSelection() {
  const freq = getSelectedFrequency();
  const checkedCount = getSelectedCheckboxCount();
  
  // If no frequency selected or frequency doesn't require checkbox validation
  if (!freq || !isCheckboxValidationRequired(freq)) {
    return { isValid: true, required: 0, selected: checkedCount };
  }
  
  const required = frequencyMap[freq];
  const isValid = checkedCount === required;
  
  return { isValid, required, selected: checkedCount };
}

// Main function to update state
function updateCheckboxState() {
  const freq = getSelectedFrequency();
  const validation = validateCheckboxSelection();

  // No frequency selected → disable all
  if (!freq) {
    checkboxes.forEach(cb => {
      cb.checked = false;
      cb.disabled = true;
    });
    nextButton.disabled = true;
    updateTabNavigation();
    return;
  }

  // Handle special frequencies
  switch(freq) {
    case "QHR":
    case "Q2HRS":
    case "Q4HRS":
      checkboxes.forEach(cb => { cb.checked = false; cb.disabled = true; });
      nextButton.disabled = false;
      updateTabNavigation();
      return;

    case "EOD":
      checkboxes.forEach(cb => { cb.checked = false; cb.disabled = true; });
      nextButton.disabled = false;
      updateTabNavigation();
      return;

    case "QN":
      checkboxes.forEach(cb => { cb.checked = false; cb.disabled = false; });
      const night = document.querySelector(".timeOfDayGrid input[value='night']");
      if (night && !night.checked) night.checked = true;
      nextButton.disabled = false;
      updateTabNavigation();
      return;

    case "QWK":
      checkboxes.forEach(cb => { cb.checked = false; cb.disabled = true; });
      nextButton.disabled = false;
      updateTabNavigation();
      return;
  }

  // Standard frequencies (OD, BD, TDS, QID)
  const max = frequencyMap[freq];
  const checkedCount = getSelectedCheckboxCount();

  checkboxes.forEach(cb => {
    if (!cb.checked) {
      cb.disabled = checkedCount >= max;
    } else {
      cb.disabled = false;
    }
  });

  // Disable Next if selected count < required
  nextButton.disabled = checkedCount < max;
  updateTabNavigation();
}

// Tab Navigation Control
function updateTabNavigation() {
  const validation = validateCheckboxSelection();
  const directionsTab = document.getElementById('directionsTab');
  const currentTab = document.querySelector('.mobi-div:not([style*="display: none"])');
  
  if (!directionsTab || !currentTab) return;
  
  const currentTabId = currentTab.id;
  
  // Only restrict navigation if we're on the directions tab
  if (currentTabId === 'directionsDiv' && !validation.isValid && isCheckboxValidationRequired(getSelectedFrequency())) {
    // Disable only tabs AFTER directions (Duration and Dose Type)
    tabsAfterDirections.forEach(tabId => {
      const tab = document.getElementById(tabId);
      if (tab) {
        tab.style.pointerEvents = 'none';
        tab.style.opacity = '0.5';
        tab.style.cursor = 'not-allowed';
      }
    });
    
    // Keep tabs b4 directions enabled
    tabsBeforeDirections.forEach(tabId => {
      const tab = document.getElementById(tabId);
      if (tab) {
        tab.style.pointerEvents = 'auto';
        tab.style.opacity = '1';
        tab.style.cursor = 'pointer';
      }
    });
    
    // Show validation message
    showValidationMessage(`Please select exactly ${validation.required} time(s) of day for ${getSelectedFrequency()} frequency from the Time of Day checkboxes.`);
  } else {
    // Enable ALL tabs
    ['routesTab', 'doseTab', 'directionsTab', 'qtyTab', 'doseTypeTab'].forEach(tabId => {
      const tab = document.getElementById(tabId);
      if (tab) {
        tab.style.pointerEvents = 'auto';
        tab.style.opacity = '1';
        tab.style.cursor = 'pointer';
      }
    });
    
    // Hide validation message
    hideValidationMessage();
  }
}

// Validation Message Functions
function showValidationMessage(message) {
  let messageDiv = document.getElementById('checkboxValidationMessage');
  if (!messageDiv) {
    messageDiv = document.createElement('div');
    messageDiv.id = 'checkboxValidationMessage';
    messageDiv.style.color = '#d32f2f';
    messageDiv.style.backgroundColor = '#ffebee';
    messageDiv.style.padding = '10px';
    messageDiv.style.margin = '10px 8px';
    messageDiv.style.borderRadius = '4px';
    messageDiv.style.border = '1px solid #ef9a9a';
    messageDiv.style.fontSize = '20px';
    
    const directionsDiv = document.getElementById('directionsDiv');
    if (directionsDiv) {
      directionsDiv.insertBefore(messageDiv, directionsDiv.firstChild);
    }
  }
  messageDiv.textContent = message;
  messageDiv.style.display = 'block';
}

function hideValidationMessage() {
  const messageDiv = document.getElementById('checkboxValidationMessage');
  if (messageDiv) {
    messageDiv.style.display = 'none';
  }
}

// Event listeners
freqRadios.forEach(radio => {
  radio.addEventListener("change", () => {
    checkboxes.forEach(cb => { cb.checked = false; cb.disabled = false; });
    updateCheckboxState();
    // Update directions display when frequency changes
    setDirections();
  });
});

checkboxes.forEach(cb => {
  cb.addEventListener("change", () => {
    updateCheckboxState();
    // Update directions display when checkboxes change
    setDirections();
  });
});

// showDispenseDiv override
const originalShowDispenseDiv = showDispenseDiv;
showDispenseDiv = function(option) {
  const currentTab = document.querySelector('.mobi-div:not([style*="display: none"])');
  const currentTabId = currentTab ? currentTab.id : '';
  
  // If trying to navigate away from directions tab to a tab after directions, check validation
  if (currentTabId === 'directionsDiv') {
    const tabsAfter = ['qtyDiv', 'doseTypeDiv'];
    
    if (tabsAfter.includes(option)) {
      const validation = validateCheckboxSelection();
      const freq = getSelectedFrequency();
      
      if (!validation.isValid && isCheckboxValidationRequired(freq)) {
        showValidationMessage(`Please select exactly ${validation.required} time(s) of day for ${freq} frequency before proceeding.`);
        return; // Prevent navigation to tabs after directions
      }
    }
    // Allow navigation to tabs before directions without validation
  }
  
  // Call original function if validation passes or if navigating to tabs before directions
  originalShowDispenseDiv.call(this, option);
  
  // Update navigation after showing new div
  updateTabNavigation();
};

// Modify the Next button click handler
const originalNextClick = nextButton.getAttribute('onmousedown');
if (originalNextClick && originalNextClick.includes('showDispenseDiv')) {
  // Wrap the next button handler to add validation
  nextButton.setAttribute('onmousedown', `
    const currentTab = document.querySelector('.mobi-div:not([style*="display: none"])');
    if (currentTab && currentTab.id === 'directionsDiv') {
      const freq = getSelectedFrequency();
      if (freq && ['OD', 'BD', 'TDS', 'QID'].includes(freq)) {
        const required = ${JSON.stringify(frequencyMap)};
        const selected = getSelectedCheckboxCount();
        if (selected < required[freq]) {
          showValidationMessage('Please select exactly ' + required[freq] + ' time(s) of day for ' + freq + ' frequency.');
          return;
        }
      }
    }
    ${originalNextClick}
  `);
}

// Initialize
updateCheckboxState();

// setDirections with time of day
const originalSetDirections = setDirections;
setDirections = function() {
  originalSetDirections();
  
  // Get selected times of day
  const selectedTimes = [];
  checkboxes.forEach(cb => {
    if (cb.checked) {
      const label = document.querySelector(`label[for="${cb.id}"]`);
      selectedTimes.push(label ? label.textContent.trim() : cb.value);
    }
  });
  
  // Append time of day to directions if any selected
  if (selectedTimes.length > 0) {
    const field = document.getElementById("directionsDisp");
    const currentText = field.innerHTML;
    
    // Remove any existing time of day text
    const timeRegex = /\(at .*\)$/;
    const newText = currentText.replace(timeRegex, '');
    
    // Add new time of day
    field.innerHTML = newText + (selectedTimes.length > 0 ? ` (at ${selectedTimes.join(', ')})` : '');
  }
  
  // Update checkbox validation state
  updateCheckboxState();
};

// reset validations
const originalResetDispenseModal = resetDispenseModal;
resetDispenseModal = function() {
  // Call original function first
  originalResetDispenseModal();
  
  // Reset checkbox validation
  checkboxes.forEach(cb => {
    cb.checked = false;
    cb.disabled = true;
  });
  
  // Reset validation message
  hideValidationMessage();
  
  // Reset tab navigation
  updateTabNavigation();
};
</script>

