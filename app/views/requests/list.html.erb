<%= javascript_include_tag 'jquery.dataTables.min.js' %>

<style type="text/css">
  /* Table styling */
  #generalInventory {
    border-collapse: collapse;
    width: 100%;
    table-layout: auto;
    font-size: 1.5em;
    background-color: #fff;
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0px 2px 6px rgba(0,0,0,0.1);
  }
  
  .dataTables_wrapper {
    width: 100% !important;
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  
  /* Borders & padding */
  #generalInventory th {
      border: 1px solid #e2e2e2;
      padding: 12px 18px;
      white-space: nowrap;
      background-color: #708090;
      color: #000000;
      font-weight: normal;
      text-align: left;
  }

  #generalInventory td {
      border: 1px solid #e2e2e2;
      padding: 24px 24px;
      white-space: nowrap;
      background-color: inherit !important;
      font-size: 1.3em;
  }
  
  #generalInventory thead th {
    font-weight: normal;
    background-color: #708090;
    color: #000000;
    text-align: left;
  }

  /* Right-align numeric columns */
  #generalInventory td:nth-child(2),
  #generalInventory td:nth-child(3),
  #generalInventory td:nth-child(4) {
    text-align: right;
    padding-right: 25px;
  }

  /* Consistent row shading */
  #generalInventory tbody tr:nth-child(odd) {
      background-color: #f7f7f7;
  }
  #generalInventory tbody tr:nth-child(even) {
      background-color: #e9e9e9;
  }
  #generalInventory tbody tr:hover {
      background-color: #d0e6ff;
  }

  /* Search input */
  #search {
    font-size: 1.4em;
    padding: 10px 16px;
    margin: 15px 0;
    width: 40%;
    border: 1px solid #888;
    border-radius: 6px;
    display: block;
  }

  h1 {
    margin: 0.5vw 0;
    padding-left: 12px;
  }

  .footer {
    margin-top: 20px;
    text-align: right;
    padding-right: 12px;
  }

  .nav-bttn.green {
    background: #28a745;
    color: white;
    border: none;
    padding: 12px 22px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 1.1em;
  }
  .nav-bttn.green:hover {
    background: #218838;
  }

  .dataTables_filter input {
    font-size: 1.6em;
    padding: 6px 10px;
    height: 40px;
    width: 320px;
    border: 1px solid #ccc;
    border-radius: 6px;
  }
  .dataTables_filter label {
    font-size: 1.8em;
    margin-right: 10px;
  }
  
  /* UPDATED: Container styling with proper spacing */
  .table-container {
    width: calc(100vw - 24px);
    margin: 0 12px;
    padding: 0;
    box-sizing: border-box;
    overflow-x: hidden;
  }
</style>

<script type="text/javascript">
  function debounce(fn, wait) {
    let t;
    return function(...args) {
      clearTimeout(t);
      t = setTimeout(() => fn.apply(this, args), wait);
    };
  }

  $(document).ready(function() {
    const table = $('#generalInventory').DataTable({
      "bLengthChange": false,
      "bDestroy": true,
      "pageLength": 5,
      "paging": true,
      "pagingType": "full_numbers",
      "autoWidth": false,
      "language": {
        "search": I18n.t('forms.labels.search'),
        "zeroRecords": I18n.t('forms.labels.nothing_found'),
        "info": "Showing _START_ to _END_ of _TOTAL_ entries",
        "infoEmpty": "No records available",
        "infoFiltered": "(filtered from _MAX_ total entries)",
        "oPaginate": {
          "sNext": I18n.t('forms.buttons.next'),
          "sPrevious": I18n.t('forms.buttons.previous')
        }
      },
      "columnDefs": [
        { "width": "25%", "targets": 0 },
        { "width": "15%", "targets": 1 },
        { "width": "15%", "targets": 2 },
        { "width": "10%", "targets": 3 },
        { "width": "17%", "targets": 4 },
        { "width": "18%", "targets": 5 }
      ]
    });

    // Recalculate widths whenever the table container changes size
    const adjustTable = debounce(() => {
      table.columns.adjust().responsive.recalc();
    }, 150);

    // Listen for multiple triggers
    window.addEventListener('resize', adjustTable);
    window.addEventListener('orientationchange', adjustTable);
    
    // Detect container size changes (works for touchscreens / moving windows)
    const container = document.querySelector('#generalInventory').parentElement;
    const resizeObserver = new ResizeObserver(adjustTable);
    resizeObserver.observe(container);

    // Initial adjustment
    setTimeout(() => table.columns.adjust().responsive.recalc(), 50);
  });
</script>

<div style="height: 10vh; border-bottom: 3px solid #ccc; padding-left: 12px;">
  <h1><%= @report_type.titleize %></h1>
</div>

<!-- UPDATED: Container with proper spacing -->
<div class="table-container">
  <table id="generalInventory" class="display">
    <thead>
      <tr>
        <th>Drug</th>
        <th>Amount Requested</th>
        <th>Amount Received</th>
        <th>Remaining</th>
        <th>Requested Date</th>
        <th>Received Date</th>
      </tr>
    </thead>

      <tbody>
        <% if (@records || []).any? %>
          <% @records.each do |req| %>
            <tr>
              <td><%= req.drug.name %></td>
              <td><%= number_with_delimiter(req.quantity) %></td>
              <td><%= number_with_delimiter(req.quantity_received || 0) %></td>
              <td><%= number_with_delimiter(req.quantity_remaining) %></td>
              <td><%= l(req.created_at, format: "%d %b %Y") %>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<%= l(req.created_at, format: "%H:%M") %></td>
              <td>
                <% if req.quantity_received.to_i > 0 %>
                  <%= l(req.updated_at, format: "%d %b %Y") %>&nbsp;&nbsp;&nbsp;<%= l(req.updated_at, format: "%H:%M") %>
                <% else %>
                  -
                <% end %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="7" style="text-align: center">
              No records found
            </td>
          </tr>
        <% end %>
      </tbody>
  </table>
</div>

<div class="footer">
  <button onmousedown="window.location = '/'" class="nav-bttn green" style="margin-right: 1vw; float: right;">
    <%= t('forms.buttons.finish')%>
  </button>
</div>

<div id="keypad">
  <span class="keypad"></span>
</div>