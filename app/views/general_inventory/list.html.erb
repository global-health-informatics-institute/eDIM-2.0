<%= javascript_include_tag 'jquery.dataTables.min.js' %>

<script type="text/javascript">
  // Styling the table with datatables library
  $(document).ready(function() {
  $('#generalInventory').DataTable({
  "bLengthChange": false,
  "bDestroy": true,
  "pageLength": 10,
  "searching": false,
  "ordering": true,
  "info": true,
  "paging": true,
  "scrollX": false,
  "scrollY": false,
  "scrollCollapse": false,
  "deferRender": false,
  "dom": '<"top"f>rt<"bottom"ip><"clear">',
  "language": {
  "search": "",
  "searchPlaceholder": "Search inventory items...",
  "zeroRecords": I18n.t('forms.labels.nothing_found'),
  "info": I18n.t('forms.labels.tbl_pages'),
  "infoEmpty": "No records available",
  "infoFiltered": I18n.t('forms.labels.filtered'),
  "oPaginate": {
  "sNext": I18n.t('forms.buttons.next'),
  "sPrevious": I18n.t('forms.buttons.previous')
  }
  }
  });

  // Style the search box
  $('.dataTables_filter input').attr('placeholder', 'Search inventory items...');
  $('.dataTables_filter input').attr('style', 'font-size: 20px; padding: 12px 16px;');

  // Remove the "Search:" label
  $('.dataTables_filter label').contents().filter(function() {
  return this.nodeType === 3 && this.textContent.trim() === 'Search:';
  }).remove();

  // Setup keyboard
  search_box = $('#generalInventory').dataTable();
  search = document.getElementsByTagName("input")[0];
  if (search) {
  search.setAttribute("id","search");
  document.getElementById('search').setAttribute("onclick","showKeyboard();");
  }

  keyboard = document.getElementsByClassName("keypad")[0];
  showAlphaKeypad();

  // Initialize listener with timeout
  setTimeout(initializeListener, 3000);
  });

  function initializeListener() {
  barcode = document.getElementById("search");
  if (barcode) {
  barcode.focus();
  barcode.style.borderColor = "#4361ee";
  barcode.style.boxShadow = "0 0 0 3px rgba(66, 153, 225, 0.15)";

  timerHand = setTimeout(function () {
  if (barcode.value) {
  barcode.value = barcode.value.trim().replace(/\$/, "").replace(/\-/,"");
  }
  }, 3000);
  }
  }

  function confirmAction(url, message) {
  if (confirm(message)) {
  window.location = url;
  }
  }
</script>

<!-- Header -->
<div class="page-header">  <h1><%= @drug.name.titleize %></h1>  <h2><%= "#{t('menu.terms.category')}: #{@drug.category.titleize}" %></h2></div>

<!-- Table Container -->
<div class="table-container">
  <table id="generalInventory" class="table" width="100%" cellspacing="0">
    <thead>
      <tr>
        <th style="width: 5%; min-width: 60px; font-size: 30px;">Select</th>        <th style="width: 15%; text-align: left; padding-left: 100px; font-size: 48px;"><%= t('menu.terms.inventory_number') %></th>        <th style="width: 15%; font-size: 48px;"><%= t('menu.terms.current_quantity') %></th>        <th style="width: 15%; font-size: 48px;"><%= t('menu.terms.expiration_date') %></th>        <th style="width: 25%; font-size: 48px;"><%= t('menu.terms.actions') %></th>      </tr>
    </thead>

    <tbody>
      <% (@inventory ||[]).each do| item | %>
        <% expiration_class = ""
            if item.expiration_date
            if item.expiration_date < Date.today
            expiration_class = "expired"
            elsif item.expiration_date < Date.today + 30.days
            expiration_class = "expiring-soon"
            end
            end %>
        <tr>
          <td><input type="checkbox" class="custom-checkbox item" data-id="<%= item.gn_inventory_id %>          "></td>          <td style="text-align: left; padding-left: 112px; font-size: 42px; font-weight:800;"><%= Misc.dash_formatter(item.gn_identifier) %></td>          <td style="text-align: left; padding-left: 124px; font-size: 42px; font-weight:800; color:#38a169 "><%= number_with_delimiter(item.current_quantity) %></td>          <td class="<%= expiration_class %>          " style="text-align: center; font-size: 42px; font-weight:500; color:#4361ee;">
          <%= l(item.expiration_date, format: '%b-%Y') rescue "" %>
        </td>
        <td style="text-align: center;">
          <div style="display: table-cell;min-width: 8vw; vertical-align: middle;">
            <img style="width: 56px; height: 56px; padding-top: 1px; cursor: pointer;"
              src="/assets/damage.png"
              title="Record Damage"
              onmousedown="openStyledDamageModal(<%= item.gn_inventory_id %>, '<%= @drug.name.titleize %>', '<%= Misc.dash_formatter(item.gn_identifier) %>', <%= item.current_quantity %>)">
          </div>

          <div style="display: table-cell; min-width: 8vw;">
            <img style="" src="/assets/view_icon.png" title="View Item"
              onmousedown="window.location='/general_inventory/<%= item.gn_identifier %>/<%= item.gn_sequence %>'">
          </div>
          <div style="display: table-cell; min-width: 8vw;">
            <img style="" src="/assets/edit.png" title="Edit Item"
              onmousedown="window.location='/general_inventory/<%= item.gn_inventory_id %>/edit'">
          </div>
          <div style="display: table-cell; min-width: 8vw;">
            <img style="" src="/assets/print.png" title="Print Barcode"
              onmousedown="window.location='/print_bottle_barcode/<%= item.gn_inventory_id %>'">
          </div>
          <div style="display: table-cell; min-width: 8vw;">
            <img style="height: 62px; width: 62px;" src="/assets/delete.png" title="Void Item"
              onmousedown="confirmAction('/void_general_inventory/<%= item.gn_inventory_id %>', 'Are you sure you want to void item <%= Misc.dash_formatter(item.gn_identifier) %>?')">
          </div>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
</div>

<!-- Footer -->
<div class="footer">
  <% if !current_location.name.match(/store/i) %>
    <button onmousedown="merge()" class="nav-bttn blue" style="margin-left: 1vw; font-size: 30px !important;">
        Merge Items
    </button>
  <% else %>
    <button onmousedown="window.location = ''" class="nav-bttn blue" style="margin-right: 1vw; float: right; font-size: 30px !important;">
        Stock Card
    </button>
  <% end %>
  <button onmousedown="window.location = '/general_inventory'" class="nav-bttn green" style="margin-right: 1vw; float: right; font-size: 30px !important;">
    <%= t('forms.buttons.back') %>
  </button>
</div>

<!-- IMPROVED DAMAGE MODAL FOR TOUCHSCREENS -->
<div id="styledDamageModal"
  style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5);
  z-index:9999; align-items:center; justify-content:center;
  opacity:0; transition:opacity 0.3s ease;">

  <div id="styledDamageModalContent"
    style="width:650px; max-width:90vw; background:#fff; padding:32px; border-radius:16px;
    box-shadow:0 20px 60px rgba(0,0,0,0.3); transform:scale(0.95);
    transition:transform 0.3s ease; max-height:90vh; overflow-y:auto;">

    <!-- Header -->
    <div style="text-align:center; margin-bottom:24px; padding-bottom:16px;
      border-bottom:2px solid #e9ecef;">
      <h2 style="margin:0; font-size:2.2rem; color:#d9534f; font-weight:700;">
          Record Damage
      </h2>
    </div>

    <!-- Drug Info Card -->
    <div style="background:linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
      border:2px solid #dee2e6; padding:20px; border-radius:12px;
      margin-bottom:28px; text-align:center;">
      <div style="font-size:1.8rem; font-weight:700; color:#495057; margin-bottom:8px;">
        <span id="styledDamageDrugName" style="color:#006495;"></span>
      </div>
      <div style="display:flex; justify-content:space-between; margin-top:12px;">
        <div style="text-align:left;">
          <div style="font-size:1.2rem; color:#6c757d;">Inventory #</div>
          <div style="font-size:1.4rem; font-weight:600; color:#495057;">
            <span id="styledDamageInventoryNumber"></span>
          </div>
        </div>
        <div style="text-align:right;">
          <div style="font-size:1.2rem; color:#6c757d;">Available</div>
          <div style="font-size:1.4rem; font-weight:600; color:#28a745;">
            <span id="styledDamageMaxQuantity"></span> units
          </div>
        </div>
      </div>
    </div>

    <!-- Quantity Section -->
    <div style="margin-bottom:28px;">
      <div style="text-align:center; margin-bottom:16px;">
        <label style="font-size:1.8rem; font-weight:700; color:#495057;">
            Quantity Damaged
        </label>
      </div>

      <!-- Quantity Input with Large Controls -->
      <div style="display:flex; align-items:center; justify-content:center; gap:12px; margin-bottom:20px;">
        <button type="button" id="styledDamageDecreaseBtn"
          style="width:60px; height:60px; border:none; border-radius:12px;
          background:#dc3545; color:white; font-size:2.5rem; font-weight:700;
          cursor:pointer; display:flex; align-items:center; justify-content:center;
          box-shadow:0 4px 12px rgba(220,53,69,0.3); user-select:none;
          line-height:1; vertical-align:middle;">
            −
        </button>

        <input type="number"
          id="styled_damage_qty"
          min="0"
          value="0"
          style="width:120px; height:60px; padding:0; font-size:2.2rem; font-weight:700;
          border-radius:12px; border:3px solid #006495; outline:none;
          text-align:center; box-sizing:border-box; color:#495057;
          -moz-appearance:textfield; appearance:textfield; line-height:54px;">

        <button type="button" id="styledDamageIncreaseBtn"
          style="width:60px; height:60px; border:none; border-radius:12px;
          background:#28a745; color:white; font-size:2.5rem; font-weight:700;
          cursor:pointer; display:flex; align-items:center; justify-content:center;
          box-shadow:0 4px 12px rgba(40,167,69,0.3); user-select:none;
          line-height:1; vertical-align:middle;">
            +
        </button>
      </div>

      <!-- Quick Select Buttons -->
      <div style="display:grid; grid-template-columns:repeat(4, 1fr); gap:12px; margin-bottom:16px;">
        <button type="button" class="styled-quick-select-btn" data-value="0"
          onclick="setStyledQuickSelectValue(0)"
          style="padding:16px 8px; border:2px solid #dee2e6; border-radius:10px;
          background:#f8f9fa; color:#495057; font-size:1.4rem; font-weight:600;
          cursor:pointer; min-height:55px; user-select:none;
          display:flex; align-items:center; justify-content:center;
          line-height:1; vertical-align:middle;">
            0
        </button>
        <button type="button" class="styled-quick-select-btn" data-value="10"
          onclick="setStyledQuickSelectValue(10)"
          style="padding:16px 8px; border:2px solid #dee2e6; border-radius:10px;
          background:#f8f9fa; color:#495057; font-size:1.4rem; font-weight:600;
          cursor:pointer; min-height:55px; user-select:none;
          display:flex; align-items:center; justify-content:center;
          line-height:1; vertical-align:middle;">
            10
        </button>
        <button type="button" class="styled-quick-select-btn" data-value="100"
          onclick="setStyledQuickSelectValue(100)"
          style="padding:16px 8px; border:2px solid #dee2e6; border-radius:10px;
          background:#f8f9fa; color:#495057; font-size:1.4rem; font-weight:600;
          cursor:pointer; min-height:55px; user-select:none;
          display:flex; align-items:center; justify-content:center;
          line-height:1; vertical-align:middle;">
            100
        </button>
        <button type="button" class="styled-quick-select-btn" data-value="1000"
          onclick="setStyledQuickSelectValue(1000)"
          style="padding:16px 8px; border:2px solid #dee2e6; border-radius:10px;
          background:#f8f9fa; color:#495057; font-size:1.4rem; font-weight:600;
          cursor:pointer; min-height:55px; user-select:none;
          display:flex; align-items:center; justify-content:center;
          line-height:1; vertical-align:middle;">
            1000
        </button>
      </div>

      <!-- Clear Button -->
      <div style="text-align:center;">
        <button type="button" id="styledDamageClearBtn"
          style="padding:12px 24px; border:2px solid #6c757d; border-radius:10px;
          background:white; color:#6c757d; font-size:1.3rem; font-weight:600;
          cursor:pointer; user-select:none;
          display:inline-flex; align-items:center; justify-content:center;
          line-height:1; vertical-align:middle; min-height:48px;">
            Clear
        </button>
      </div>
    </div>

    <!-- Reason Section -->
    <div style="margin-bottom:32px;">
      <label style="display:block; text-align:center; margin-bottom:12px;
        font-size:1.8rem; font-weight:700; color:#495057;">
          Reason for Damage
      </label>
      <select id="styled_damage_reason"
        style="width:100%; padding:16px 60px 16px 16px; font-size:1.6rem; border-radius:12px;
        border:3px solid #006495; outline:none; background:white;
        color:#495057; font-weight:600; min-height:60px;
        background-image:linear-gradient(45deg, transparent 50%, #495057 50%), linear-gradient(135deg, #495057 50%, transparent 50%);
        background-position:calc(100% - 25px) calc(1em + 2px), calc(100% - 20px) calc(1em + 2px);
        background-size:5px 5px, 5px 5px;
        background-repeat:no-repeat;
        -webkit-appearance:none;
        -moz-appearance:none;
        appearance:none;">
        <option value="broken">Broken / Dropped</option>
        <option value="expired">Expired</option>
        <option value="contaminated">Contaminated</option>
        <option value="other">Other</option>
      </select>
    </div>

    <!-- Action Buttons -->
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
      <button onclick="submitStyledDamage()"
        style="padding:18px 24px; border:none; border-radius:12px;
        background:#d9534f; color:white; font-size:1.6rem; font-weight:700;
        cursor:pointer; min-height:65px; user-select:none;
        box-shadow:0 6px 20px rgba(217,83,79,0.3);
        display:flex; align-items:center; justify-content:center;
        line-height:1; vertical-align:middle;">
          Log Damage
      </button>

      <button onclick="closeStyledDamageModal()"
        style="padding:18px 24px; border:2px solid #6c757d; border-radius:12px;
        background:white; color:#6c757d; font-size:1.6rem; font-weight:700;
        cursor:pointer; min-height:65px; user-select:none;
        display:flex; align-items:center; justify-content:center;
        line-height:1; vertical-align:middle;">
          Cancel
      </button>
    </div>

  </div>
</div>
<div id="damageModal"
  style="display:none; position:fixed; top:20vh; left:25vw; width:50vw;
  background:white; border:3px solid #000; padding:2vw; z-index:9999;">
  <h2>Record Damage</h2>
  <label>Quantity:</label><br>
  <input type="number" id="damage_qty" min="1" style="width: 15vw;"><br><br>
  <label>Reason:</label><br>
  <input type="text" id="damage_reason" style="width: 30vw;"><br><br>
  <button class="nav-bttn green" onmousedown="submitDamage()">Save</button>
  <button class="nav-bttn red" onmousedown="closeDamageModal()">Cancel</button>
  <input type="hidden" id="damage_item_id">
</div>

</div>

<%= form_for :general_inventory, :url => "/general_inventory/merge" do |f| %>
  <input type="hidden" name="bottle_ids" id="bottle_ids" value=""/>
<% end %>

<script type="text/javascript">
  function merge()
  {
  var choices = [];
  var transactions = document.getElementsByClassName('custom-checkbox item');

  for(var o = 0; o < transactions.length; o++){
  if(transactions[o].checked == true){
  choices.push(transactions[o].getAttribute('data-id'));
  }
  }
  if(choices.length > 1)
  {
  document.getElementById("bottle_ids").value = choices.join(',');
  confirmForAction('submitMerge()', 'Are you sure you want to merge these items?')
  }

  return choices;
  }

  function submitMerge()
  {
  document.forms[0].submit();
  }

  // DAMAGE MODAL FUNCTIONS
  function openStyledDamageModal(itemId, drugName, inventoryNumber, maxQuantity) {
  // Set modal data
  document.getElementById("styledDamageDrugName").textContent = drugName || '';
  document.getElementById("styledDamageInventoryNumber").textContent = inventoryNumber || '';
  document.getElementById("styledDamageMaxQuantity").textContent = maxQuantity || 'N/A';

  // Set max quantity if provided
  const qtyInput = document.getElementById('styled_damage_qty');
  if (maxQuantity) {
  qtyInput.max = maxQuantity;
  qtyInput.setAttribute('max', maxQuantity);
  }

  // Store item ID in a data attribute
  qtyInput.setAttribute('data-item-id', itemId);

  // Show modal with animation
  const modal = document.getElementById('styledDamageModal');
  const content = document.getElementById('styledDamageModalContent');

  modal.style.display = 'flex';
  setTimeout(() => {
  modal.style.opacity = '1';
  content.style.transform = 'scale(1)';
  }, 10);

  // Setup quantity controls
  setupStyledDamageModalQuantityControls();

  // Initialize quick select buttons
  updateStyledQuickSelectButtons();

  // Focus on quantity input
  setTimeout(() => {
  qtyInput.focus();
  qtyInput.select();
  }, 100);
  }

  function submitStyledDamage() {
  const qtyInput = document.getElementById('styled_damage_qty');
  const itemId = qtyInput.getAttribute('data-item-id');
  const qty = qtyInput.value;
  const reason = document.getElementById('styled_damage_reason').value;
  const drugName = document.getElementById('styledDamageDrugName').textContent;

  if (!itemId) {
  alert("Error: Item ID not found");
  return;
  }

  if (qty === "" || qty < 0) { // Changed from qty <= 0
  alert("Please enter a valid quantity (0 or greater)");
  return;
  }

  if (parseInt(qty) === 0) { // Added check for 0
  if (!confirm("You're reporting 0 damages. Are you sure you want to continue?")) {
  return;
  }
  }

  if (!reason) {
  alert("Please select a reason for the damage");
  return;
  }

  // Check if quantity exceeds max
  const maxQty = parseInt(qtyInput.max, 10);
  if (!isNaN(maxQty) && parseInt(qty, 10) > maxQty) {
  alert(`Quantity cannot exceed maximum available: ${maxQty}`);
  return;
  }

  // Close the damage modal first, then show confirmation
  closeStyledDamageModal();

  // Small delay to ensure modal is closed, then show confirmation
  setTimeout(() => {
  showConfirmationModal(qty, drugName, reason, itemId);
  }, 300);
  }

  // Quick select buttons for damage modal
  function updateStyledQuickSelectButtons() {
  const buttons = document.querySelectorAll('.styled-quick-select-btn');
  const input = document.getElementById('styled_damage_qty');
  if (!buttons.length || !input) return;

  const maxAllowed = parseInt(input.max, 10) || Infinity;
  const currentValue = parseInt(input.value, 10) || 0;

  buttons.forEach(btn => {
  const value = parseInt(btn.dataset.value, 10);

  // Check if button value exceeds current max
  if (value > maxAllowed) {
  disableStyledQuickButton(btn);
  } else {
  enableStyledQuickButton(btn);

  // Highlight if this button matches current input value
  if (value === currentValue) {
  btn.style.background = '#006495';
  btn.style.borderColor = '#006495';
  btn.style.color = 'white';
  btn.style.boxShadow = '0 4px 12px rgba(0, 100, 149, 0.4)';
  btn.style.transform = 'translateY(-2px)';
  } else {
  btn.style.background = '#f8f9fa';
  btn.style.borderColor = '#dee2e6';
  btn.style.color = '#495057';
  btn.style.boxShadow = 'none';
  btn.style.transform = 'translateY(0)';
  }
  }
  });
  }

  function setStyledQuickSelectValue(value) {
  const input = document.getElementById('styled_damage_qty');
  if (!input) return;

  const max = parseInt(input.max, 10) || Infinity;
  const currentValue = parseInt(input.value, 10) || 0;

  // If clicking the same button that's currently selected, add to the value
  // Otherwise, set the value directly
  let newValue;
  if (currentValue > 0 && currentValue % value === 0) {
  // Current value is a multiple of the button value, so add to it
  newValue = currentValue + value;
  } else {
  // Set to the button value directly
  newValue = value;
  }

  // Respect the maximum limit
  if (newValue <= max) {
  input.value = newValue;
  } else {
  // If adding would exceed max, set to max
  input.value = max;
  }

  // Update button highlights
  updateStyledQuickSelectButtons();
  }

  function disableStyledQuickButton(btn) {
  btn.disabled = true;
  btn.style.opacity = '0.3';
  btn.style.cursor = 'not-allowed';
  btn.style.pointerEvents = 'none';
  btn.style.background = '#e9ecef';
  btn.style.borderColor = '#dee2e6';
  btn.style.color = '#6c757d';
  }

  function enableStyledQuickButton(btn) {
  btn.disabled = false;
  btn.style.opacity = '1';
  btn.style.cursor = 'pointer';
  btn.style.pointerEvents = 'auto';
  }

  // Function to update button highlights based on current value
  function updateStyledQuickSelectButtonHighlight(selectedValue) {
  const buttons = document.querySelectorAll('.styled-quick-select-btn');
  const input = document.getElementById('styled_damage_qty');
  if (!buttons.length || !input) return;

  const currentValue = parseInt(input.value, 10) || 0;

  buttons.forEach(btn => {
  const buttonValue = parseInt(btn.dataset.value, 10);

  // Skip if button is disabled
  if (btn.disabled) return;

  // Highlight if this button matches the current input value
  if (buttonValue === currentValue) {
  btn.style.background = '#006495';
  btn.style.borderColor = '#006495';
  btn.style.color = 'white';
  btn.style.boxShadow = '0 4px 12px rgba(0, 100, 149, 0.4)';
  btn.style.transform = 'translateY(-2px)';
  } else {
  btn.style.background = '#f8f9fa';
  btn.style.borderColor = '#dee2e6';
  btn.style.color = '#495057';
  btn.style.boxShadow = 'none';
  btn.style.transform = 'translateY(0)';
  }
  });
  }

  // Show confirmation modal before submitting
  function showConfirmationModal(quantity, drugName, reason, itemId) {
  // Create confirmation modal
  const confirmationModal = document.createElement('div');
  confirmationModal.id = 'confirmationModal';
  confirmationModal.style.cssText = `
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.45);
  z-index: 10001;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.25s ease;
  `;

  confirmationModal.innerHTML = `
<div id="confirmationModalContent"
  style="
  width: 500px;
  background: #fff;
  padding: 28px;
  border-radius: 14px;
  box-shadow: 0 12px 40px rgba(0,0,0,0.25);
  transform: scale(0.92);
  transition: transform 0.25s ease;
  ">
  <!-- Header -->
  <div style="display:flex; justify-content:center; align-items:center; margin-bottom:20px;">
    <h2 style="margin:0; font-size:1.8rem; color:#d9534f; font-weight:700; text-align:center;">
        Confirm Damage Report
    </h2>
  </div>

  <!-- Message -->
  <div style="
    background: #f1f3f5;
    border: 1px solid #d7dde3;
    padding: 20px;
    border-radius: 10px;
    margin-bottom: 28px;
    text-align: center;
    font-size: 1.4rem;
    line-height: 1.5;
    ">
    <p style="margin:0; font-weight:600;">
        Report <span style="color:#d9534f; font-size:1.6rem;">${quantity}</span> units of
    </p>
    <p style="margin:10px 0 0 0; color:#006495; font-size:1.5rem; font-weight:600;">
        ${drugName}
    </p>
  </div>

  <!-- Buttons -->
  <div style="display:flex; justify-content:center; gap:16px;">
    <button onclick="processDamageSubmission(${itemId}, ${quantity}, '${reason}')"
      style="
      padding: 14px 28px;
      border: none;
      border-radius: 8px;
      background: #28a745;
      color: #fff;
      font-size: 1.3rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
      min-width: 140px;
      height: 55px;
      display: flex;
      align-items: center;
      justify-content: center;
      line-height: 1;
      "
      onmouseover="this.style.transform='translateY(-2px)'; this.style.background='#218838'"
      onmouseout="this.style.transform='translateY(0)'; this.style.background='#28a745'">
        OKAY
    </button>

    <button onclick="closeConfirmationModalAndReopenDamageModal()"
      style="
      padding: 14px 28px;
      border: none;
      border-radius: 8px;
      background: #6c757d;
      color: #fff;
      font-size: 1.3rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
      min-width: 140px;
      height: 55px;
      display: flex;
      align-items: center;
      justify-content: center;
      line-height: 1;
      "
      onmouseover="this.style.transform='translateY(-2px)'; this.style.background='#5a6268'"
      onmouseout="this.style.transform='translateY(0)'; this.style.background='#6c757d'">
        CANCEL
    </button>
  </div>
</div>
</div>
  `;

  // Add to page
  document.body.appendChild(confirmationModal);

  // Animate in
  setTimeout(() => {
  confirmationModal.style.opacity = '1';
  const modalContent = document.getElementById('confirmationModalContent');
  modalContent.style.transform = 'scale(1)';
  }, 10);
  }

  function reopenStyledDamageModal() {
  // We need to preserve the original values
  const qtyInput = document.getElementById('styled_damage_qty');
  const reasonSelect = document.getElementById('styled_damage_reason');

  // Store current values before reopening
  const currentQty = qtyInput.value;
  const currentReason = reasonSelect.value;
  const itemId = qtyInput.getAttribute('data-item-id');
  const drugName = document.getElementById('styledDamageDrugName').textContent;
  const inventoryNumber = document.getElementById('styledDamageInventoryNumber').textContent;
  const maxQuantity = document.getElementById('styledDamageMaxQuantity').textContent;

  // Reopen modal with preserved values
  const modal = document.getElementById('styledDamageModal');
  const content = document.getElementById('styledDamageModalContent');

  modal.style.display = 'flex';
  setTimeout(() => {
  modal.style.opacity = '1';
  content.style.transform = 'scale(1)';
  }, 10);

  // Restore values
  qtyInput.value = currentQty;
  reasonSelect.value = currentReason;

  // Setup quantity controls
  setupStyledDamageModalQuantityControls();

  // Initialize quick select buttons
  updateStyledQuickSelectButtons();

  // Focus on quantity input
  setTimeout(() => {
  qtyInput.focus();
  qtyInput.select();
  }, 100);
  }

  // Reopen the damage modal with preserved values
  function reopenStyledDamageModal() {
  // We need to preserve the original values
  const qtyInput = document.getElementById('styled_damage_qty');
  const reasonSelect = document.getElementById('styled_damage_reason');

  // Store current values before reopening
  const currentQty = qtyInput.value;
  const currentReason = reasonSelect.value;
  const itemId = qtyInput.getAttribute('data-item-id');
  const drugName = document.getElementById('styledDamageDrugName').textContent;
  const inventoryNumber = document.getElementById('styledDamageInventoryNumber').textContent;
  const maxQuantity = document.getElementById('styledDamageMaxQuantity').textContent;

  // Reopen modal with preserved values
  const modal = document.getElementById('styledDamageModal');
  const content = document.getElementById('styledDamageModalContent');

  modal.style.display = 'flex';
  setTimeout(() => {
  modal.style.opacity = '1';
  content.style.transform = 'scale(1)';
  }, 10);

  // Restore values
  qtyInput.value = currentQty;
  reasonSelect.value = currentReason;

  // Setup quantity controls
  setupStyledDamageModalQuantityControls();

  // Focus on quantity input
  setTimeout(() => {
  qtyInput.focus();
  qtyInput.select();
  }, 100);
  }

  // Close confirmation modal
  function closeConfirmationModal() {
  const confirmationModal = document.getElementById('confirmationModal');
  if (confirmationModal) {
  confirmationModal.style.opacity = '0';
  const modalContent = document.getElementById('confirmationModalContent');
  if (modalContent) {
  modalContent.style.transform = 'scale(0.9)';
  }

  setTimeout(() => {
  if (confirmationModal.parentNode) {
  confirmationModal.parentNode.removeChild(confirmationModal);
  }
  }, 300);
  }
  }

  // Process the actual damage submission after confirmation
  function processDamageSubmission(itemId, quantity, reason) {
  // Close confirmation modal
  closeConfirmationModal();

  // Prepare data
  var postData = {
  quantity: quantity,
  reason: reason,
  damage_type: 'bottle'
  };

  // Show "processing" notification
  showProcessingNotification();

  $.post(`/general_inventory/${itemId}/damage_item`,
  postData,
  function(resp) {
  // Remove processing notification
  removeProcessingNotification();

  if (resp.success) {
  // Show success message
  showSuccessNotification("Damage Recorded Successfully!");

  // Reload after delay
  setTimeout(() => {
  location.reload();
  }, 2500);
  } else {
  alert(resp.message || "An error occurred");
  }
  }
  ).fail(function(xhr, status, error) {
  // Remove processing notification
  removeProcessingNotification();

  alert("An error occurred while submitting the damage.");
  console.error("Damage submission error:", error);
  });
  }

  // Show processing notification
  function showProcessingNotification() {
  const processingNotification = document.createElement('div');
  processingNotification.id = 'processing-notification';
  processingNotification.style.cssText = `
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(0, 0, 0, 0.8);
  color: white;
  padding: 20px 40px;
  border-radius: 10px;
  z-index: 10002;
  font-size: 1.8rem;
  font-weight: 600;
  text-align: center;
  animation: fadeIn 0.3s ease-out;
  `;
  processingNotification.innerHTML = `
<div style="margin-bottom: 10px; font-size: 2.5rem;">⏳</div>
  Processing...
  `;

  document.body.appendChild(processingNotification);
  }

  // Remove processing notification
  function removeProcessingNotification() {
  const processingNotification = document.getElementById('processing-notification');
  if (processingNotification && processingNotification.parentNode) {
  processingNotification.parentNode.removeChild(processingNotification);
  }
  }

  // Helper function to show success notification without blocking
  function showSuccessNotification(message) {
  // Remove any existing notification
  const existingNotification = document.getElementById('success-notification');
  if (existingNotification) {
  existingNotification.parentNode.removeChild(existingNotification);
  }

  // Create a notification div
  const notification = document.createElement('div');
  notification.style.cssText = `
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: #28a745;
  color: white;
  padding: 30px 50px;
  border-radius: 12px;
  box-shadow: 0 8px 30px rgba(0,0,0,0.3);
  z-index: 10003;
  font-size: 2rem;
  font-weight: 700;
  text-align: center;
  min-width: 400px;
  max-width: 600px;
  border: 4px solid rgba(255,255,255,0.3);
  animation: fadeIn 0.3s ease-out;
  `;
  notification.textContent = message;
  notification.id = 'success-notification';

  // Checkmark
  const checkmark = document.createElement('div');
  checkmark.style.cssText = `
  font-size: 3.5rem;
  margin-bottom: 15px;
  `;
  checkmark.textContent = '✓';
  notification.insertBefore(checkmark, notification.firstChild);

  // Add to page
  document.body.appendChild(notification);

  // Auto-remove
  setTimeout(() => {
  if (notification.parentNode) {
  notification.style.opacity = '0';
  notification.style.transform = 'translate(-50%, -50%) scale(0.9)';
  notification.style.transition = 'all 0.3s ease-out';

  setTimeout(() => {
  if (notification.parentNode) {
  notification.parentNode.removeChild(notification);
  }
  }, 300);
  }
  }, 2300);
  }

  function closeStyledDamageModal() {
  const modal = document.getElementById('styledDamageModal');
  const content = document.getElementById('styledDamageModalContent');

  // Animate out
  modal.style.opacity = '0';
  content.style.transform = 'scale(0.9)';

  // Remove after animation
  setTimeout(() => {
  modal.style.display = 'none';
  // Reset form
  document.getElementById('styled_damage_qty').value = '0';
  document.getElementById('styled_damage_reason').value = 'broken';
  }, 300);
  }

  // Quantity controls for the modal
  function setupStyledDamageModalQuantityControls() {
  const input = document.getElementById('styled_damage_qty');
  const increaseBtn = document.getElementById('styledDamageIncreaseBtn');
  const decreaseBtn = document.getElementById('styledDamageDecreaseBtn');
  const clearBtn = document.getElementById('styledDamageClearBtn');

  if (!input || !increaseBtn || !decreaseBtn || !clearBtn) return;

  let holdTimeout = null;
  let repeatTimeout = null;
  let isHolding = false;
  let holdDirection = 0;

  // Function to adjust quantity with bounds checking
  function adjustStyledDamageQuantity(amount) {
  if (!input) return;

  let current = parseInt(input.value, 10);
  if (isNaN(current)) current = 0;

  let max = parseInt(input.max, 10);
  if (isNaN(max)) max = Infinity;

  let min = 0; // Changed from 1 to 0

  let newValue = current + amount;

  if (newValue < min) newValue = min;
  if (newValue > max) newValue = max;

  input.value = newValue;

  // Update button highlights
  updateStyledQuickSelectButtonHighlight(newValue);
  }

  // Hold functionality
  function startPress(direction) {
  holdDirection = direction;
  holdTimeout = setTimeout(() => {
  isHolding = true;
  repeatHold();
  }, 180);
  }

  function repeatHold() {
  if (!isHolding) return;
  adjustStyledDamageQuantity(holdDirection);
  repeatTimeout = setTimeout(repeatHold, 80);
  }

  function endPress() {
  clearTimeout(holdTimeout);
  clearTimeout(repeatTimeout);
  const wasHold = isHolding;
  isHolding = false;
  return wasHold;
  }

  function bindButton(btn, delta) {
  btn.addEventListener('mousedown', () => startPress(delta));
  btn.addEventListener('mouseup', () => {
  const held = endPress();
  if (!held) adjustStyledDamageQuantity(delta);
  });
  btn.addEventListener('mouseleave', endPress);
  btn.addEventListener('touchstart', e => {
  e.preventDefault();
  startPress(delta);
  });
  btn.addEventListener('touchend', () => {
  const held = endPress();
  if (!held) adjustStyledDamageQuantity(delta);
  });
  }

  bindButton(increaseBtn, +1);
  bindButton(decreaseBtn, -1);

  clearBtn.addEventListener('click', () => {
  input.value = 0;
  updateStyledQuickSelectButtonHighlight(0);
  });

  // Add event listener to input field to update highlights when typing
  input.addEventListener('input', function() {
  const value = parseInt(this.value, 10);
  if (!isNaN(value)) {
  updateStyledQuickSelectButtonHighlight(value);
  }
  });

  // Initialize quick select buttons
  updateStyledQuickSelectButtons();
  }

  // Close modal on escape key
  document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
  closeStyledDamageModal();
  }
  });

  // Damage modal functions
  function openDamageModal(id) {
  document.getElementById("damage_item_id").value = id;
  document.getElementById("damageModal").style.display = 'block';
  }

  function closeDamageModal() {
  document.getElementById("damageModal").style.display = 'none';
  }

  function submitDamage() {
  var id = document.getElementById("damage_item_id").value;
  var qty = document.getElementById("damage_qty").value;
  var reason = document.getElementById("damage_reason").value;

  $.post(`/general_inventory/${id}/damage_item`,
  { quantity: qty, reason: reason },
  function(resp) {
  if (resp.success) {
  alert("Damage recorded successfully");
  location.reload();
  } else {
  alert(resp.message);
  }
  }
  );
  }
</script>

