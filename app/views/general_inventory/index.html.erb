<%= javascript_include_tag 'jquery.dataTables.min.js' %>

<script type="text/javascript">
  // Styling the table with datatables library
  $(document).ready(function() {
    // Initialize DataTable
    $('#generalInventory').DataTable({
      "bLengthChange": false,
      "bDestroy": true,
      "pageLength": 5,
      "searching": true,
      "ordering": true,
      "info": true,
      "paging": true,
      "scrollX": false,
      "scrollY": false,
      "scrollCollapse": false,
      "deferRender": false,
      "dom": '<"top"f>rt<"bottom"ip><"clear">',
      "language": {
        "search": "",
        "searchPlaceholder": "Search inventory...",
        "lengthMenu": "Display _MENU_ records per page",
        "zeroRecords": I18n.t('forms.labels.nothing_found'),
        "info": I18n.t('forms.labels.tbl_pages'),
        "infoEmpty": "No records available",
        "infoFiltered": I18n.t('forms.labels.filtered'),
        "oPaginate": {
          "sNext": I18n.t('forms.buttons.next'),
          "sPrevious": I18n.t('forms.buttons.previous')
        }
      },
      "initComplete": function() {
        $('#generalInventory tbody tr').each(function() {
          var quantityCell = $(this).find('td').eq(2);
          var quantityText = quantityCell.text().replace(/,/g, '');
          var quantity = parseInt(quantityText);
          
          if (!isNaN(quantity)) {
            if (quantity >= 100) {
              quantityCell.addClass('quantity-high');
            } else if (quantity >= 20) {
              quantityCell.addClass('quantity-medium');
            } else if (quantity < 20) {
              quantityCell.addClass('quantity-low');
            }
          }
        });
      }
    });

    // Style the search box
    $('.dataTables_filter input').attr('placeholder', 'Search inventory...');
    $('.dataTables_filter input').attr('style', 'font-size: 24px; padding: 14px 18px;');
    
    // Remove the "Search:" label that DataTables adds
    $('.dataTables_filter label').contents().filter(function() {
      return this.nodeType === 3 && this.textContent.trim() === 'Search:';
    }).remove();
    
    // Setup keyboard
    search_box = $('#generalInventory').dataTable();
    search = document.getElementsByTagName("input")[0];
    if (search) {
      search.setAttribute("id","search");
      document.getElementById('search').setAttribute("onclick","showKeyboard();");
    }
    
    keyboard = document.getElementsByClassName("keypad")[0];
    showAlphaKeypad();
    
    // Initialize listener with timeout
    setTimeout(initializeListener, 3000);
  });

  function initializeListener() {
    barcode = document.getElementById("search");
    if (barcode) {
      barcode.focus();
      barcode.style.borderColor = "#006495";
      barcode.style.boxShadow = "0 0 0 3px rgba(0, 100, 149, 0.18)";
      
      timerHand = setTimeout(function () {
        if (barcode.value) {
          barcode.value = barcode.value.trim().replace(/\$/, "").replace(/\-/,"");
        }
      }, 3000);
    }
  }
</script>

<div class="page-header">
  <h1><%= "#{t('menu.terms.inventory')} (#{current_location.name})"%></h1>
</div>

<div class="table-container" style="height: 78vh !important;">
  <table id="generalInventory" class="table" style="width: 100%;" cellspacing="0">
    <thead>
      <tr>
        <th style="font-size: 48px !important; width: 30% !important;"><%= t('menu.terms.item') %></th>
        <th style="font-size: 48px !important; width: 20% !important;"><%= t('menu.terms.category') %></th>
        <th style="width: 20%; font-size: 48px !important;"><%= t('menu.terms.current_quantity') %></th>
        <th style="width: 15%; font-size: 48px !important;"><%= t('menu.terms.actions') %></th>
      </tr>
    </thead>

    <tbody>
      <% (@inventory || []).each do |item| %>
        <tr>
          <td><%= item.drug_name.titleize rescue "" %></td>
          <td style="text-align: right; padding-right: 20px; text-align: left; padding-left: 42px;"><%= item.drug_category_name %></td>
          <td style="text-align: right; padding-right: 20px; text-align: left; padding-left: 76px;"><%= number_with_delimiter(item.current_quantity) %></td>
          <td style="text-align: center;">
            <button class="action-btn" onmousedown="window.location='/general_inventory/list?drug_id=<%= item.drug_id %>'"
                    title="View item details">
              View
            </button>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="footer">
  <button onclick="window.history.back()" class="nav-bttn red" style="font-size: 30px !important;">
    Back
  </button>
  <div class="footer-actions">
    <button onclick="window.location='/dispensary/new?add_mode=true'" class="nav-bttn blue" style="font-size: 30px !important;">
      Add Item
    </button>
    <button onclick="window.location = '/'" class="nav-bttn green" style="font-size: 30px !important;">
      <%= t('forms.buttons.finish')%>
    </button>
  </div>
</div>

<div id="keypad" style="left:320px; top:650px; position:fixed; z-index:2000; width:67%">
  <span class="keypad"></span>
</div>

<style>
  /* Keyboard buttons */
  #keypad .keyboardButton {
    font-size: 36px !important;
    color: #2d3748 !important;
  }
  #keypad .keyboardButton,
  #keypad .keyboardButton span {
  color: #ffffff !important;
  }
#keypad {     
  background: #989a9c;   
}
  /* special buttons */
#keypad .keyboardButton#backspace,
#keypad .keyboardButton#Space,
#keypad .keyboardButton#clear,
#keypad .keyboardButton#cancel {
  min-width: 145px !important;
}
</style>

<style type="text/css">
  /* Dispensary inventory view styles */

  body {
    font-family: "Nimbus Sans L", "Arial Narrow", sans-serif;
    background: #f8f9fa;
    margin: 0;
    padding: 0;
  }

  /* Header */
  .page-header {
    background: #006495;
    color: white;
    padding: 20px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
  }

  .page-header h1 {
    margin: 0;
    font-size: 42px;
    font-weight: bold;
    text-shadow: none;
  }

  /* Table container */
  .table-container {
    height: 75vh;
    overflow: auto;
    width: 98vw;
    margin: 10px auto;
    background: white;
    border: 1px solid #d8dde2;
    border-radius: 0;
    box-shadow: none;
  }

  /* Table styling */
  #generalInventory {
    width: 100%;
    border-collapse: collapse;
  }

  #generalInventory thead {
    background: #006495;
    position: sticky;
    top: 0;
    z-index: 10;
  }

  #generalInventory thead th {
    font-size: 42px !important;
    font-weight: bold;
    padding: 18px 14px;
    text-align: left;
    color: #ffffff;
    border-bottom: 3px solid #004d73;
    white-space: nowrap;
  }

  #generalInventory tbody tr {
    border-bottom: 1px solid #e2e8f0;
    transition: background-color 0.2s;
  }

  #generalInventory tbody tr:hover {
    background-color: #f1f5f9;
  }

  #generalInventory tbody tr:nth-child(even) {
    background-color: #f8fafc;
  }

  #generalInventory tbody tr:nth-child(even):hover {
    background-color: #f1f5f9;
  }

  #generalInventory tbody td {
    font-size: 42px;
    padding: 16px 14px;
    color: #4a5568;
    vertical-align: middle;
  }

  #generalInventory tbody td:first-child {
    font-weight: 500;
    color: #2d3748;
  }

  /* Category */
  #generalInventory tbody td:nth-child(2) {
    font-weight: 500;
    color: #006495;
  }

  /* Quantity */
  #generalInventory tbody td:nth-child(3) {
    text-align: right;
    font-weight: bold;
    font-family: 'Courier New', monospace;
    color: #2d3748;
    padding-right: 24px;
  }

  /* Quantity status  */
  .quantity-high {
    color: #38a169 !important;
  }

  .quantity-medium {
    color: #d69e2e !important;
  }

  .quantity-low {
    color: #e53e3e !important;
    font-weight: bold !important;
  }

  /* Action button styling */
  .action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #006495;
    color: white;
    border: none;
    border-radius: 3px;
    padding: 12px 20px;
    font-size: 32px !important;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    transition: background-color 0.2s;
    min-height: 50px;
    min-width: 100px;
  }

  .action-btn:hover {
    background: #004d73;
  }

  /* Footer styling */
  .footer {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: #333333;
    padding: 15px 0px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: none;
    z-index: 100;
  }

  .footer .nav-bttn.red {
    margin-left: 24px;
  }

  .footer-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-right: 24px;
  }

  /* Search input */
  .dataTables_filter {
    padding: 10px 15px;
  }
  
  .dataTables_filter label {
    display: flex;
    align-items: center;
    font-size: 48px !important;
  }
  
  .dataTables_filter input {
    margin-top: 0;
    font-size: 42px;
    padding: 14px 18px;
    border: 2px solid #cbd5e0;
    border-radius: 8px;
    width: 400px;
    max-width: 100%;
    flex-grow: 1;
  }

  .dataTables_filter input:focus {
    outline: none;
    border-color: #006495;
    box-shadow: 0 0 0 3px rgba(0, 100, 149, 0.18);
  }

  /* Pagination  */
  .dataTables_paginate {
    font-size: 18px;
  }
  
  .dataTables_paginate .paginate_button {
    padding: 12px 18px;
    margin: 0 6px;
    border: 1px solid #cbd5e0;
    border-radius: 6px;
    font-size: 18px;
    color: #4a5568;
    background: white;
    cursor: pointer;
    min-height: 48px;
    min-width: 48px;
  }

  .dataTables_paginate .paginate_button:hover {
    background: #006495;
    color: white;
    border-color: #006495;
  }

  .dataTables_paginate .paginate_button.current {
    background: #006495;
    color: white;
    border-color: #006495;
    font-weight: 700;
  }

  /* Info text */
  .dataTables_info {
    font-size: 28px !important;
    color: #718096;
    padding: 14px 0;
    font-weight: 500;
  }

  /* Scrollbar */
  .table-container::-webkit-scrollbar {
    width: 10px;
  }

  .table-container::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 4px;
  }

  .table-container::-webkit-scrollbar-thumb {
    background: #c1c1c1;
    border-radius: 4px;
  }

  .table-container::-webkit-scrollbar-thumb:hover {
    background: #a8a8a8;
  }

  /* Responsiveness */
  @media (max-width: 768px) {
    .table-container {
      width: 100vw;
      margin: 5px 0;
    }
    
    .footer {
      flex-direction: column;
      gap: 15px;
      padding: 15px;
      position: relative;
    }

    .footer-actions {
      width: 100%;
      margin-right: 0;
      flex-direction: column;
    }

    .footer .nav-bttn.red {
      margin-left: 0;
    }
    
    .footer .nav-bttn {
      width: 100%;
      min-width: 100%;
      font-size: 24px;
      padding: 12px 20px;
    }
    
    .dataTables_filter input {
      width: 100%;
      font-size: 22px;
    }
    
    #generalInventory thead th {
      font-size: 48px !important;
      padding: 14px 10px;
    }
    
    #generalInventory tbody td {
      font-size: 48px !important;
      padding: 12px 10px;
    }
    
    .action-btn {
      font-size: 22px;
      padding: 10px 16px;
    }
    
    .dataTables_paginate .paginate_button {
      font-size: 18px;
      padding: 10px 14px;
      margin: 0 4px;
    }
  }

</style>
