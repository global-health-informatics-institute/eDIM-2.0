    <script>

      // normalizedDrugToCategory
      function findCategoryIdForTyped(input) {
      console.log(`findCategoryIdForTyped: "${input}"`);
      const k = String(input || '').trim().toLowerCase();
      if (!k) return null;

      if (normalizedDrugToCategory[k]) {
      console.log(`EXACT match: "${k}" → ${normalizedDrugToCategory[k]}`);
      return normalizedDrugToCategory[k];
      }

      const found = Object.keys(normalizedDrugToCategory).find(x => x.startsWith(k));
      if (found) {
      console.log(`PARTIAL match: "${k}" → "${found}" → ${normalizedDrugToCategory[found]}`);
      return normalizedDrugToCategory[found];
      }

      console.log(`No match for "${k}"`);
      return null;
      }

      function filterCategories() {
      console.log(`filterCategories called`);
      const searchInput = document.getElementById('category_search');
      if (!searchInput) {
      console.error('category_search input not found');
      return;
      }

      const searchTerm = searchInput.value.toLowerCase().trim();
      console.log(`Processing search: "${searchTerm}"`);

      const categoryItems = document.querySelectorAll('li[source_id="drug_category"]');
      console.log(`Found ${categoryItems.length} category items`);

      const drugCatId = findCategoryIdForTyped(searchTerm);
      if (drugCatId) {
      const catName = getCategoryNameById(drugCatId);
      console.log(`DRUG MATCH FOUND: "${searchTerm}" → ${drugCatId} → "${catName}"`);

      categoryItems.forEach(item => {
      item.style.display = 'none';
      });

      categoryItems.forEach(item => {
      const categoryTextDiv = item.querySelector('div[style*="table-cell"]:last-child');
      if (!categoryTextDiv) return;

      const originalCatText = categoryTextDiv.textContent.trim();
      if (originalCatText.toLowerCase().includes(catName.toLowerCase()) ||
      catName.toLowerCase().includes(originalCatText.toLowerCase())) {
      categoryTextDiv.innerHTML = originalCatText;
      item.style.display = '';
      item.style.backgroundColor = '#e3f2fd';
      console.log(`SHOWING ONLY: "${originalCatText}" (has ${searchTerm})`);
      return;
      }
      });
      console.log(' Drug match filtering complete');
      return;
      }

      categoryItems.forEach((item, index) => {
      const categoryTextDiv = item.querySelector('div[style*="table-cell"]:last-child');
      if (!categoryTextDiv) return;

      const originalCatText = categoryTextDiv.textContent.trim();
      const catTextLower = originalCatText.toLowerCase();

      if (searchTerm === '' || catTextLower.includes(searchTerm)) {
      categoryTextDiv.innerHTML = originalCatText;
      item.style.display = '';
      item.style.backgroundColor = '';
      } else {
      categoryTextDiv.innerHTML = originalCatText;
      item.style.display = 'none';
      }
      });

      console.log('filterCategories complete');
      }

      // CLICK HANDLER
      document.addEventListener('click', function(e) {
      console.log('Click detected');
      const li = e.target.closest('#category-list li');
      if (!li) {
      console.log('Not a category li');
      return;
      }

      console.log('CATEGORY CLICKED!');

      const categorySelect = document.getElementById('drug_category');
      if (!categorySelect) {
      console.error('drug_category select not found');
      return;
      }

      const categoryTextDiv = li.querySelector('div[style*="table-cell"]:last-child');
      const fullText = categoryTextDiv ? categoryTextDiv.textContent : li.textContent;
      const categoryName = fullText.split(' (')[0].trim();

      console.log(`Category text: "${fullText}" → name: "${categoryName}"`);

    const matchingOption = Array.from(categorySelect.options).find(opt =>
      opt.text.trim().toLowerCase() === categoryName.toLowerCase()
      );

      if (matchingOption) {
      console.log(`MATCH FOUND: ${matchingOption.value} "${matchingOption.text}"`);

      categorySelect.value = matchingOption.value;
      categorySelect.dispatchEvent(new Event('change', { bubbles: true }));
      console.log('Category updated + change fired');

      // Populate drugs based on selected category
      set_ajaxURL_for_suggestions('/drug/search?filter_value=', matchingOption.value);
      console.log('ajaxURL set: drugs should populate NOW');

      showTemporaryAlert(`Showing drugs in ${categoryName}`);

      } else {
      console.error(`No option matches "${categoryName}"`);
      console.log('Options:', Array.from(categorySelect.options).map(opt => `"${opt.text.trim()} (${opt.value})"`));
      }
      });

      document.addEventListener('click', function(e) {
      if (e.target.matches('#backButton, .navButton, .button.blue, [class*="back"]')) {

      injectSearchBar();
      }
      }, true);

      window.injectSearchBar = injectSearchBar;
      // Function to inject search bar into touch interface
      function injectSearchBar() {
      document.querySelectorAll('#category_search, #search_container').forEach(el => el.remove());

      const touchPage = document.querySelector('#tt_page_drug_category .inputPage2');
      const inputFrame = document.querySelector('#inputFrame0');

      if (!touchPage || !inputFrame) {
      console.warn('TST page or input frame not found, cannot inject search bar');
      return;
      }
      const searchContainer = document.createElement('div');
      searchContainer.id = 'search_container';
      searchContainer.style.cssText = `
      width: 100%;
      padding: 10px;
      background: #f8f9fa;
      border-bottom: 2px solid #ddd;
      margin-bottom: 10px;
      box-sizing: border-box;
      `;

      const searchInput = document.createElement('input');
      searchInput.type = 'text';
      searchInput.id = 'category_search';
      searchInput.placeholder = 'Search categories...';
      searchInput.style.cssText = `
      width: 100%;
      padding: 15px;
      font-size: 24px;
      border: 2px solid #ddd;
      border-radius: 8px;
      box-sizing: border-box;
      outline: none;
      `;

      // TST attributes to initialize keypad behavior
      searchInput.setAttribute('field_type', 'alpha');
      searchInput.setAttribute('tt_pageStyleClass', 'Alpha');
      searchInput.setAttribute('helptext', 'Tap letters to search categories');

      searchInput.addEventListener('focus', function() {
      this.style.borderColor = '#007bff';
      this.style.boxShadow = '0 0 0 3px rgba(0, 123, 255, 0.25)';
      try {
      window.tstCurrentPage = window.tstCurrentPage || 0;
      window['touchscreenInput' + tstCurrentPage] = this;
      if (typeof listSuggestions === 'function') listSuggestions(tstCurrentPage);
      } catch (e) {
      console.log('TST attach failed:', e);
      }
      });

      searchInput.addEventListener('blur', function() {
      this.style.borderColor = '#ddd';
      this.style.boxShadow = 'none';
      });

      searchInput.addEventListener('input', filterCategories);
      searchInput.addEventListener('keyup', filterCategories);

      searchContainer.appendChild(searchInput);
      inputFrame.insertBefore(searchContainer, inputFrame.firstChild);

      attachTouchKeypad();
      }

      injectSearchBar();

      function attachTouchKeypad() {

      function getSearchInput() {
      return document.getElementById('category_search');
      }

      let keypadWrap = document.getElementById('keypad');
      if (!keypadWrap) {
      keypadWrap = document.createElement('div');
      keypadWrap.id = 'keypad';
      keypadWrap.className = 'touch-keypad hidden';
      keypadWrap.setAttribute('role', 'application');
      keypadWrap.setAttribute('aria-hidden', 'true');

      const inner = document.createElement('div');
      inner.className = 'keypad-inner';
      keypadWrap.appendChild(inner);

      const rows = ['QWERTYUIOP', 'ASDFGHJKL', 'ZXCVBNM'];
      rows.forEach(rowStr => {
      const row = document.createElement('div');
      row.className = 'key-row';
      Array.from(rowStr).forEach(ch => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'keyboardButton';
      btn.textContent = ch;
      btn.dataset.action = 'char';
      row.appendChild(btn);
      });
      inner.appendChild(row);
      });

      const specialRow = document.createElement('div');
      specialRow.className = 'key-row special-row';

      const back = document.createElement('button');
      back.type = 'button';
      back.className = 'keyboardButton special';
      back.textContent = '⌫';
      back.dataset.action = 'back';
      specialRow.appendChild(back);

      const space = document.createElement('button');
      space.type = 'button';
      space.className = 'keyboardButton special';
      space.textContent = 'Space';
      space.dataset.action = 'space';
      specialRow.appendChild(space);

      const closeBtn = document.createElement('button');
      closeBtn.type = 'button';
      closeBtn.id = 'closeKeyboardBtn';
      closeBtn.className = 'keyboardButton close';
      closeBtn.textContent = 'Close';
      closeBtn.dataset.action = 'close';
      specialRow.appendChild(closeBtn);

      inner.appendChild(specialRow);
      document.body.appendChild(keypadWrap);

      inner.addEventListener('pointerdown', (e) => {
      const btn = e.target.closest('button');
      if (!btn) return;
      const action = btn.dataset.action;
      if (action === 'close') return;

      e.preventDefault();
      e.stopPropagation();

      const input = getSearchInput();
      if (!input) return;

      if (action === 'back') removeAtCaret(input);
      else if (action === 'space') insertAtCaret(input, ' ');
      else insertAtCaret(input, btn.textContent);

      input.dispatchEvent(new Event('input', { bubbles: true }));
      input.focus();
      });

      // Close button handler
      closeBtn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      hideKeypad();
      });
      }

      function insertAtCaret(el, text) {
      const start = el.selectionStart ?? el.value.length;
      const end = el.selectionEnd ?? start;
      const val = el.value;
      el.value = val.slice(0, start) + text + val.slice(end);
      const pos = start + text.length;
      el.selectionStart = el.selectionEnd = pos;
      }

      function removeAtCaret(el) {
      const start = el.selectionStart ?? el.value.length;
      const end = el.selectionEnd ?? start;
      if (start === end && start > 0) {
      const val = el.value;
      el.value = val.slice(0, start - 1) + val.slice(end);
      el.selectionStart = el.selectionEnd = start - 1;
      } else if (start !== end) {
      const val = el.value;
      el.value = val.slice(0, start) + val.slice(end);
      el.selectionStart = el.selectionEnd = start;
      }
      }

      function showKeypad() {
      const wrap = document.getElementById('keypad');
      if (!wrap) return;
      wrap.classList.remove('hidden');
      wrap.setAttribute('aria-hidden', 'false');
      setTimeout(() => {
      const input = getSearchInput();
      if (input) {
      input.readOnly = true;
      input.focus();
      }
      }, 50);
      }

      function hideKeypad() {
      const wrap = document.getElementById('keypad');
      if (!wrap) return;
      wrap.classList.add('hidden');
      wrap.setAttribute('aria-hidden', 'true');
      const input = getSearchInput();
      if (input) {
      input.readOnly = false;
      }
      }

      const input = getSearchInput();
      if (input) {
      input.removeEventListener('click', input._keypadClick);
      input._keypadClick = (e) => {
      e.preventDefault();
      e.stopPropagation();
      showKeypad();
      };
      input.addEventListener('click', input._keypadClick, true);
      input.addEventListener('touchstart', input._keypadClick, true);
      }

      document.removeEventListener('click', document._keypadOutside);
      document._keypadOutside = (e) => {
      const wrap = document.getElementById('keypad');
      if (!wrap) return;
      const input = getSearchInput();
      const targetIsInput = input && (e.target === input || e.target.closest('#category_search'));
      const targetInsideKeypad = e.target.closest('#keypad');
      if (!targetIsInput && !targetInsideKeypad && !wrap.classList.contains('hidden')) {
      hideKeypad();
      }
      };
      document.addEventListener('click', document._keypadOutside, true);
      document.addEventListener('touchstart', document._keypadOutside, true);
      }

      //asnyc function to allow drugcategory select option list and inject search bar load at the same time to reduce delay
      async function loadCategoryAndSearchBar() {
      //error  handling for debugging
      try {
      await waitForTSTPage('#tt_page_drug_category');
      injectSearchBar();
      console.log('Category select options loaded and search bar injected');
      } catch (e) {
      console.warn('TST wait failed:', e);
      injectSearchBar();
      }
      }

      function waitForTSTPage(pageSelector, timeout = 2000) {
      return new Promise((resolve, reject) => {
      const start = Date.now();

      function checkPage() {
      if (document.querySelector(pageSelector) &&
      document.querySelector('li[source_id="drug_category"]')) {
      resolve();
      return;
      }

      if (Date.now() - start > timeout) {
      reject(new Error('TST page timeout'));
      return;
      }

      setTimeout(checkPage, 20);
      }

      checkPage();
      });
      }

      function initializeCategorySearch() {
      injectSearchBar();

      // If search bar exists, ensure it has event listeners
      const categorySearchInput = document.getElementById('category_search');
      if (categorySearchInput && !categorySearchInput.hasAttribute('data-initialized')) {
      categorySearchInput.setAttribute('data-initialized', 'true');
      categorySearchInput.addEventListener('input', filterCategories);
      categorySearchInput.addEventListener('keyup', filterCategories);
      console.log('Category search initialized');
      }
      }

      // Try to initialize at different times
      //document.addEventListener('DOMContentLoaded', initializeCategorySearch);
      //setTimeout(initializeCategorySearch, 500);
      //setTimeout(initializeCategorySearch, 1000);
      //setTimeout(initializeCategorySearch, 2000);
      //setTimeout(initializeCategorySearch, 3000);
      //setTimeout(initializeCategorySearch, 5000);
      // Replace ALL the setTimeout(initializeCategorySearch...) calls with:
      document.addEventListener('DOMContentLoaded', async () => {
      try {
      await loadCategoryAndSearchBar();
      } catch (e) {
      console.warn('Category search fallback:', e);
      injectSearchBar();
      }
      });

      (function() {
      const drugInput = document.getElementById('drug_name');
      const amountInput = document.getElementById('amount_requested');
      const labelCell = amountInput ? amountInput.closest('tr').querySelector('td:first-child') : null;
      const form = document.getElementById('inventory-form');
      if (!drugInput || !amountInput || !labelCell || !form) return;

      // Helper function to show temporary alerts
      function showTemporaryAlert(message, duration = 3000) {
      try {
      // Remove any existing alerts
      const existing = document.getElementById('temp-alert');
      if (existing) existing.remove();

      // Create new alert
      const div = document.createElement('div');
      div.id = 'temp-alert';
      div.textContent = message;
      div.style.position = 'fixed';
      div.style.top = '20px';
      div.style.right = '20px';
      div.style.backgroundColor = '#f44336';
      div.style.color = 'white';
      div.style.padding = '10px 20px';
      div.style.borderRadius = '5px';
      div.style.boxShadow = '0 2px 6px rgba(0,0,0,0.3)';
      div.style.zIndex = '9999';
      div.style.fontSize = '14px';
      div.style.opacity = '1';
      div.style.transition = 'opacity 0.4s ease';
      document.body.appendChild(div);

      // Auto-fade and remove
      setTimeout(() => {
      div.style.opacity = '0';
      setTimeout(() => { if (div && div.remove) div.remove(); }, 450);
      }, duration);
      } catch (e) {
      console.error('showTemporaryAlert error', e);
      alert(message);
      }
      }

      // core fetch function (exposed globally so clicks can call it)
      function fetchAvailableFor(drugName) {
      if (!drugName || drugName.trim() === "") {
      amountInput.dataset.available = 0;
      amountInput.value = "";
      amountInput.removeAttribute('max');
      labelCell.textContent = "Amount Requested:";
      amountInput.setAttribute('helpText', 'Amount Requested');
      return;
      }

      labelCell.textContent = "Amount Requested (checking backstore...)";
      amountInput.setAttribute('helpText', 'Checking backstore...');

      fetch('/drug/available_quantity?drug_name=' + encodeURIComponent(drugName))
      .then(res => { if (!res.ok) throw new Error('HTTP ' + res.status); return res.json(); })
      .then(data => {
      const available = parseInt(data.available || 0, 10);
      amountInput.dataset.available = available;
      amountInput.removeAttribute('max');

      const currentVal = parseInt(amountInput.value || 0, 10) || 0;
      if (currentVal > available) amountInput.value = available;

      labelCell.innerHTML = `Enter Amount Requested (<span style="color:red;">${available} bottles </span> available in backstore)`;
      amountInput.setAttribute('helpText', `Enter Amount Requested (${available} bottles available in backstore)`);
      console.debug('available for', drugName, available);
      })
      .catch(err => {
      console.error('Error fetching available_quantity:', err);
      amountInput.dataset.available = 0;
      amountInput.removeAttribute('max');
      labelCell.textContent = "Amount Requested:";
      amountInput.setAttribute('helpText', 'Amount Requested');
      });
      }

      // expose globally so click handlers can call it if needed
      window.fetchAvailableFor = fetchAvailableFor;

      // Debounced handlers (typing/blur/change fallback)
      let inputTimer = null;
      function scheduleFetch() {
      clearTimeout(inputTimer);
      inputTimer = setTimeout(() => fetchAvailableFor(drugInput.value), 250);
      }
      drugInput.addEventListener('input', scheduleFetch);
      drugInput.addEventListener('change', scheduleFetch);
      drugInput.addEventListener('blur', scheduleFetch);

      // Delegate clicks on suggestion <li>s anywhere in document:
      document.addEventListener('click', function(e) {
      const li = e.target.closest('li[value]');
      if (!li) return;

      // put the chosen name into the input (mimic selection)
      const chosen = li.getAttribute('value') || li.textContent;
      drugInput.value = chosen;

      // If the <li> contains data-qty, use it (fast path)
      const dataQty = li.dataset && li.dataset.qty ? parseInt(li.dataset.qty, 10) : null;
      if (Number.isFinite(dataQty)) {
      amountInput.dataset.available = dataQty;
      amountInput.removeAttribute('max');
      labelCell.innerHTML = `Enter Amount Requested (<span style="color:red;">${dataQty} bottle(s) </span>  available in backstore)`;
      amountInput.setAttribute('helpText', `Enter Amount Requested (<span style="color:red;">${dataQty} bottle(s) </span>  available in backstore)`);
      // clamp any value
      const cur = parseInt(amountInput.value || 0, 10) || 0;
      if (cur > dataQty) amountInput.value = dataQty;
      } else {
      // fallback: call server to get quantity
      fetchAvailableFor(chosen);
      }

      drugInput.focus();
      });

      // Clamp numeric typing into amountInput (no native max attr used)
      amountInput.addEventListener('input', function() {
      // remove any non-numeric characters as the user types
      const cleaned = this.value.replace(/[^\d]/g, '');
      if (this.value !== cleaned) this.value = cleaned;
      });

      // Show toast if user enters more than available on blur/change
      function checkAmountExceeded() {
      const max = parseInt(amountInput.dataset.available || 0, 10) || 0;
      const val = parseInt(amountInput.value || 0, 10) || 0;
      if (val > max) {
      showTemporaryAlert(`You cannot request more than ${max} (available in backstore)`);
      amountInput.value = max;
      }
      }

      amountInput.removeAttribute('max');

      // attach events
      amountInput.addEventListener('change', checkAmountExceeded);
      amountInput.addEventListener('blur', checkAmountExceeded);

      // Form submission validation
      form.addEventListener('submit', function(e) {
      const max = parseInt(amountInput.dataset.available || 0, 10) || 0;
      const val = parseInt(amountInput.value || 0, 10) || 0;

      if (val > max) {
      showTemporaryAlert(`You cannot request more than ${max} (available in backstore)`);
      amountInput.value = max;
      amountInput.focus();
      e.preventDefault();
      return false;
      }
      });

      // If input prefilled, initialize
      if (drugInput.value && drugInput.value.trim() !== "") {
      fetchAvailableFor(drugInput.value);
      }
      })();

  </script>

  <script>
  if(document.getElementById("date")) {
    document.getElementById("date").setAttribute("maxdate", (new Date((new Date()).setDate((new Date()).getDate() + 1000))));
    document.getElementById("date").setAttribute("mindate", (new Date((new Date()).setDate((new Date()).getDate() - 1))));
    }
</script>

<script>
  //global handlers to detect back navigation and re-inject search bar + re-attach keypad
  if (typeof injectSearchBar === 'function') {
  window.injectSearchBar = injectSearchBar;
  }
  if (typeof attachTouchKeypad === 'function') {
  window.attachTouchKeypad = attachTouchKeypad;
  }
  if (typeof loadCategoryAndSearchBar === 'function') {
  window.loadCategoryAndSearchBar = loadCategoryAndSearchBar;
  }

  let isReinitializing = false;

  function handleBackNavigation() {
  if (isReinitializing) {
  return;
  }

  isReinitializing = true;

  setTimeout(() => {
  if (typeof window.loadCategoryAndSearchBar === 'function') {
  window.loadCategoryAndSearchBar();
  }
  }, 250);

  setTimeout(() => {
  isReinitializing = false;
  }, 3000);
  }

  document.addEventListener('pointerdown', function unifiedBackHandler(e) {
  const btn = e.target.closest('#backButton, .navButton, .button.blue, [class*="back"], #nextButton');
  if (!btn) return;
  handleBackNavigation();
  }, true);

  window.addEventListener('pageshow', function(e) {
  if (e.persisted || document.visibilityState === 'visible') {
  handleBackNavigation();
  }
  });

  window.addEventListener('popstate', function() {
  handleBackNavigation();
  });

  document.addEventListener('visibilitychange', function() {
  if (!document.hidden) {
  setTimeout(handleBackNavigation, 100);
  }
  });

</script>
