<script>
// Interactive elements
document.addEventListener('DOMContentLoaded', function() {
  // Animate progress bars on view
  const observerOptions = {
    threshold: 0.3
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const progressBars = entry.target.querySelectorAll('.progress-bar, .expiry-progress-bar');
        progressBars.forEach(bar => {
          bar.style.transition = 'width 1.2s cubic-bezier(0.34, 1.56, 0.64, 1)';
        });
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  document.querySelectorAll('.summary-card').forEach(card => {
    observer.observe(card);
  });

  // Add hover effects to cards
  const cards = document.querySelectorAll('.summary-card, .stats-card');
  cards.forEach(card => {
    card.addEventListener('mouseenter', () => {
      card.style.transform = 'translateY(-6px)';
      card.style.boxShadow = '0 16px 48px rgba(0, 100, 149, 0.18)';
    });
    
    card.addEventListener('mouseleave', () => {
      card.style.transform = '';
      card.style.boxShadow = '';
    });
  });
});
</script>