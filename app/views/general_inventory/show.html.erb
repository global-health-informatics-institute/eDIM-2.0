<!-- DRUG -->
<div class="drug-header-modern">
  <div class="drug-header-content">
    <!-- Drug Name -->
    <div class="drug-name-section">
      <div class="drug-name-container">
        <h1 class="drug-name-main"><%= @item.drug_name.titleize %></h1>
        <div class="drug-subtitle">
          <span class="drug-id">ID: <%= Misc.dash_formatter(@item.bottle_id) %></span>
          <span class="drug-category"><%= @item.drug_category %></span>
        </div>
      </div>
    </div>

    <!-- Current Quantity Badge -->
    <div class="drug-quantity-badge">
      <div class="quantity-label">Current Quantity</div>
      <div class="quantity-value"><%= number_with_delimiter(@item.current_quantity) %></div>
      <div class="quantity-unit">units</div>
    </div>
  </div>
</div>

<!-- SUMMARY SECTION -->
<div class="summary-section-modern">
  <div class="summary-header">
    <div class="summary-title-container">
      <h3 class="summary-title">Summary</h3>
    </div>
    <div class="summary-actions">
      <span class="summary-update">Last updated: <%= Time.now.strftime("%d %b %Y, %I:%M %p") %></span>
    </div>
  </div>

  <div class="summary-grid">
    <% 
      # Calculate values dynamically based on your model structure
      amount_received  = @item.received_quantity.to_i
      amount_remaining = @item.current_quantity.to_i
      amount_damaged   = @item.bottle_damages.to_i

      amount_used = amount_received - amount_remaining - amount_damaged
      amount_used = [amount_used, 0].max

      received_percentage = amount_received > 0 ? 100 : 0
      remaining_percentage = amount_received > 0 ? (amount_remaining.to_f / amount_received.to_f * 100).round(1) : 0
      used_percentage = amount_received > 0 ? (amount_used.to_f / amount_received.to_f * 100).round(1) : 0
      
      # Calculate utilization rate
      utilization_rate = amount_received > 0 ? (amount_used.to_f / amount_received.to_f * 100).round(1) : 0
      
      # Calculate days to expiry if expiry_date exists
      days_to_expiry = @item.expiration_date ? (@item.expiration_date - Date.today).to_i : 0
      expiry_progress = days_to_expiry > 0 ? [days_to_expiry.to_f / 365 / 2 * 100, 100].min : 0
      
      # Determine stock status
      stock_status = if amount_remaining.to_f / amount_received.to_f > 0.7
                      "high-stock"
                    elsif amount_remaining.to_f / amount_received.to_f > 0.3
                      "medium-stock"
                    else
                      "low-stock"
                    end
      
      # Determine expiry status
      expiry_status = if days_to_expiry > 730
                       "safe-expiry"
                     elsif days_to_expiry > 365
                       "warning-expiry"
                     elsif days_to_expiry > 0
                       "critical-expiry"
                     else
                       "expired"
                     end
      
      # Determine stock status text
      stock_status_text = case stock_status
                         when "high-stock" then "High Stock"
                         when "medium-stock" then "Medium Stock"
                         when "low-stock" then "Low Stock"
                         end
                         
      # Determine expiry status text
      expiry_status_text = case expiry_status
                          when "safe-expiry" then "Safe (> 2 years)"
                          when "warning-expiry" then "Warning (1-2 years)"
                          when "critical-expiry" then "Critical (< 1 year)"
                          when "expired" then "Expired"
                          end
      
      # Using created_at if available, otherwise default to 30 days
      days_since_received = @item.created_at ? (Date.today - @item.created_at.to_date).to_i : 30
      daily_average = days_since_received > 0 ? (amount_used.to_f / days_since_received).round(2) : 0
    %>

    <!-- Amount Received -->
    <div class="summary-card received-card">
      <div class="summary-card-header">
        <div class="summary-card-icon">
        </div>
        <div class="summary-card-label">Amount Received</div>
      </div>
      <div class="summary-card-value">
        <span class="value-number"><%= number_with_delimiter(amount_received) %></span>
        <span class="value-unit">units</span>
      </div>
      <div class="summary-card-progress">
        <div class="progress-bar" style="width: <%= received_percentage %>%"></div>
        <div class="progress-label">Initial stock</div>
      </div>
    </div>

    <!-- Amount Remaining -->
    <div class="summary-card remaining-card">
      <div class="summary-card-header">
        <div class="summary-card-icon">
        </div>
        <div class="summary-card-label">Amount Remaining</div>
      </div>
      <div class="summary-card-value">
        <span class="value-number"><%= number_with_delimiter(amount_remaining) %></span>
        <span class="value-unit">units</span>
      </div>
      <div class="summary-card-progress">
        <div class="progress-bar" style="width: <%= remaining_percentage %>%"></div>
        <div class="progress-label"><%= remaining_percentage %>% of total</div>
      </div>
      <div class="stock-indicator <%= stock_status %>">
        <span class="indicator-dot"></span>
        <span class="indicator-text"><%= stock_status_text %></span>
      </div>
    </div>

    <!-- Amount Used -->
    <div class="summary-card used-card">
      <div class="summary-card-header">
        <div class="summary-card-icon">
        </div>
        <div class="summary-card-label">Amount Used</div>
      </div>
      <div class="summary-card-value">
        <span class="value-number"><%= number_with_delimiter(amount_used) %></span>
        <span class="value-unit">units</span>
      </div>
      <div class="summary-card-progress">
        <div class="progress-bar" style="width: <%= used_percentage %>%"></div>
        <div class="progress-label"><%= used_percentage %>% of total</div>
      </div>
    </div>

    <!-- Days to Expiry -->
    <div class="summary-card expiry-card">
      <div class="summary-card-header">
        <div class="summary-card-icon">
        </div>
        <div class="summary-card-label">Days to Expiry</div>
      </div>
      <div class="summary-card-value">
        <span class="value-number expiry-days"><%= number_with_delimiter(days_to_expiry) %></span>
        <span class="value-unit">days</span>
      </div>
      <div class="expiry-info">
        <div class="expiry-progress">
          <div class="expiry-progress-bar" style="width: <%= expiry_progress %>%"></div>
        </div>
        <% if @item.expiration_date %>
          <div class="expiry-date">
            Expires: <%= @item.expiration_date.strftime("%d %b %Y") %>
          </div>
        <% end %>
        <div class="expiry-status <%= expiry_status %>">
          <span class="status-dot"></span>
          <span class="status-text"><%= expiry_status_text %></span>
        </div>
      </div>
    </div>

    <!-- Amount Received -->
    <div class="summary-card received-card">
      <div class="summary-card-header">
        <div class="summary-card-icon">
        </div>
        <div class="summary-card-label">Total Damages Recorded</div>
      </div>
      <div class="summary-card-value">
        <span class="value-number"><%= number_with_delimiter(@item.bottle_damages) %></span>
        <span class="value-unit">units</span>
      </div>
      <div class="summary-card-progress">
        <div class="progress-bar" style="width: <%= received_percentage %>%"></div>
        <div class="progress-label">Initial stock</div>
      </div>
    </div>

    <!-- Quick Stats -->
    <div class="summary-stats-overview">
      <div class="stats-card">
        <div class="stats-icon">
        </div>
        <div class="stats-content">
          <div class="stats-label">Utilization Rate</div>
          <div class="stats-value"><%= utilization_rate %>%</div>
          <div class="stats-subtext">
            <% if utilization_rate < 10 %>
              Low usage
            <% elsif utilization_rate < 30 %>
              Moderate usage
            <% else %>
              High usage
            <% end %>
          </div>
        </div>
      </div>

      <div class="stats-card">
        <div class="stats-icon">
        </div>
        <div class="stats-content">
          <div class="stats-label">Daily Average</div>
          <div class="stats-value"><%= daily_average %>/day</div>
          <div class="stats-subtext">Based on usage</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Summary Footer -->
  <div class="summary-footer">
    <div class="summary-notes">
      <span class="notes-label">Notes:</span>
      <span class="notes-text">
        <% 
          notes = []
          if stock_status == "low-stock"
            notes << "Low stock - consider reordering"
          end
          if expiry_status == "critical-expiry"
            notes << "Expiring soon - prioritize usage"
          elsif expiry_status == "expired"
            notes << "Expired - do not use"
          end
          if utilization_rate < 5
            notes << "Low utilization rate"
          elsif utilization_rate > 50
            notes << "High utilization rate"
          end
          
          notes_text = notes.any? ? notes.join(", ") : "Stock levels healthy, no immediate action required."
        %>
        <%= notes_text %>
      </span>
    </div>
  </div>
</div>

<!-- FOOTER -->
<div class="footer" style="margin-left: 0vw; width: 100vw; font-size: 1.4rem">
  <button class="nav-bttn red" style="float:left; margin-left: 2vw;" onmousedown="window.location='/'">Home</button>
