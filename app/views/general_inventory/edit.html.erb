<script>
  var tt_cancel_destination = "/general_inventory";
  var tstCurrentDate = <%= Date.current.strftime("%d-%m-%Y") %>;

  function set_ajaxURL_for_suggestions(url, filter_value) {
    $('touchscreenInput'+tstCurrentPage).setAttribute('ajaxURL', url + filter_value + "&search_string=");
    listSuggestions(tstCurrentPage);
  }
</script>

<script>
  (function() {
    var attempts = 0;
    function patchShowMessage() {
      if (typeof showMessage === 'function') {
        var originalShowMessage = showMessage;
        showMessage = function(message) {
          if (message && message.indexOf("Value smaller than minimum") !== -1) {
            try {
              var el = tstFormElements[tstPages[tstCurrentPage]];
              if (el && el.id === 'expiry_date') {
                message = "Expiry date cannot be today or in the past";
              }
            } catch(e) {}
          }
          return originalShowMessage(message);
        };
      } else if (attempts < 50) {
        attempts++;
        setTimeout(patchShowMessage, 100);
      }
    }
    patchShowMessage();
  })();
</script>
<%= form_for :general_inventory,  :url => "/edit_general_inventory"  do |f| %>
    <table cellpadding=10>
      <tr>
        <td>
          Expiry Date:
        </td>
        <td>
           <%= text_field_tag 'expiry_date', @item.expiration_date.strftime("%Y-%m-%d"),
                              {:id => 'expiry_date',
                               :field_type => 'date',
                               :helpText => "Expiry date",
                                :maxDate => (Date.current + 20.year).to_date,
                                :minDate => (Date.current + 1).to_date,
                                :min => (Date.current + 1).to_date,
                                :absoluteMin => (Date.current + 1).to_date,
                               :tt_pageStyleClass => "Date DatesOnly"} %>

        </td>
      </tr>
      <tr>
        <td>
          Amount Received:
        </td>
        <td>
          <input type="text" id="amount_received" name="amount_received" value=<%= @item.received_quantity %>
              field_type="number" helpText="<%= t('forms.labels.amount_received') %>" tt_pageStyleClass="NumbersOnly" />
        </td>
      </tr>
      <tr>
        <input type="hidden" value="<%= @item.gn_identifier%>" id="bottle_id" name="bottle_id" />
      </tr>
    </table>


    <%= submit_tag value="Submit"%>
<% end %>


<script>

  if(document.getElementById("date")) {

    document.getElementById("date").setAttribute("maxdate", (new Date((new Date()).setDate((new Date()).getDate() + 1000))));

    document.getElementById("date").setAttribute("mindate", (new Date((new Date()).setDate((new Date()).getDate() - 1))));

  }

</script>
