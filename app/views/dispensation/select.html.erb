<script>
    var tt_cancel_destination = "/";
</script>

<%= form_for :index, url: dispensation_list_path, method: :post do |f| %>

  <select id="reportDuration" name="report_duration" helpText="<%= t('forms.labels.report_duration') %>">
    <option></option>
    <% report_options.each do |w| %>
        <option value="<%= w[1] %>"><%= w[1] %></option>
    <% end %>
  </select>

  <%= text_field_tag 'start_date', l(Date.today, format: "%Y-%m-%d"),
                     id: 'startDate',
                     field_type: 'date',
                     helpText: t('forms.labels.start_date'),
                     maxDate: Date.today.to_date,
                     minDate: (Date.today - 20.year).to_date,
                     tt_pageStyleClass: "Date DatesOnly" %>

  <%= text_field_tag 'end_date', Date.today.strftime("%Y-%m-%d"),
                     id: 'endDate',
                     field_type: 'date',
                     helpText: t('forms.labels.end_date'),
                     maxDate: Date.today.to_date,
                     minDate: (Date.today - 20.year).to_date,
                     condition: "$('reportDuration').value == '#{t('forms.options.range')}'",
                     tt_pageStyleClass: "Date DatesOnly" %>

  <% unless Location.find(session[:location]).name.downcase != 'backstore' %>
    <%= select_tag 'locations[]',
                   options_for_select(@locations, nil),
                   id: "locations",
                   helpText: t('forms.labels.issue_locations'),
                   multiple: true %>
  <% end %>

  <%= submit_tag t('forms.buttons.generate_report'), class: "nav-bttn green" %>
<% end %>

<script>
  (function() {
    function parseDate(val) {
      var parts = (val || '').split('-');
      if (parts.length !== 3) return null;
      var y = parseInt(parts[0], 10);
      var m = parseInt(parts[1], 10);
      var d = parseInt(parts[2], 10);
      if (!y || !m || !d) return null;
      return new Date(y, m - 1, d);
    }

    function formatDate(dt) {
      var y = dt.getFullYear();
      var m = String(dt.getMonth() + 1).padStart(2, '0');
      var d = String(dt.getDate()).padStart(2, '0');
      return y + '-' + m + '-' + d;
    }

    function clampToToday(dt) {
      var today = new Date();
      today.setHours(0, 0, 0, 0);
      if (dt > today) return today;
      return dt;
    }

    function computeEndDate(duration, startDate) {
      if (!startDate) return null;
      var end = new Date(startDate.getTime());
      if (duration === "<%= t('forms.options.weekly') %>") {
        end.setDate(end.getDate() + 6);
      } else if (duration === "<%= t('forms.options.monthly') %>") {
        var y = startDate.getFullYear();
        var m = startDate.getMonth();
        var d = startDate.getDate();
        var lastDayNextMonth = new Date(y, m + 2, 0).getDate();
        var day = Math.min(d, lastDayNextMonth);
        var sameDayNextMonth = new Date(y, m + 1, day);
        end = new Date(sameDayNextMonth.getFullYear(), sameDayNextMonth.getMonth(), sameDayNextMonth.getDate() - 1);
      } else if (duration === "<%= t('forms.options.daily') %>") {
        end = startDate;
      } else {
        return null; // Range or empty
      }
      return clampToToday(end);
    }

    function syncEndDate() {
      var durationEl = document.getElementById('reportDuration');
      var startEl = document.getElementById('startDate');
      var endEl = document.getElementById('endDate');
      if (!durationEl || !startEl || !endEl) return;

      var duration = durationEl.value;
      var startDate = parseDate(startEl.value);
      var endDate = computeEndDate(duration, startDate);
      if (endDate) {
        endEl.value = formatDate(endDate);
      }
    }

    document.addEventListener('change', function(e) {
      if (e.target && (e.target.id === 'reportDuration' || e.target.id === 'startDate')) {
        syncEndDate();
      }
    });

    // Initialize on load
    document.addEventListener('DOMContentLoaded', syncEndDate);
  })();
</script>
