<script>
  var tt_cancel_destination = "/";
</script>

<%= form_for :index, url: dispensation_list_path, method: :post do |f| %>
  <div style="margin-bottom: 15px;">
    <label for="reportDuration"><%= t('forms.labels.report_duration') %></label><br/>
    <select id="reportDuration" name="report_duration">
      <option></option>
      <% report_options.each do |name, value| %>
        <option value="<%= value %>" <%= 'selected' if params[:report_duration] == value %>><%= value %></option>
      <% end %>
    </select>
  </div>

  <div style="margin-bottom: 15px;">
    <%= label_tag 'start_date', t('forms.labels.start_date') %><br/>
    <%= text_field_tag 'start_date',
          params[:start_date] || Date.today.strftime("%Y-%m-%d"),
          id: 'startDate',
          field_type: 'date',
          maxDate: Date.today.to_date,
          minDate: (Date.today - 20.years).to_date,
          tt_pageStyleClass: "Date DatesOnly" %>
  </div>

  <div style="margin-bottom: 15px;">
    <%= label_tag 'end_date', t('forms.labels.end_date') %><br/>
    <%= text_field_tag 'end_date',
          params[:end_date] || Date.today.strftime("%Y-%m-%d"),
          id: 'endDate',
          field_type: 'date',
          maxDate: Date.today.to_date,
          minDate: (Date.today - 20.years).to_date,
          condition: "$('reportDuration').value == '#{t('forms.options.range')}'",
          tt_pageStyleClass: "Date DatesOnly" %>
  </div>

  <div style="margin-bottom: 15px;">
    <%= label_tag 'locations', t('forms.labels.issue_locations') %><br/>
    <%= select_tag 'locations[]',
          options_for_select(@locations || [], params[:locations]),
          id: "locations",
          multiple: true %>
  </div>

  <div style="margin-top: 20px;">
    <%= f.submit t('forms.buttons.generate_report'), class: 'btn btn-primary' %>
    <%= button_tag t('forms.buttons.cancel'), type: 'button', onclick: "window.location='/'", class: 'btn btn-secondary' %>
  </div>
<% end %>