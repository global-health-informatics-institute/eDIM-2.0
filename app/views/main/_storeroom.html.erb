<div style="display: table; padding-top: 2%; padding-left: 10px; width:75%; margin-left: auto; margin-right: auto;">
  <div style="display: table-row">
    <div onmousedown="window.location='/general_inventory/new'" style="display: table-cell; text-align: center;">
      <img src="/assets/add_drugs.png" style="width: 80px; height: auto;">
    </div>
    <div onmousedown="window.location='/general_inventory'" style="display: table-cell; text-align: center;">
      <img src="/assets/available_drugs.png" style="width: 80px; height: auto;">
    </div>
    <div onmousedown="window.location='/issues/select'" style="display: table-cell; text-align: center;">
      <img src="/assets/mobile_clinic.png" style="width: 80px; height: auto;">
    </div>

    <div style="display: table-cell; text-align: center; cursor: pointer;" 
        onmousedown="window.location='/requests'">
      <div style="position: relative; display: inline-block;">
        <img src="/assets/requested_items.png" style="width: 80px; height: auto;">
        <% if @pending_requests_count.to_i > 0 %>
          <span style="
            position: absolute;
            top: -8px;
            right: -8px;
            background-color: red;
            color: white;
            border-radius: 50%;
            min-width: 26px;
            height: 26px;
            line-height: 26px;
            text-align: center;
            font-size: 18px;      /* Increased font size for visibility */
            font-weight: bold;
            padding: 0 6px;
            pointer-events: none; /* Makes badge not block clicks */
            display: inline-block;
          ">
            <%= @pending_requests_count %>
          </span>
        <% end %>
      </div>
    </div>

    <div onmousedown="window.location='/select_report?type=storeroom'" style="display: table-cell; text-align: center;">
      <img src="/assets/report.png" style="width: 80px; height: auto;">
    </div>
    <div onmousedown="window.location='/main/settings'" style="display: table-cell; text-align: center;">
      <img src="/assets/settings.png" style="width: 80px; height: auto;">
    </div>
  </div>

  <div style="display: table-row">
    <div onmousedown="window.location='/general_inventory/new'" style="display: table-cell; text-align: center; font-size: 1.4em;">
      <%= t('menu.terms.add_item') %>
    </div>
    <div onmousedown="window.location='/general_inventory'" style="display: table-cell; text-align: center; font-size: 1.4em;">
      <%= t('menu.terms.view_inventory') %>
    </div>
    <div onmousedown="window.location='/issues/select'" style="display: table-cell; text-align: center; font-size: 1.4em;">
      <%= t('menu.terms.view_issued_items') %>
    </div>
    <div onmousedown="window.location='/requested_items'" style="display: table-cell; text-align: center; font-size: 1.4em;">
      Requested Items
    </div>
    <div onmousedown="window.location='/select_report?type=storeroom'" style="display: table-cell; text-align: center; font-size: 1.4em;">
      Stores Report
    </div>
    <div onmousedown="window.location='/main/settings'" style="display: table-cell; text-align: center; font-size: 1.4em;">
      <%= t('menu.terms.settings') %>
    </div>
  </div>
</div>