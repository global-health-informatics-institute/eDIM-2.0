<div class="modern-header-container">
  <div class="header-row">
    <div class="main-content-cell">
      <!-- Compact Scanner Section -->
      <div class="scanner-section-modern">
        <div class="scanner-compact">
          <div class="scanner-label-compact">
            <strong><%= t('menu.terms.scan_barcode')%></strong>
            <img style="height:56px; width:42px" src="/assets/barcode.jpg" alt="Barcode">
          </div>
          <input type="text" id="barcode" class="scanner-input-compact" autofocus>
        </div>
      </div>
      
      <!-- Info Section -->
      <div class="info-section-modern">
        <div class="info-table">
          <div class="info-row">
            <!-- Facility & Location -->
            <div class="info-column">
              <div class="info-pair">
                <div class="info-label-modern"><%= t('menu.terms.facility') %>:</div>
                <div class="info-value-modern"><%= facility_name %></div>
              </div>
              <div class="info-pair">
                <div class="info-label-modern">Location:</div>
                <div class="info-value-modern"><%= current_location.name.titleize %></div>
              </div>
            </div>
            
            <!-- User Name & Role -->
            <div class="info-column">
              <div class="info-pair">
                <div class="info-label-modern"><%= t('menu.terms.users_name') %>:</div>
                <div class="info-value-modern"><%= User.current.display_name %></div>
              </div>
              <div class="info-pair">
                <div class="info-label-modern">Role:</div>
                <div class="info-value-modern"><%= User.current.role %></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Compact Brand Section -->
    <div class="brand-section-compact">
      <img src="/assets/edim-logo.png" class="brand-logo-image" alt="eDIM Logo">
      <span class="current-date-compact"><%= l(Date.today, format: '%d %b %Y') %></span>
    </div>
  </div>

  <!-- Actions Section -->
  <div class="actions-container-modern">
    <div class="actions-header-modern">
      <span class="actions-title-modern"><%= t('menu.terms.actions') %></span>
    </div>
    <div class="actions-content-modern">
      <% if current_location.name.match(/store/i) %>
        <%= render "/main/storeroom" %>
      <% else %>
        <%= render "/main/dispensary" %>
      <% end %>
    </div>
  </div>
</div>

<!-- Footer -->
<div class="footer" style="padding-left:15px; font-size:1.2rem">
  <button class="nav-bttn red" style="float: left;" onmousedown="window.location='/sessions/logout'">Logout</button>
</div>

<script>
// --- Focus / scanner management ---
let barcodeInput = null;
let barcodeTimer = null;

// Whether we're in dispensary mode
const isDispensary = <%= current_location.name.match(/store/i).blank? %>;

// --- Helper to focus immediately ---
function focusBarcodeInputImmediate() {
  const barcode = document.getElementById("barcode");
  if (barcode) {
    barcode.focus();
    barcode.select();
  }
}

// initialization of the scanner
function initializeBarcodeListener() {
  barcodeInput = document.getElementById("barcode");
  if (!barcodeInput) return;

  // Remove possible old listeners
  barcodeInput.removeEventListener('input', handleBarcodeInput);
  barcodeInput.removeEventListener('blur', handleBarcodeBlur);

  // Prepare field
  barcodeInput.value = "";
  barcodeInput.focus();

  // Add listeners
  barcodeInput.addEventListener('input', handleBarcodeInput);
  barcodeInput.addEventListener('blur', handleBarcodeBlur);
}

// --- Input handler with debounce (lets scanner finish typing) ---
function handleBarcodeInput(event) {
  if (barcodeTimer) clearTimeout(barcodeTimer);

  barcodeTimer = setTimeout(() => {
    const raw = event.target.value.trim().toUpperCase().replace(/-/g, "");
    if (raw.length >= 8) {
      processBarcode(raw);
    }
  }, 120);
}

// --- Refocus on blur ---
function handleBarcodeBlur() {
  setTimeout(() => focusBarcodeInputImmediate(), 100);
}

// --- Main processing: redirect to patient or inventory ---
function processBarcode(code) {
  // Show scanned code briefly
  if (barcodeInput) barcodeInput.value = code;

  // Clear & refocus quickly
  setTimeout(() => {
    if (barcodeInput) {
      barcodeInput.value = "";
      barcodeInput.focus();
    }
  }, 50);

  // Redirect
  if (isDispensary) {
    window.location = "/patient_identifiers/" + encodeURIComponent(code);
  } else {
    window.location = "/general_inventory/" + encodeURIComponent(code);
  }
}

// Start scanner when page loads
document.addEventListener("DOMContentLoaded", initializeBarcodeListener);
</script>

