<div style="display: table; padding-top: 4%;padding-left: 10px;width:75%; margin-left: auto;margin-right: auto;">
  <div style="display: table-row">
    <div onmousedown="window.location='/dispensary/new?add_mode=true'" style="display: table-cell;text-align: center;">
      <img src="/assets/add_drug.png" style="width: 68px; height: 68px;">
    </div>

    <div onmousedown="window.location='/general_inventory/prepack_labels'" style="display: table-cell;text-align: center;">
      <img src="/assets/prepack.png" style="width: 68px; height: 68px;">
